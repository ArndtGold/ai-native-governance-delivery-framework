      }
    ]
  },
  {
    "id": "mcp-package",
    "commands": [
      {
        "tool": "npm",
        "args": [
          "--prefix",
          "packages/mcp-server",
          "run",
          "test:package"
        ]
      }
    ]
  },
  {
    "id": "archives",
    "commands": [
      {
        "tool": "node",
        "args": [
          "scripts/pack-npm.mjs"
        ]
      },
      {
        "tool": "node",
        "args": [
          "scripts/test-package-consumers.mjs"
        ]
      }
    ]
  },
  {
    "id": "cli-smoke",
    "commands": [
