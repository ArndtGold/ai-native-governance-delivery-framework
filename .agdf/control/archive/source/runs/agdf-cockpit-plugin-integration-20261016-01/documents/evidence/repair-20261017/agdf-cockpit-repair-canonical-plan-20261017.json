[
  {
    "id": "dependencies",
    "commands": [
      {
        "tool": "npm",
        "args": [
          "ci",
          "--ignore-scripts"
        ]
      }
    ]
  },
  {
    "id": "maintenance",
    "commands": [
      {
        "tool": "npm",
        "args": [
          "run",
          "test:maintenance-contracts"
        ]
      }
    ]
  },
  {
    "id": "shell",
    "commands": [
      {
        "tool": "node",
        "args": [
          "scripts/check-shell-syntax.mjs"
        ]
      }
    ]
  },
  {
    "id": "ui-dependencies",
    "build": true,
    "prepare": true,
    "commands": [
      {
        "tool": "npm",
        "args": [
          "ci",
          "--ignore-scripts"
        ],
        "cwd": "packages/control-ui"
      }
    ]
  },
  {
    "id": "ui-build",
    "build": true,
    "prepare": true,
    "commands": [
      {
        "tool": "npm",
        "args": [
          "run",
          "build:mcp"
        ],
        "cwd": "packages/control-ui"
      }
    ]
  },
  {
    "id": "generate",
    "build": true,
    "prepare": true,
    "commands": [
      {
        "tool": "node",
        "args": [
          "scripts/sync-package-assets.js"
        ]
      }
    ]
  },
  {
    "id": "build-contracts",
    "build": true,
    "commands": [
      {
        "tool": "node",
        "args": [
          "packages/cli/scripts/build-contract-test.js"
        ]
      }
    ]
  },
  {
    "id": "evals",
    "build": true,
    "commands": [
      {
        "tool": "npm",
        "args": [
          "--prefix",
          "packages/cli",
          "run",
          "eval:skills"
        ]
      }
    ]
  },
  {
    "id": "compatibility-freshness",
    "build": true,
    "repository": true,
    "failureHint": "Inspect the diagnostic. For source_snapshot_changed, run npm run build:prepare, then npm run compatibility:record with MCP dependencies installed; review the evidence and rerun npm run build. Other evidence errors require repair, not automatic recording.",
    "commands": [
      {
        "tool": "npm",
        "args": [
          "run",
          "compatibility:check"
        ]
      }
    ]
  },
  {
    "id": "assemble",
    "build": true,
    "prepare": true,
    "commands": [
      {
        "tool": "node",
        "args": [
          "scripts/assemble-npm.mjs"
        ]
      }
    ]
  },
  {
    "id": "prepare",
    "prepare": true,
    "commands": [
      {
        "tool": "npm",
        "args": [
          "--prefix",
          "packages/cli",
          "run",
          "release:prepare"
        ]
      }
    ]
  },
  {
    "id": "mcp-dependencies",
    "commands": [
      {
        "tool": "npm",
        "args": [
          "ci",
          "--ignore-scripts"
        ],
        "cwd": "packages/mcp-server"
      }
    ]
  },
  {
    "id": "runtime",
    "commands": [
      {
        "tool": "node",
        "args": [
          "plugins/agdf/scripts/check-runtime-integrity.mjs"
        ]
      }
    ]
  },
  {
    "id": "community",
    "repository": true,
    "commands": [
      {
        "tool": "npm",
        "args": [
          "run",
          "test:community-health"
        ]
      },
      {
        "tool": "npm",
        "args": [
          "run",
          "check:community-health"
        ]
      }
    ]
  },
  {
    "id": "host-compatibility",
    "repository": true,
    "commands": [
      {
        "tool": "npm",
        "args": [
          "run",
          "test:host-compatibility"
        ]
      }
    ]
  },
  {
    "id": "built-runtime",
    "commands": [
      {
        "tool": "node",
        "args": [
          "packages/cli/generated/plugins/agdf/scripts/check-runtime-integrity.mjs"
        ],
        "env": {
          "AGDF_RUNTIME_INTEGRITY_ROOT": "packages/cli/generated/plugins/agdf"
        }
      }
    ]
  },
  {
    "id": "cli-package",
    "commands": [
      {
        "tool": "npm",
        "args": [
          "--prefix",
