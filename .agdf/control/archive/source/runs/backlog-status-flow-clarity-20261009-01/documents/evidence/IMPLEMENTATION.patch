+    .replace(other, '| P2 | foreign | Protected foreign title | In Progress | | | | | | | | | Protected foreign action |');
+  writeFileSync(path, legacy); assert.equal(projectCockpitBacklog(f.root).data.entries[0].stored_next_step, 'Old raw notes');
