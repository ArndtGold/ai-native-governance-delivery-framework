      "changed_statements": [
        {
          "type": "SD",
          "path": ".agdf/control/artefacts/mcp-codex-guided-inspection-20261025-01/SD.md",
          "digest": "sha256:d85eae3c81e85ea570dfb5e872e5dfd3cf3189f6a1dcf44de203d64b8f5a61a5",
          "statement": "The native guard, task predicate, trace parser and wrapper audit remain unchanged.",
          "intended_change": "Keep every existing protected target, native task, predicate, trace parser and wrapper audit unchanged. Adapt only the existing native-harness execution guard composition: apply one combined macOS sandbox to the complete candidate cohort, and inherit it in the harness, MCP and Codex children without nested sandbox application. Fail closed on missing protection; require zero-model negative/positive controls and before/after provenance before either real session.",
          "reason": "Native preflight and exact-stack diagnostic establish that the newly added outer sandbox prevents the unchanged inner sandbox from applying. One combined policy passes the zero-model controls with the same protection targets and ChatGPT status."
        },
        {
          "type": "TP",
          "path": ".agdf/control/artefacts/mcp-codex-guided-inspection-20261025-01/TP.md",
          "digest": "sha256:d320f37fbe04568c675d071e4895e62a6b959706aa847fd1c85e0ed3a46e4de6",
          "statement": "An outer sandbox-exec policy additionally denies file-write* under the original ROOT during the entire candidate cohort.",
          "intended_change": "Use exactly one combined sandbox-exec policy for the whole cohort, retaining original-ROOT subtree denial and all three existing immutable-settings literals. The existing harness execution owner verifies/inherits this policy and must not apply another sandbox inside it. Only guard execution composition and its verified fingerprints may change; the task, prompt, native-run/native-tasks audit files, two-session budget, model/effort, all ceilings and account restrictions remain fixed.",
          "reason": "Native preflight and exact-stack diagnostic establish that the newly added outer sandbox prevents the unchanged inner sandbox from applying. One combined policy passes the zero-model controls with the same protection targets and ChatGPT status."
        },
        {
          "type": "TP",
          "path": ".agdf/control/artefacts/mcp-codex-guided-inspection-20261025-01/TP.md",
          "digest": "sha256:d320f37fbe04568c675d071e4895e62a6b959706aa847fd1c85e0ed3a46e4de6",
          "statement": "Keep scripts/native-probes/codex-host-e2e.mjs, native-run.js and native-tasks.js at the inspected source fingerprints above.",
          "intended_change": "Retain the inspected harness fingerprint as the pre-change baseline. Permit only its reviewed one-layer guard composition and guarded-child prerequisite checks; bind the actual final harness/guard source and assembly hashes after implementation before any model session. Keep native-run.js and native-tasks.js at their inspected fingerprints, with no prompt, parser, predicate, retry/resume or repetition override change.",
          "reason": "Native preflight and exact-stack diagnostic establish that the newly added outer sandbox prevents the unchanged inner sandbox from applying. One combined policy passes the zero-model controls with the same protection targets and ChatGPT status."
        }
      ],
