      "changed_statements": [
        {
          "type": "SD",
          "path": ".agdf/control/artefacts/agdf-begleiter-companion-20261025-01/SD.md",
          "digest": "sha256:4be71b44af1662e2cab89f3beabd07839e2e58d9e362b72764514f6540ea8402",
          "statement": "- SDD-07: Persist only three user choices in `$.store`: `enabled`, `still` and one `selection` entry per project root; `/agdf-companion` toggles `enabled`, opens or closes the pane and starts or stops refreshing; closing the pane by its own mark hides it for the session only; rationale: AC-001 and AC-004 with host-owned, plugin-scoped storage; consequence: removal on uninstall depends on the host and is verified by an early TP probe.",
          "intended_change": "Persist enabled, still and per-project selection in <config dir>/plugins/data/agdf-agdf/companion-state.json via $.fs, only when the AGDF plugin data directory exists; no $.store.",
          "reason": "T-001: $.store survives uninstall; the plugin data directory is removed with the plugin."
        },
        {
          "type": "SD",
          "path": ".agdf/control/artefacts/agdf-begleiter-companion-20261025-01/SD.md",
          "digest": "sha256:4be71b44af1662e2cab89f3beabd07839e2e58d9e362b72764514f6540ea8402",
          "statement": "| AC-001 | `/agdf-companion` toggles `enabled` in `$.store`, opens or closes the pane; off by default | Claude host command and store APIs; companion adapter | SDD-07 | Store removal on uninstall is host behaviour; verified by the early TP probe |",
          "intended_change": "Name the companion state file in the plugin data directory instead of $.store.",
          "reason": "Follows the corrected SDD-07."
        },
        {
          "type": "TP",
          "path": ".agdf/control/artefacts/agdf-begleiter-companion-20261025-01/TP.md",
          "digest": "sha256:c2ede5f46770774898373db1857633baa1a4dd0300240cae6274c77d91bdad5f",
          "statement": "| T-004 | Host adapter `register.mjs` and `hooks.json` (`modules`): `/agdf-companion` command, `$.store` keys, `session.start`, main-loop `turn.start` / `turn.complete`, refresh timer, pane rendering per surface, catch paths, no gating hooks | Claude Code implementing agent | T-001, T-003 |",
          "intended_change": "Replace $.store keys with the companion state file in the plugin data directory, including the session-only fallback.",
          "reason": "Follows the corrected SDD-07."
        },
        {
          "type": "TP",
          "path": ".agdf/control/artefacts/agdf-begleiter-companion-20261025-01/TP.md",
          "digest": "sha256:c2ede5f46770774898373db1857633baa1a4dd0300240cae6274c77d91bdad5f",
          "statement": "| AC-009 | SDD-01 | T-001 | SCN-017 | After uninstalling the plugin no companion files, store data or settings remain | Probe file listing before and after uninstall |",
          "intended_change": "Verify that no store file and no companion state remain after uninstall under the corrected persistence, mapped to SDD-07.",
          "reason": "T-001 found store residue; the scenario now verifies the corrected design."
        }
      ],
