{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "scope_fit", "gate_readiness", "risk_reduction", "evidence_gain", "testability", "reversibility", "cost", "uncertainty", "rationale"],
  "properties": {
    "candidate_id": { "type": "string", "const": "probe-1" },
    "scope_fit": { "type": "integer", "minimum": 0, "maximum": 5 },
    "gate_readiness": { "type": "integer", "minimum": 0, "maximum": 5 },
    "risk_reduction": { "type": "integer", "minimum": 0, "maximum": 5 },
    "evidence_gain": { "type": "integer", "minimum": 0, "maximum": 5 },
    "testability": { "type": "integer", "minimum": 0, "maximum": 5 },
    "reversibility": { "type": "integer", "minimum": 0, "maximum": 5 },
    "cost": { "type": "integer", "minimum": 0, "maximum": 5 },
    "uncertainty": { "type": "integer", "minimum": 0, "maximum": 5 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 240 }
  }
}
