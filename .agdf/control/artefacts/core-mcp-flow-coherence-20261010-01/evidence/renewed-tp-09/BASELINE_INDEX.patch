+++ b/packages/core/lib/control-state/run-command-service.js
@@ -0,0 +1,154 @@
+import { join } from 'node:path';
+import { readFileSync } from 'node:fs';
+import { resolveTaskTarget } from '../task-target-resolution.js';
+import { withLiveControlReads } from '../control-read/fs.js';
+import { evaluateGateCheck } from '../control-evaluation/gate-check.js';
+import { policyForRunContent } from '../control-evaluation/run-step-policy.js';
+import { RUN_COMMAND_GROUPS, RUN_COMMAND_LIMITS, runCommandRequestDigest, validateRunCommand } from './run-command-contract.js';
+import { COOPERATIVE_ASSURANCE, canonicalJson, digest, resolveControlCommandTarget } from './approval-command-contract.js';
+import { readRun } from './run-state-edits.js';
+import { runSealState } from './run-seal.js';
+import { runPath } from './run-state-reader.js';
+import { withOwnedFileLock } from './run-state-writer.js';
+import { assertRunOperationIdentity } from './run-operation-identity.js';
+import { prepareRunPresentation } from './run-presentation.js';
+import { executeApprovalCommand } from './approval-command.js';
+import { recordRunStep } from './run-steps.js';
+import { inspectRunOperation } from './run-operation-status.js';
+import { readOperationSource } from './run-operation-proof.js';
+import { pendingRunStepIds, pendingRunStepPath } from './run-step-pending.js';
+import { readPendingRunStepJournal, recoverPendingRunStepLocked } from './run-step-transaction.js';
+import { previewSourceRevision, applySourceRevision, recoverSourceRevision, reopenPrdRevision } from './run-revision.js';
+import { containedRegularFile, hasSymlinkComponent } from './contained-file.js';
+import { parseRunState } from './run-state-parser.js';
+import { existsSync } from 'node:fs';
+
+function safeOperationStatus(root, input) {
+  try { return inspectRunOperation(root, { runId: input.run_id, operationId: input.operation_id, targetId: input.target_id }); }
+  catch { return { status: 'unknown', reason: 'operation_observation_unavailable' }; }
+}
+
+function assertCommandRunPath(root, input) {
+  const relative = `.agdf/control/runs/${input.run_id}/RUN_STATE.md`;
+  if (hasSymlinkComponent(root, relative) || containedRegularFile(root, relative).status !== 'valid') throw Error('run_path_invalid');
+}
+
+export function observeCurrentRunCommand(root, input) {
+  try {
+    const run = readRun(root, input.run_id);
+    if (run.rejection) return { available: false, reason: run.rejection.reason };
+    if (runSealState(root, run.content).status !== 'valid') return { available: false, reason: 'seal_invalid' };
+    const report = evaluateGateCheck(root, { runId: input.run_id, presentationLanguage: input.presentation_language });
+    return { available: true, revision: Number(run.meta.revision), revision_id: run.meta.revision_id, lifecycle: run.meta.lifecycle,
+      gate: report.current_gate, status: report.status, missing_approval: report.missing_approval,
+      blocking_reason: report.blocking_reason ?? null, next_operation: report.next_operation, completion: report.completion };
+  } catch { return { available: false, reason: 'current_observation_unavailable' }; }
+}
+
+function boundedRecover(root, input) {
+  const payload = input.command.payload, path = runPath(root, input.run_id);
+  assertCommandRunPath(root, input);
+  return withOwnedFileLock(path, () => withOwnedFileLock(join(root, '.agdf/control/MASTER_BACKLOG.md'), () => {
+    const other = pendingRunStepIds(root).find(id => id !== input.run_id);
+    if (other) return { outcome: 'recovery_required', reason: 'another_pending_operation', pending_run_id: other };
+    if (!existsSync(pendingRunStepPath(root, input.run_id))) {
+      const observed = safeOperationStatus(root, input);
+      return observed.status === 'recorded' && observed.family === payload.original_kind
+        ? { outcome: 'recovered', status: 'already_completed', historical_effect: true, receipt: observed.receipt }
+        : { outcome: 'recovery_required', reason: 'original_operation_unconfirmed' };
+    }
+    const pending = readPendingRunStepJournal(root, input.run_id);
+    if (pending.schema_version !== 3 || pending.kind !== payload.original_kind || pending.operation_id !== input.operation_id
+      || pending.target_id !== input.target_id || digest(canonicalJson(pending)) !== payload.pending_digest
+      || ![pending.old_revision_id, pending.next_revision_id].includes(input.expected_revision_id)
+      || payload.recovery_revision_id !== input.expected_revision_id) return { outcome: 'rejected', reason: 'recovery_binding_invalid' };
+    const statePath = `.agdf/control/runs/${input.run_id}/RUN_STATE.md`;
+    if (hasSymlinkComponent(root, statePath) || containedRegularFile(root, statePath).status !== 'valid') return { outcome: 'rejected', reason: 'run_path_invalid' };
+    const raw = readFileSync(path, 'utf8');
+    const parsed = parseRunState(raw, input.run_id);
+    if (!parsed.valid || parsed.meta.revision_id !== input.expected_revision_id) return { outcome: 'rejected', reason: 'stale_revision' };
+    return { outcome: 'recovered', ...recoverPendingRunStepLocked(root, input.run_id) };
+  }));
+}
+
+// The public selector is a fixed permission group, never an arbitrary function name.
+// Adapters receive this same service; private dependencies are package-owned test seams.
+export function createRunCommandService({ packageVersion = '0.14.5', enabledGroups = Object.keys(RUN_COMMAND_GROUPS), checkpoint = () => {} } = {}) {
+  if (!Array.isArray(enabledGroups) || new Set(enabledGroups).size !== enabledGroups.length) throw Error('command_group_unsupported');
+  const enabled = new Set(enabledGroups);
+  if ([...enabled].some(group => !Object.hasOwn(RUN_COMMAND_GROUPS, group))) throw Error('command_group_unsupported');
+  return function executeRunCommand(group, input) {
+    return withLiveControlReads(() => {
+      const diagnostics = validateRunCommand(group, input);
+      if (diagnostics.length) return { schema_version: '1', outcome: 'rejected', reason: 'command_schema_invalid', diagnostics, authorizes: false };
+      const requestDigest = runCommandRequestDigest(input);
+      let root, dispatched = false;
+      const result = (outcome, reason, family = {}, extra = {}) => {
+        const status = root ? safeOperationStatus(root, input) : null;
+        const receipt = family.receipt ?? status?.receipt ?? null;
+        const response = { schema_version: '1', outcome, reason: reason ?? null, operation_id: input.operation_id,
+          request_digest: requestDigest, binding: { target_id: input.target_id, run_id: input.run_id, expected_revision_id: input.expected_revision_id, kind: input.command.kind },
+          effect: receipt?.effect ?? null, receipt, historical_effect: Boolean(family.historical_effect || outcome === 'already_applied'),
+          current: root ? observeCurrentRunCommand(root, input) : { available: false, reason: 'target_unavailable' },
+          assurance: COOPERATIVE_ASSURANCE, authorizes: false,
+          recovery: ['effect_unknown', 'recovery_required'].includes(outcome) ? 'Inspect operation-status with the original UUID and preserve the exact original payload. Do not infer absence or create another decision.' : null,
+          family_result: family, ...extra };
+        if (Buffer.byteLength(JSON.stringify(response)) > RUN_COMMAND_LIMITS.result_bytes) return { schema_version: '1', outcome: dispatched ? 'effect_unknown' : 'rejected',
+          reason: 'command_result_budget_exceeded', operation_id: input.operation_id, binding: response.binding, authorizes: false,
+          recovery: 'Inspect operation-status with the original UUID. A lost response does not prove non-execution.' };
+        return response;
+      };
+      if (!enabled.has(group)) return result('rejected', 'command_group_disabled', {}, { dispatch: 'not_dispatched' });
+      try {
+        const target = resolveTaskTarget({ workingDirectory: input.working_directory, targetSource: input.target_source, primaryTarget: input.primary_target });
+        if (target.resolution_state !== 'resolved') return result('rejected', target.reason_code, {}, { dispatch: 'not_dispatched' });
+        root = target.governance_target;
+        if (resolveControlCommandTarget(root).target_id !== input.target_id) return result('rejected', 'target_binding_mismatch', {}, { dispatch: 'not_dispatched' });
+        const payload = input.command.payload, kind = input.command.kind;
+        const context = { kind, operation_id: input.operation_id, target_id: input.target_id, request_digest: requestDigest };
+        const bound = { runId: input.run_id, revisionId: input.expected_revision_id, operationId: input.operation_id };
+        assertCommandRunPath(root, input);
+        let family;
+        checkpoint('before_dispatch'); dispatched = true;
+        if (kind === 'presentation.prepare') {
+          family = withOwnedFileLock(runPath(root, input.run_id), () => {
+            const run = readRun(root, input.run_id); if (run.rejection) return run.rejection;
+            assertRunOperationIdentity(root, run, input.operation_id, kind);
+            return prepareRunPresentation(root, { ...bound, gate: payload.gate, language: input.presentation_language, requestDigest }, { evaluateGateCheck });
+          });
+        } else if (kind === 'approval.record') {
+          family = executeApprovalCommand(root, { schema_version: '1', action: 'record_gate_approval', target_id: input.target_id,
+            run_id: input.run_id, expected_revision_id: input.expected_revision_id, operation_id: input.operation_id,
+            assurance: input.assurance, gate: payload.gate, presentation_id: payload.presentation_id, response: payload.response }, { evaluateGateCheck, packageVersion, checkpoint, commandContext: context });
+        } else if (kind === 'step.record' || kind === 'artefact.record') {
+          const record = kind === 'artefact.record' ? { step: 'artefact', gate: payload.gate, evidence: payload.reviewed_request.path, sourceBinding: payload.reviewed_request }
+            : { step: payload.step, sourceBinding: payload.source, evidence: payload.source.path, title: payload.title,
+              route: payload.route, reason: payload.reason, decision: payload.decision, covers: payload.covers, internalStep: payload.internal_step };
+          family = recordRunStep(root, { ...bound, ...record }, { policy: policyForRunContent, packageVersion, operationContext: context, afterWrite: checkpoint });
+        } else if (kind === 'operation.recover') family = boundedRecover(root, input);
+        else if (kind === 'source_revision.preview' || kind === 'source_revision.apply') {
+          const revised = { ...bound, sourceGate: payload.source_gate, evidence: payload.proposal.path, previewDigest: payload.preview_digest,
+            proposalBinding: payload.proposal, confirmation: payload.confirmation, commandContext: context, packageVersion };
+          family = kind.endsWith('.apply') ? applySourceRevision(root, revised, { afterWrite: checkpoint }) : previewSourceRevision(root, revised);
+        } else if (kind === 'source_revision.recover') {
+          family = recoverSourceRevision(root, { ...bound, proposalBinding: payload.proposal, evidence: payload.proposal.path, sourceGate: payload.source_gate,
+            recoveryRevisionId: payload.recovery_revision_id, pendingDigest: payload.pending_digest });
+        } else if (kind === 'prd_revision.reopen') {
+          family = reopenPrdRevision(root, { ...bound, prdBinding: payload.prd, confirmation: payload.confirmation, commandContext: context, packageVersion }, { afterWrite: checkpoint });
+        } else if (kind === 'closeout.record') {
+          family = recordRunStep(root, { ...bound, step: 'closeout', sourceBinding: payload.or, confirmation: payload.confirmation },
+            { policy: policyForRunContent, packageVersion, operationContext: context, afterWrite: checkpoint });
+        }
+        checkpoint('before_result');
+        const accepted = ['prepared', 'recorded', 'accepted', 'preview', 'recovered', 'reopened'].includes(family?.outcome);
+        const repeated = ['already_applied', 'already_prepared', 'replayed'].includes(family?.outcome);
+        const status = safeOperationStatus(root, input);
+        if (family?.outcome === 'rejected' && ['pending', 'unknown', 'committed_recovery_required'].includes(status.status)) return result('effect_unknown', family.reason, family);
+        return result(repeated ? 'already_applied' : accepted ? 'accepted' : family?.outcome === 'recovery_required' ? 'recovery_required' : 'rejected', family?.reason, family ?? {});
+      } catch (error) {
+        if (error.message === 'AGDF_OPERATION_PAYLOAD_CONFLICT') return result('rejected', 'operation_payload_conflict');
+        return result(dispatched ? 'effect_unknown' : 'rejected', error.message, {}, { dispatch: dispatched ? 'dispatched' : 'not_dispatched' });
+      }
+    });
+  };
+}
diff --git a/packages/core/lib/control-state/run-operation-identity.js b/packages/core/lib/control-state/run-operation-identity.js
new file mode 100644
index 00000000..02d0b9e6
--- /dev/null
+++ b/packages/core/lib/control-state/run-operation-identity.js
@@ -0,0 +1,31 @@
+import { existsSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { readRunOperations } from './run-operations.js';
+import { readApprovalOperations } from './approval-operations.js';
+import { readArtefactBindings } from './artefact-bindings.js';
+import { readSourceRevisions } from './run-source-revisions.js';
+import { containedRegularFile, hasSymlinkComponent } from './contained-file.js';
+import { REVISION_ID_PATTERN } from './run-identity.js';
+import { validateRunPresentationEnvelope } from './run-presentation.js';
+
+// Called under the existing selected Run lock. This is identity reservation only;
+// the original family alone validates payload, eligibility, receipt and replay.
+export function assertRunOperationIdentity(root, run, operationId, family) {
+  if (!REVISION_ID_PATTERN.test(operationId ?? '')) throw Error('AGDF_OPERATION_BINDING_INVALID');
+  const receipts = [
+    ...readRunOperations(run.content).receipts.map(r => [r.operation_id, r.kind]),
+    ...readApprovalOperations(run.content).receipts.map(r => [r.operation_id, 'approval.record']),
+    ...readArtefactBindings(run.content).receipts.map(r => [r.operation.id, 'artefact.record']),
+    ...readSourceRevisions(run.content).receipts.map(r => [r.operation_id, 'source_revision.apply']),
+  ].filter(([id]) => id === operationId);
+  if (receipts.length > 1 || receipts.some(([, kind]) => kind !== family)) throw Error('AGDF_OPERATION_PAYLOAD_CONFLICT');
+  const path = `.agdf/control/runs/${run.meta.run_id}/presentations/${operationId}.json`;
+  if (!existsSync(join(root, path))) return;
+  if (hasSymlinkComponent(root, path) || containedRegularFile(root, path).status !== 'valid') throw Error('AGDF_OPERATION_IDENTITY_UNCONFIRMED');
+  const bytes = readFileSync(join(root, path)); if (bytes.length > 262144) throw Error('AGDF_OPERATION_IDENTITY_UNCONFIRMED');
+  let envelope; try { envelope = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes)); } catch { throw Error('AGDF_OPERATION_IDENTITY_UNCONFIRMED'); }
+  const r = envelope.record;
+  const check = validateRunPresentationEnvelope(envelope, { runId: run.meta.run_id, gate: r?.gate, revisionId: r?.revision_id, presentationId: operationId });
+  if (check.reason) throw Error('AGDF_OPERATION_IDENTITY_UNCONFIRMED');
+  if (r.operation_id === operationId && (family !== 'presentation.prepare' || receipts.length)) throw Error('AGDF_OPERATION_PAYLOAD_CONFLICT');
+}
diff --git a/packages/core/lib/control-state/run-operation-proof.js b/packages/core/lib/control-state/run-operation-proof.js
new file mode 100644
index 00000000..22ad6482
--- /dev/null
+++ b/packages/core/lib/control-state/run-operation-proof.js
@@ -0,0 +1,48 @@
+import { readFileSync, statSync } from 'node:fs';
+import { canonicalJson, digest, DIGEST_PATTERN, exactObject, COOPERATIVE_ASSURANCE, resolveControlCommandTarget } from './approval-command-contract.js';
+import { containedRegularFile, hasSymlinkComponent } from './contained-file.js';
+import { artefactFileDigest, canonicalRunText } from './run-seal.js';
+import { INTERNAL_STEP_FILES } from './run-owned-outputs.js';
+import { EVIDENCE_PREREQUISITES, evidenceSourceSetDigest } from './evidence-bindings.js';
+import { evaluateQaFollowUp } from '../control-evaluation/qa-follow-up.js';
+
+export function readOperationSource(root, runId, source) {
+  if (!exactObject(source, ['path', 'digest']) || !DIGEST_PATTERN.test(source.digest ?? '')
+    || typeof source.path !== 'string' || !source.path.startsWith(`.agdf/control/artefacts/${runId}/`)
+    || source.path.endsWith('/RUN_STATE.md') || hasSymlinkComponent(root, source.path)) throw Error('AGDF_RUN_OPERATION_SOURCE_INVALID');
+  const file = containedRegularFile(root, source.path);
+  if (file.status !== 'valid' || statSync(file.path).size > 131072) throw Error('AGDF_RUN_OPERATION_SOURCE_INVALID');
+  const bytes = readFileSync(file.path);
+  if (bytes.length > 131072) throw Error('AGDF_RUN_OPERATION_SOURCE_INVALID');
+  const content = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
+  if (artefactFileDigest(root, source.path) !== source.digest || !canonicalRunText(content).trim()) throw Error('AGDF_RUN_OPERATION_SOURCE_INVALID');
+  return { content, validate: () => { if (hasSymlinkComponent(root, source.path) || containedRegularFile(root, source.path).status !== 'valid' || artefactFileDigest(root, source.path) !== source.digest) throw Error('AGDF_RUN_OPERATION_SOURCE_CHANGED'); } };
+}
+export function operationSources(root, state, step) {
+  const types = EVIDENCE_PREREQUISITES[step]; if (!types) throw Error('AGDF_RUN_OPERATION_STEP_INVALID');
+  return types.map(type => {
+    const row = state.artefacts.get(type);
+    const value = row?.path ? artefactFileDigest(root, row.path) : null;
+    return { type, path: row?.path ?? '', digest: DIGEST_PATTERN.test(value ?? '') ? value : null, status: row?.status ?? 'missing' };
+  });
+}
+export const operationSourceSetDigest = (root, state, step) => evidenceSourceSetDigest(operationSources(root, state, step));
+export function operationReceipt(root, run, context, nextRevisionId, record, packageVersion) {
+  return { schema_version: '1', kind: context.kind, operation_id: context.operation_id, request_digest: context.request_digest,
+    target_id: resolveControlCommandTarget(root).target_id, run_id: run.meta.run_id, expected_revision_id: run.meta.revision_id,
+    created_at: new Date().toISOString(), producer: { contract: 'run-command/1', package_version: packageVersion }, assurance: COOPERATIVE_ASSURANCE,
+    effect: { previous_revision_id: run.meta.revision_id, resulting_revision_id: nextRevisionId, revision: Number(run.meta.revision) + 1, record } };
+}
+export function internalStepEligibility(state, before, input, root) {
+  if (state.meta?.lifecycle !== 'active' || !['structured_slice', 'structured_delivery'].includes(state.mode_slice_decision.decision)
+    || ['QA', 'UAT'].some(gate => state.approvals.get(gate)?.status === 'approved')) return false;
+  const type = input.internalStep;
+  if (!Object.hasOwn(INTERNAL_STEP_FILES, type) || type === 'Brownfield Review') return false;
+  if (type === 'UX Intent Definition') return state.approvals.get('UR')?.status === 'approved'
+    && (before.next_operation?.analysis === type || before.current_gate === 'PRD' && state.approvals.get('PRD')?.status !== 'approved');
+  if (state.approvals.get('TP')?.status !== 'approved') return false;
+  if (type === 'Brownfield Analysis') return before.current_gate === 'Brownfield Analysis';
+  if (type === 'CD+Tests') return before.current_gate === 'CD+Tests'
+    || before.current_gate === 'QA' && evaluateQaFollowUp(root, state, state.run_id, 64, true).kind === 'implementation';
+  return state.artefacts.get('CD+Tests')?.status === 'done' && ['CR', 'QA'].includes(before.current_gate);
+}
diff --git a/packages/core/lib/control-state/run-operation-status.js b/packages/core/lib/control-state/run-operation-status.js
new file mode 100644
index 00000000..0551baf8
--- /dev/null
+++ b/packages/core/lib/control-state/run-operation-status.js
@@ -0,0 +1,59 @@
+import { readFileSync, existsSync } from '../control-read/fs.js';
+import { join } from 'node:path';
+import { readApprovalOperations } from './approval-operations.js';
+import { readArtefactBindings } from './artefact-bindings.js';
+import { readSourceRevisions } from './run-source-revisions.js';
+import { readRunOperations } from './run-operations.js';
+import { containedRegularFile, hasSymlinkComponent } from './contained-file.js';
+import { parseRunState } from './run-state-parser.js';
+import { runSealState } from './run-seal.js';
+import { readPendingRunStepJournal } from './run-step-transaction.js';
+import { validateRunPresentationEnvelope } from './run-presentation.js';
+import { digest, canonicalJson, resolveControlCommandTarget } from './approval-command-contract.js';
+import { RUN_ID_PATTERN, REVISION_ID_PATTERN } from './run-identity.js';
+
+// Lookup only. Receipts stay in their original family; no shadow ledger or recovery here.
+export function inspectRunOperation(root, { runId, operationId, targetId }) {
+  const result = extra => ({ schema_version: '1', run_id: runId, operation_id: operationId, authorizes: false, ...extra });
+  if (!RUN_ID_PATTERN.test(runId ?? '') || !REVISION_ID_PATTERN.test(operationId ?? '') || targetId !== resolveControlCommandTarget(root).target_id) return result({ status: 'unavailable', reason: 'operation_binding_invalid' });
+  const relative = `.agdf/control/runs/${runId}/RUN_STATE.md`;
+  if (hasSymlinkComponent(root, relative) || containedRegularFile(root, relative).status !== 'valid') return result({ status: 'unavailable', reason: 'run_path_invalid' });
+  const content = readFileSync(join(root, relative), 'utf8'), parsed = parseRunState(content, runId);
+  if (!parsed.valid) return result({ status: 'unavailable', reason: 'run_state_invalid' });
+  const records = [
+    ...readApprovalOperations(content).receipts.map(receipt => ({ kind: 'approval.record', receipt, id: receipt.operation_id, request_digest: receipt.command_digest ?? receipt.request_digest })),
+    ...readArtefactBindings(content).receipts.map(receipt => ({ kind: 'artefact.record', receipt, id: receipt.operation.id, request_digest: receipt.operation.request_digest ?? null })),
+    ...readSourceRevisions(content).receipts.map(receipt => ({ kind: 'source_revision.apply', receipt, id: receipt.operation_id, request_digest: receipt.command_digest ?? receipt.request_digest })),
+    ...readRunOperations(content).receipts.map(receipt => ({ kind: receipt.kind, receipt, id: receipt.operation_id, request_digest: receipt.request_digest })),
+  ].filter(row => row.id === operationId);
+  const pendingPath = `.agdf/control/runs/${runId}/RUN_STEP_PENDING.json`;
+  let pending = null;
+  if (existsSync(join(root, pendingPath))) {
+    try { const journal = readPendingRunStepJournal(root, runId, { readJournal: path => readFileSync(path, "utf8") }); pending = { kind: journal.kind ?? 'legacy',
+      operation_id: journal.operation_id, pending_digest: digest(canonicalJson(journal)), original_revision_id: journal.old_revision_id,
+      next_revision_id: journal.next_revision_id, schema_version: journal.schema_version, matches_operation: journal.operation_id === operationId }; }
+    catch { return result({ status: 'unknown', reason: 'pending_intent_unconfirmed', receipt: records[0]?.receipt ?? null }); }
+  }
+  if (records.length > 1) return result({ status: 'unknown', reason: 'operation_identity_ambiguous' });
+  if (records.length === 1) {
+    const record = records[0], seal = runSealState(root, content);
+    if (seal.status !== 'valid') return result({ status: 'unknown', reason: 'current_seal_unconfirmed', receipt: record.receipt, pending });
+    return result({ status: pending?.matches_operation ? 'committed_recovery_required' : 'recorded', family: record.kind,
+      request_digest: record.request_digest, receipt: record.receipt, historical_effect: true, current_revision_id: parsed.meta.revision_id, pending });
+  }
+  if (pending) return result({ status: pending.matches_operation ? 'pending' : 'unknown', reason: pending.matches_operation ? null : 'another_pending_operation', pending, current_revision_id: parsed.meta.revision_id });
+  // New immutable presentations use the original UUID as their presentation ID.
+  const path = `.agdf/control/runs/${runId}/presentations/${operationId}.json`;
+  if (existsSync(join(root, path))) {
+    if (hasSymlinkComponent(root, path) || containedRegularFile(root, path).status !== 'valid') return result({ status: 'unknown', reason: 'presentation_path_invalid' });
+    try {
+      const bytes = readFileSync(join(root, path), 'utf8'); if (Buffer.byteLength(bytes) > 262144) throw Error();
+      const envelope = JSON.parse(bytes), record = envelope.record;
+      const checked = validateRunPresentationEnvelope(envelope, { runId, gate: record.gate, revisionId: record.revision_id, presentationId: operationId });
+      if (checked.reason || record.operation_id !== operationId || !record.request_digest) throw Error();
+      return result({ status: 'recorded', family: 'presentation.prepare', receipt: record, request_digest: record.request_digest,
+        historical_effect: true, current_revision_id: parsed.meta.revision_id });
+    } catch { return result({ status: 'unknown', reason: 'presentation_operation_unconfirmed' }); }
+  }
+  return result({ status: 'absent', reason: 'absence_is_not_proof_of_non_execution', current_revision_id: parsed.meta.revision_id });
+}
diff --git a/packages/core/lib/control-state/run-operations.js b/packages/core/lib/control-state/run-operations.js
new file mode 100644
index 00000000..787a8647
--- /dev/null
+++ b/packages/core/lib/control-state/run-operations.js
@@ -0,0 +1,80 @@
+import { validDecisionMaterial, decisionMaterialVersion } from './presentation-decision.js';
+import { TextDecoder } from 'node:util';
+import { canonicalJson, digest, COOPERATIVE_ASSURANCE, DIGEST_PATTERN, exactObject } from './approval-command-contract.js';
+import { REVISION_ID_PATTERN, RUN_ID_PATTERN, APPROVAL_GATES } from './run-identity.js';
+import { isSafeControlRelativePath } from './contained-file.js';
+
+const fields = ['schema_version', 'kind', 'operation_id', 'request_digest', 'target_id', 'run_id', 'expected_revision_id', 'created_at', 'producer', 'assurance', 'effect'];
+export const RUN_OPERATION_KINDS = Object.freeze(['step.record', 'presentation_decision.record', 'prd_revision.reopen', 'closeout.record']);
+const uuid = value => typeof value === 'string' && REVISION_ID_PATTERN.test(value);
+const hash = value => typeof value === 'string' && DIGEST_PATTERN.test(value);
+const text = (value, max = 8192) => typeof value === 'string' && value.length <= max && !/\0/u.test(value);
+const source = (value, runId) => exactObject(value, ['path', 'digest']) && isSafeControlRelativePath(value.path)
+  && value.path.startsWith(`.agdf/control/artefacts/${runId}/`) && hash(value.digest);
+function validRecord(receipt) {
+  const r = receipt.effect.record;
+  if (receipt.kind === 'step.record') return exactObject(r, ['step', 'source', 'status', 'covers', 'source_set_digest'])
+    && ['ur', 'route', 'review', 'evidence', 'Brownfield Review', 'UX Intent Definition', 'Brownfield Analysis', 'CD+Tests', 'TP Review', 'Clean Implementation Review', 'CR'].includes(r.step)
+    && source(r.source, receipt.run_id) && ['done', 'revise', 'block', 'not_applicable'].includes(r.status)
+    && text(r.covers, 1024) && hash(r.source_set_digest);
+  if (receipt.kind === 'presentation_decision.record') return exactObject(r, ['gate', 'presentation_id', 'presentation_digest', 'material_version', 'material_sources', 'action', 'comment', 'owner', 'artefact_digest'])
+    && APPROVAL_GATES.includes(r.gate) && uuid(r.presentation_id) && hash(r.presentation_digest) && hash(r.material_version)
+    && validDecisionMaterial(r.material_sources, receipt.run_id) && r.material_version === decisionMaterialVersion(receipt.run_id, r.gate, r.material_sources) && ['request_change', 'reject'].includes(r.action) && text(r.comment) && Buffer.byteLength(r.comment) <= 8192 && (r.action !== 'request_change' || r.comment.trim())
+    && text(r.owner, 128) && r.owner.trim() && (r.gate === 'UAT' ? r.artefact_digest === null : hash(r.artefact_digest));
+  if (receipt.kind === 'closeout.record') return exactObject(r, ['or', 'lifecycle', 'context_evidence_digest', 'confirmation_digest'])
+    && source(r.or, receipt.run_id) && r.or.path === `.agdf/control/artefacts/${receipt.run_id}/OR.md`
+    && r.lifecycle === 'completed' && hash(r.context_evidence_digest) && hash(r.confirmation_digest);
+  if (receipt.kind === 'prd_revision.reopen') return exactObject(r, ['prd', 'archive', 'confirmation_digest']) && source(r.prd, receipt.run_id)
+    && r.prd.path === `.agdf/control/artefacts/${receipt.run_id}/PRD.md`
+    && exactObject(r.archive, ['path', 'digest']) && r.archive.path === `.agdf/control/runs/${receipt.run_id}/revisions/${receipt.operation_id}/manifest.json`
+    && hash(r.archive.digest) && hash(r.confirmation_digest)
+    && r.confirmation_digest === digest(earlyPrdConfirmation(receipt.run_id, receipt.expected_revision_id, receipt.operation_id, r.prd.digest));
+  return false;
+}
+export const earlyPrdConfirmation = (runId, revisionId, operationId, prdDigest) => `Reopen PRD: ${runId} ${revisionId} ${operationId} ${prdDigest}`;
+export function validRunOperation(receipt) {
+  return exactObject(receipt, fields) && receipt.schema_version === '1' && RUN_OPERATION_KINDS.includes(receipt.kind)
+    && uuid(receipt.operation_id) && hash(receipt.request_digest) && hash(receipt.target_id) && RUN_ID_PATTERN.test(receipt.run_id ?? '')
+    && uuid(receipt.expected_revision_id) && exactObject(receipt.effect, ['previous_revision_id', 'resulting_revision_id', 'revision', 'record'])
+    && receipt.effect.previous_revision_id === receipt.expected_revision_id && uuid(receipt.effect.resulting_revision_id)
+    && receipt.effect.resulting_revision_id !== receipt.expected_revision_id && Number.isSafeInteger(receipt.effect.revision) && receipt.effect.revision >= 2
+    && exactObject(receipt.producer, ['contract', 'package_version']) && receipt.producer.contract === 'run-command/1' && text(receipt.producer.package_version, 128) && receipt.producer.package_version
+    && canonicalJson(receipt.assurance) === canonicalJson(COOPERATIVE_ASSURANCE)
+    && typeof receipt.created_at === 'string' && /^\d{4}-\d{2}-\d{2}T.*Z$/u.test(receipt.created_at) && Number.isFinite(Date.parse(receipt.created_at)) && Boolean(validRecord(receipt));
+}
+export function readRunOperations(content) {
+  const lines = String(content).replace(/\r\n?/gu, '\n').split('\n');
+  const starts = lines.flatMap((line, i) => /^## Run Operations\s*$/u.test(line) ? [i] : []);
+  if (!starts.length) return { present: false, valid: true, receipts: [] };
+  const invalid = () => ({ present: true, valid: false, receipts: [], reason: 'run_operations_invalid' });
+  if (starts.length !== 1) return invalid();
+  const start = starts[0]; let end = start + 1;
+  while (end < lines.length && !/^#{1,2} /u.test(lines[end])) end++;
+  const body = lines.slice(start + 1, end).map(line => line.trim()).filter(Boolean);
+  if (body[0] !== '- schema_version: 1' || body[1] !== '| operation_id | request_digest | receipt |' || !/^\|[-:|\s]+\|$/u.test(body[2] ?? '')) return invalid();
+  const receipts = [], ids = new Set(), revisions = new Set(); let revision = 1;
+  for (const line of body.slice(3)) {
+    const cells = line.match(/^\| ([^|]+) \| ([^|]+) \| ([A-Za-z0-9_-]+) \|$/u);
+    if (!cells || cells[3].length > 131072) return invalid();
+    try {
+      const bytes = Buffer.from(cells[3], 'base64url'), json = new TextDecoder('utf-8', { fatal: true }).decode(bytes), r = JSON.parse(json);
+      if (bytes.toString('base64url') !== cells[3] || canonicalJson(r) !== json || !validRunOperation(r)
+        || r.operation_id !== cells[1] || r.request_digest !== cells[2] || ids.has(r.operation_id) || revisions.has(r.effect.resulting_revision_id) || r.effect.revision <= revision) return invalid();
+      receipts.push(r); ids.add(r.operation_id); revisions.add(r.effect.resulting_revision_id); revision = r.effect.revision;
+    } catch { return invalid(); }
+  }
+  return receipts.length ? { present: true, valid: true, receipts, start, end } : invalid();
+}
+export function appendRunOperation(content, receipt) {
+  const before = readRunOperations(content); if (!before.valid || !validRunOperation(receipt)) throw Error('AGDF_RUN_OPERATIONS_INVALID');
+  const block = ['## Run Operations', '', '- schema_version: 1', '', '| operation_id | request_digest | receipt |', '|---|---|---|',
+    ...[...before.receipts, receipt].map(r => `| ${r.operation_id} | ${r.request_digest} | ${Buffer.from(canonicalJson(r)).toString('base64url')} |`), ''];
+  const lines = String(content).split('\n');
+  const result = before.present ? [...lines.slice(0, before.start), ...block, ...lines.slice(before.end)].join('\n') : `${String(content).trimEnd()}\n\n${block.join('\n')}`;
+  if (!readRunOperations(result).valid) throw Error('AGDF_RUN_OPERATIONS_INVALID'); return result;
+}
+export function assertRunOperationsChange(current, candidate, appended) {
+  const before = readRunOperations(current), after = readRunOperations(candidate);
+  if (!before.valid || !after.valid || after.present !== (before.present || Boolean(appended))
+    || canonicalJson(after.receipts) !== canonicalJson(appended ? [...before.receipts, appended] : before.receipts)) throw Error('AGDF_RUN_OPERATIONS_CHANGED');
+}
diff --git a/packages/core/lib/control-state/run-owned-outputs.js b/packages/core/lib/control-state/run-owned-outputs.js
new file mode 100644
index 00000000..c0b3bf64
--- /dev/null
+++ b/packages/core/lib/control-state/run-owned-outputs.js
@@ -0,0 +1,59 @@
+import { join } from 'node:path';
+import { existsSync, lstatSync, readFileSync, unlinkSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { exactObject } from './approval-command-contract.js';
+import { hasSymlinkComponent } from './contained-file.js';
+import { atomicWrite, fsyncDirectory } from './run-state-writer.js';
+
+export const INTERNAL_STEP_FILES = Object.freeze({
+  'Brownfield Review': 'BROWNFIELD_REVIEW.md', 'UX Intent Definition': 'UX_INTENT_DEFINITION.md',
+  'Brownfield Analysis': 'BROWNFIELD_ANALYSIS.md', 'CD+Tests': 'CD_TESTS.md', 'TP Review': 'TP_REVIEW.md',
+  'Clean Implementation Review': 'CLEAN_IMPLEMENTATION_REVIEW.md', CR: 'CODE_REVIEW.md',
+});
+const permitted = new Set(['UR.md', 'OR.md', ...Object.values(INTERNAL_STEP_FILES)]);
+export const outputBytesDigest = text => text === null ? null : 'sha256:' + createHash('sha256').update(text, 'utf8').digest('hex');
+export function ownedOutputPath(root, runId, path) {
+  const prefix = `.agdf/control/artefacts/${runId}/`;
+  if (typeof path !== 'string' || !path.startsWith(prefix) || !permitted.has(path.slice(prefix.length)) || hasSymlinkComponent(root, path)) throw Error('AGDF_RUN_STEP_RECOVERY_REQUIRED');
+  return join(root, path);
+}
+export function ownedOutputText(root, runId, path) {
+  const file = ownedOutputPath(root, runId, path);
+  if (!existsSync(file)) return null;
+  const stat = lstatSync(file); if (!stat.isFile() || stat.isSymbolicLink() || stat.size > 131072) throw Error('AGDF_RUN_STEP_RECOVERY_REQUIRED');
+  return new TextDecoder('utf-8', { fatal: true }).decode(readFileSync(file));
+}
+export function validOwnedOutputs(runId, outputs) {
+  const prefix = `.agdf/control/artefacts/${runId}/`;
+  return Array.isArray(outputs) && outputs.length <= 2 && new Set(outputs.map(row => row?.path)).size === outputs.length
+    && outputs.every(row => exactObject(row, ['path', 'old', 'next', 'old_digest', 'next_digest'])
+      && typeof row.path === 'string' && row.path.startsWith(prefix) && permitted.has(row.path.slice(prefix.length))
+      && (row.old === null || typeof row.old === 'string') && typeof row.next === 'string'
+      && Buffer.byteLength(row.next) <= 131072 && (row.old === null || Buffer.byteLength(row.old) <= 131072)
+      && row.old_digest === outputBytesDigest(row.old) && row.next_digest === outputBytesDigest(row.next));
+}
+export function prepareOwnedOutput(root, runId, path, next) {
+  const old = ownedOutputText(root, runId, path), row = { path, old, next, old_digest: outputBytesDigest(old), next_digest: outputBytesDigest(next) };
+  if (!validOwnedOutputs(runId, [row])) throw Error('AGDF_RUN_STEP_RECOVERY_REQUIRED'); return row;
+}
+export function publishOwnedOutputs(root, journal, checkpoint) {
+  for (const row of journal.outputs) {
+    if (ownedOutputText(root, journal.run_id, row.path) !== row.old) throw Error('AGDF_RUN_STEP_RECOVERY_REQUIRED');
+    atomicWrite(ownedOutputPath(root, journal.run_id, row.path), row.next, { checkpoint: stage => checkpoint(`output_${stage}`) });
+    checkpoint('output');
+  }
+}
+export function recoverOwnedOutputs(root, journal, committed) {
+  for (const row of journal.outputs) {
+    const text = ownedOutputText(root, journal.run_id, row.path);
+    if (committed) { if (text !== row.next) throw Error('AGDF_RUN_STEP_RECOVERY_REQUIRED'); }
+    else {
+      if (text !== row.old && text !== row.next) throw Error('AGDF_RUN_STEP_RECOVERY_REQUIRED');
+      if (text !== row.old) {
+        const file = ownedOutputPath(root, journal.run_id, row.path);
+        if (row.old === null) { unlinkSync(file); fsyncDirectory(join(root, `.agdf/control/artefacts/${journal.run_id}`)); }
+        else atomicWrite(file, row.old);
+      }
+    }
+  }
+}
diff --git a/packages/core/lib/control-state/run-revision-boundary.js b/packages/core/lib/control-state/run-revision-boundary.js
new file mode 100644
index 00000000..7a007722
--- /dev/null
+++ b/packages/core/lib/control-state/run-revision-boundary.js
@@ -0,0 +1,30 @@
+import { transitionDecisionForRunState } from "../control-evaluation/gate-policy.js";
+import { SOURCE_GATES } from "./run-source-revisions.js";
+
+// Shared by current revision preparation and historical proof validation. A history
+// cannot acquire authority from a boundary that the original Run did not satisfy.
+export function sourceRevisionBoundary(state, sourceGate) {
+  const current = transitionDecisionForRunState(state);
+  if (state.meta.lifecycle !== "active"
+      || !["structured_delivery", "structured_slice"].includes(state.mode_slice_decision.decision)
+      || current.status !== "open"
+      || ["QA", "UAT"].some(gate => state.approvals.get(gate)?.status === "approved")
+      || state.artefacts.get("OR")?.status === "done") return null;
+  if (current.current_gate === "CD+Tests") {
+    return { sources: SOURCE_GATES, approved: SOURCE_GATES, bindings: ["PRD", "SD", "TP"] };
+  }
+  if (sourceGate !== "UR" || current.current_gate !== "SD"
+      || !["UR", "PRD"].every(gate => state.approvals.get(gate)?.status === "approved")
+      || ["SD", "TP"].some(gate => state.approvals.get(gate)?.status === "approved")
+      || state.artefacts.get("SD")?.status !== "draft" || !state.artefacts.get("SD")?.path
+      || ["TP", "Brownfield Analysis", "CD+Tests", "CR", "Code Review", "TP Review", "Clean Review",
+        "Clean Implementation Review", "QA", "QA_REPORT", "UAT", "OR"]
+        .some(type => state.artefacts.get(type)?.path || state.artefacts.get(type)?.status === "done")) return null;
+  return { sources: ["UR", "PRD", "SD"], approved: ["UR", "PRD"], bindings: ["PRD", "SD"] };
+}
+
+// Existing early PRD-to-SD boundary, shared with its immutable history validator.
+export function earlyPrdRevisionBoundary(state) {
+  return state.meta?.lifecycle === 'active' && state.approvals.get('PRD')?.status === 'approved'
+    && state.meta.current_gate === 'SD' && !['SD', 'TP', 'QA', 'UAT'].some(gate => state.approvals.get(gate)?.status === 'approved' || state.artefacts.get(gate)?.path);
+}
