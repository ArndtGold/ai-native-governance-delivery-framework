+import { useEffect, useRef, useState } from 'react';
+import { PassiveMarkdown } from '../DocumentView';
+import type { DecisionBootstrap, DecisionSubmission } from './decision-bootstrap';
+import { matchedDecisionReceipt } from './decision-bootstrap';
+type Reply = Record<string, unknown>;
+export interface DecisionPort {
+  submit: (input: DecisionSubmission) => Promise<Reply>;
+  document: () => Promise<string>;
+  inspect: (operation: string) => Promise<Reply>;
+  expand: () => Promise<void>;
+}
+export function DecisionCard({ view, port }: { view: DecisionBootstrap; port: DecisionPort }) {
+  const l = view.labels, [comment, setComment] = useState(''), [status, setStatus] = useState('undecided'), [message, setMessage] = useState('');
+  const [document, setDocument] = useState<string | null>(null), [reading, setReading] = useState(false), [checking, setChecking] = useState(false);
+  const alive = useRef(true), pending = useRef<DecisionSubmission | null>(null), inflight = useRef(false), openButton = useRef<HTMLButtonElement>(null);
+  const documentHeading = useRef<HTMLHeadingElement>(null), restoreFocus = useRef(false);
+  const current = () => alive.current && Date.now() < view.expires_at;
+  useEffect(() => {
+    if (document !== null) documentHeading.current?.focus();
+    else if (restoreFocus.current) { restoreFocus.current = false; openButton.current?.focus(); }
+  }, [document]);
+  useEffect(() => {
+    alive.current = true;
+    const timer = setTimeout(() => { if (alive.current) { setStatus('expired'); setMessage(l.expired); } }, Math.max(0, view.expires_at - Date.now()));
+    return () => { alive.current = false; clearTimeout(timer); };
+  }, [view, l.expired]);
+  const receive = (reply: Reply, input: DecisionSubmission) => {
+    if (!current()) { setStatus('expired'); setMessage(l.expired); return; }
+    if (reply.view_state === 'closed') { setStatus('expired'); setMessage(l.expired); return; }
+    if (['accepted', 'already_applied'].includes(String(reply.outcome)) && matchedDecisionReceipt(reply.receipt, view, input)) {
+      setStatus('saved');
+      const current = reply.current as { available?: boolean } | undefined;
+      setMessage(l.confirmed + (current?.available === false ? ' ' + l.unknownCurrent : '')); return;
+    }
+    if (reply.outcome === 'rejected') {
+      const reason = String(reply.reason);
+      const unavailable = ['stale_revision', 'decision_binding_changed', 'presentation_state_changed', 'decision_binding_invalid', 'presentation_version_decided'].includes(reason);
+      const expired = reason === 'session_expired';
+      setStatus(expired ? 'expired' : unavailable ? 'stale' : 'undecided');
+      setMessage(expired ? l.expired : reason === 'presentation_version_decided' ? l.alreadyDecided : unavailable ? l.sourceChanged : l.denied);
+      pending.current = null; return;
+    }
+    setStatus('uncertain'); setMessage(l.uncertain);
+  };
+  const send = async (input: DecisionSubmission) => {
+    if (inflight.current || !current()) return;
+    inflight.current = true; pending.current = input; setStatus('pending'); setMessage(l.pending);
+    try { const reply = await port.submit(input); if (alive.current) receive(reply, input); }
+    catch { if (alive.current) { setStatus('uncertain'); setMessage(l.uncertain); } }
+    finally { inflight.current = false; }
+  };
+  const decide = (action: DecisionSubmission['action']) => {
+    if (!current() || status !== 'undecided' || view.capability !== 'available' || !view.enabled_actions.includes(action)) return;
+    if (action === 'request_change' && !comment.trim()) { setMessage(l.commentRequired); return; }
+    if (new TextEncoder().encode(comment).length > 8192) { setMessage(l.commentTooLarge); return; }
+    void send({ session_id: view.session_id, operation_id: crypto.randomUUID(), presentation_id: view.binding.presentation_id,
+      expected_revision_id: view.binding.expected_revision_id, action, ...(comment ? { comment } : {}) });
+  };
+  const inspect = async () => {
+    const input = pending.current;
+    if (!input || !current() || inflight.current || checking) return;
+    setChecking(true);
+    try {
+      const result = await port.inspect(input.operation_id);
+      if (!alive.current) return;
+      if (!current()) { setStatus('expired'); setMessage(l.expired); return; }
+      if (result.status === 'recorded' && matchedDecisionReceipt(result.receipt, view, input)) {
+        setStatus('saved'); setMessage(l.confirmed);
+      } else setMessage(l.uncertain); // Even absence cannot establish non-execution.
+    } catch { if (alive.current) setMessage(l.uncertain); }
+    finally { if (alive.current) setChecking(false); }
+  };
+  const open = async () => {
+    if (reading || !view.resource_id) return;
+    setReading(true);
+    try {
+      const text = await port.document();
+      if (!alive.current) return;
+      await port.expand();
+      if (alive.current) setDocument(text);
+    } catch { if (alive.current) setMessage(l.docUnavailable); }
+    finally { if (alive.current) setReading(false); }
+  };
+  const disabled = status !== 'undecided' || view.capability !== 'available';
+  if (document !== null) return <section className="decision-card agdf-surface mcp-entry">
+    <button type="button" onClick={() => { restoreFocus.current = true; setDocument(null); }}>{l.back}</button>
+    <h1 ref={documentHeading} tabIndex={-1}>{l.documentTitle} · {view.binding.gate}</h1><p>{view.title}</p>
+    <article className="document"><PassiveMarkdown content={document} links={{}} onOpen={() => {}}/></article>
+  </section>;
+  return <section className="decision-card agdf-surface mcp-entry" aria-label={l.title}>
+    <h1>{view.title}</h1><p>{l.gate}: <strong>{view.binding.gate}</strong></p><p>{l.initialize}</p>
+    <article className="decision-summary document"><PassiveMarkdown content={view.summary} links={{}} onOpen={() => {}}/></article>
+    <h2>{l.comparison}</h2>{view.comparison.state === 'unavailable' ? <p>{l.comparisonUnavailable}</p> : <>
+      <p>{l.machineComparison}</p><p>{view.comparison.unchanged ? l.documentUnchanged : l.documentChanged}</p>
+      <p>{l.revision}: <code>{view.comparison.previous_revision_id}</code><br/><code>{view.comparison.previous_digest}</code></p>
+      <details><summary>{l.previousDocument}</summary><article className="document"><PassiveMarkdown content={view.comparison.previous_text} links={{}} onOpen={() => {}}/></article></details>
+    </>}
+    <p>{l.consequence}</p><p>{l.sourceLanguage}</p>
+    <button type="button" ref={openButton} disabled={!view.resource_id || reading} onClick={() => void open()}>{l.openDocument}</button>
+    {!view.resource_id && <p>{l.docUnavailable}</p>}
+    <details><summary>{l.sources}</summary><dl>
+      <dt>{l.run}</dt><dd>{view.binding.run_id}</dd><dt>{l.revision}</dt><dd><code>{view.binding.expected_revision_id}</code></dd>
+      {view.binding.material_sources.map(source => <div key={source.type}><dt>{source.type}</dt><dd><code>{source.path}</code><br/><code>{source.digest}</code></dd></div>)}
+    </dl></details>
+    <label className="decision-comment">{l.comment}<textarea value={comment} disabled={disabled} onChange={event => setComment(event.target.value)} aria-describedby="decision-comment-help"/></label>
+    <p id="decision-comment-help">{l.commentHelp}</p>
+    {view.capability !== 'available' && <p role="status">{l.notQualified}</p>}
+    <div className="decision-actions">{(['approve', 'request_change', 'reject'] as const).map(action =>
+      <button key={action} type="button" disabled={disabled || !view.enabled_actions.includes(action)} onClick={() => decide(action)}>{l[action]}</button>)}</div>
+    <p>{l.permission}</p><p role="status">{message || l.notSaved}</p>
+    {status === 'uncertain' && <div className="decision-actions">
+      <button type="button" disabled={checking} onClick={() => void inspect()}>{l.checkOperation}</button>
+      <button type="button" disabled={checking} onClick={() => { if (pending.current) void send(pending.current); }}>{l.retryOriginal}</button>
+    </div>}
+  </section>;
+}
diff --git a/packages/control-ui/src/mcp/DecisionEntry.tsx b/packages/control-ui/src/mcp/DecisionEntry.tsx
new file mode 100644
index 00000000..2059d694
--- /dev/null
+++ b/packages/control-ui/src/mcp/DecisionEntry.tsx
@@ -0,0 +1,90 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { applyDocumentTheme, applyHostStyleVariables } from '@modelcontextprotocol/ext-apps';
+import { CockpitBridge } from './transport';
+import { readDecisionBootstrap, type DecisionBootstrap, type DecisionSubmission } from './decision-bootstrap';
+import { DecisionCard, type DecisionPort } from './DecisionCard';
+
+export function DecisionEntry({ bridge }: { bridge: CockpitBridge }) {
+  const [view, setView] = useState<DecisionBootstrap | null>(null), [connected, setConnected] = useState(false);
+  const current = useRef<DecisionBootstrap | null>(null);
+  useEffect(() => {
+    let alive = true;
+    const close = async (old: DecisionBootstrap) => { await bridge.operation({ operation: 'close' }, undefined, old.read_session_id).catch(() => {}); };
+    let retirement: Promise<void> | undefined;
+    const retire = (render = true) => {
+      if (retirement) return retirement;
+      alive = false;
+      const old = current.current;
+      current.current = null; bridge.session = '';
+      if (render) setView(null);
+      // Invalidate locally before sending the bounded close. A late read or
+      // tool result must not restore a view while the host removes its frame.
+      retirement = old ? close(old) : Promise.resolve();
+      return retirement;
+    };
+    const pagehide = () => { void retire(); };
+    window.addEventListener('pagehide', pagehide);
+    const theme = () => {
+      const host = bridge.app.getHostContext();
+      if (host?.theme) applyDocumentTheme(host.theme);
+      if (host?.styles?.variables) applyHostStyleVariables(host.styles.variables);
+    };
+    bridge.app.ontoolresult = result => {
+      if (!alive) return;
+      const next = readDecisionBootstrap(result), previous = current.current;
+      if (!next || previous && next.target.target_id !== previous.target.target_id) return;
+      if (previous && previous.owner_epoch === next.owner_epoch && next.generation <= previous.generation) {
+        if (next.session_id !== previous.session_id) void close(next); return;
+      }
+      if (previous) void close(previous);
+      current.current = next; bridge.session = next.read_session_id; setView(next); theme();
+      document.documentElement.lang = next.binding.presentation_language;
+    };
+    bridge.app.onhostcontextchanged = theme;
+    bridge.app.onteardown = async () => {
+      await retire();
+      return {};
+    };
+    void bridge.app.connect(undefined, { timeout: 10_000 }).then(() => { if (alive) { setConnected(true); theme(); } }).catch(() => {});
+    return () => { window.removeEventListener('pagehide', pagehide); void retire(false); };
+  }, [bridge]);
+  const port = useMemo<DecisionPort | null>(() => {
+    if (!view) return null;
+    const call = async (name: string, argumentsValue: Record<string, unknown>) => {
+      if (current.current !== view || !bridge.app.getHostCapabilities()?.serverTools) throw Error('session_invalid');
+      const result = await bridge.request(() => bridge.app.callServerTool({ name, arguments: argumentsValue }, { timeout: 10_000 }));
+      if (current.current !== view) throw Error('session_invalid');
+      if (result.isError || !result.structuredContent) throw Error('result_unconfirmed');
+      return result.structuredContent as Record<string, unknown>;
+    };
+    return {
+      submit: (input: DecisionSubmission) => call('agdf_decision_action', { ...input }),
+      document: async () => {
+        if (current.current !== view) throw Error('session_invalid');
+        const result = await bridge.operation({ operation: 'document', snapshot_id: view.snapshot_id, run_id: view.binding.run_id,
+          resource_id: view.resource_id }, undefined, view.read_session_id) as { state?: string; data?: { document?: { content?: string; content_digest?: string } } };
+        const document = result.data?.document;
+        if (current.current !== view || result.state !== 'available' || typeof document?.content !== 'string'
+          || 'sha256:' + document.content_digest !== view.document_digest) throw Error('presented_document_unavailable');
+        return document.content;
+      },
+      inspect: async operation => {
+        const result = await call('agdf_inspect', { operation: 'operation-status', module: operation, presentation_language: view.binding.presentation_language,
+          working_directory: view.target.display_path, target_source: 'explicit_target', primary_target: view.target.display_path,
+          run_id: view.binding.run_id, expected_revision_id: view.binding.expected_revision_id });
+        if (result.outcome !== 'inspect_result' || typeof result.report !== 'object' || !result.report) throw Error('result_unconfirmed');
+        return result.report as Record<string, unknown>;
+      },
+      expand: async () => {
+        const modes = bridge.app.getHostContext()?.availableDisplayModes ?? [];
+        const mode = modes.includes('fullscreen') ? 'fullscreen' : modes.includes('pip') ? 'pip' : null;
+        if (!mode) throw Error('display_mode_unavailable');
+        const result = await bridge.request(() => bridge.app.requestDisplayMode({ mode }, { timeout: 10_000 }));
+        if (result.mode !== mode) throw Error('display_mode_unavailable');
+      },
+    };
+  }, [bridge, view]);
+  const effectiveView = useMemo(() => view && !bridge.app.getHostCapabilities()?.serverTools ? { ...view, capability: 'not_qualified' as const, enabled_actions: [] } : view, [view, connected, bridge]);
+  return connected && effectiveView && port ? <DecisionCard key={effectiveView.session_id} view={effectiveView} port={port}/>
+    : <section className="decision-card"><h1>AGDF</h1><p role="status">{view?.labels.connecting ?? 'AGDF · …'}</p></section>;
+}
diff --git a/packages/control-ui/src/mcp/decision-bootstrap.ts b/packages/control-ui/src/mcp/decision-bootstrap.ts
new file mode 100644
index 00000000..3751826b
--- /dev/null
+++ b/packages/control-ui/src/mcp/decision-bootstrap.ts
@@ -0,0 +1,54 @@
+import { DECISION_CARD_LABEL_KEYS } from '../../../core/lib/interaction-catalog.js';
+export interface DecisionBootstrap {
+  schema_version: '1'; session_id: string; read_session_id: string; owner_epoch: string; generation: number; expires_at: number;
+  target: { target_id: string; display_path: string }; title: string; labels: Record<string, string>;
+  binding: { target_id: string; run_id: string; gate: string; expected_revision_id: string; presentation_id: string;
+    presentation_digest: string; material_version: string; material_sources: { type: string; path: string; digest: string }[]; presentation_language: string };
+  summary: string; snapshot_id: string; resource_id: string | null; document_digest: string | null;
+  enabled_actions: ('approve' | 'request_change' | 'reject')[]; capability: 'available' | 'not_qualified'; comparison:
+    { state: 'unavailable'; reason: string } | { state: 'available'; previous_revision_id: string; previous_digest: string; current_digest: string; unchanged: boolean; previous_text: string };
+}
+const object = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
+const uuid = (value: unknown) => typeof value === 'string' && /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(value);
+const hash = (value: unknown) => typeof value === 'string' && /^sha256:[a-f0-9]{64}$/.test(value);
+export function readDecisionBootstrap(result: unknown): DecisionBootstrap | null {
+  if (!object(result) || !object(result._meta) || !object(result._meta.agdf_decision)) return null;
+  const row = result._meta.agdf_decision, b = row.binding, target = row.target;
+  if (!object(b) || !object(target) || !object(row.labels) || !object(row.comparison)) return null;
+  if (row.schema_version !== '1' || !['session_id', 'read_session_id', 'owner_epoch', 'snapshot_id'].every(key => uuid(row[key]))
+    || !Number.isSafeInteger(row.generation) || Number(row.generation) < 1 || typeof row.expires_at !== 'number' || !Number.isFinite(row.expires_at)
+    || typeof row.summary !== 'string' || !row.summary.trim() || new TextEncoder().encode(row.summary).length > 262144
+    || typeof row.title !== 'string' || !row.title.trim() || typeof target.display_path !== 'string' || !hash(target.target_id)
+    || b.target_id !== target.target_id || typeof b.run_id !== 'string' || !/^[A-Za-z0-9_-]{1,128}$/.test(b.run_id)
+    || !['UR', 'PRD', 'SD', 'TP', 'QA', 'UAT'].includes(String(b.gate)) || !uuid(b.expected_revision_id) || !uuid(b.presentation_id)
+    || !hash(b.material_version) || !hash(b.presentation_digest) || typeof b.presentation_language !== 'string'
+    || !Array.isArray(b.material_sources) || !b.material_sources.length || b.material_sources.length > 12
+    || !b.material_sources.every(s => object(s) && typeof s.type === 'string' && hash(s.digest) && typeof s.path === 'string'
+      && s.path.startsWith(`.agdf/control/artefacts/${b.run_id}/`) && !s.path.includes('..'))
+    || !(row.resource_id === null || uuid(row.resource_id)) || !(row.document_digest === null || hash(row.document_digest))
+    || !Array.isArray(row.enabled_actions) || new Set(row.enabled_actions).size !== row.enabled_actions.length
+    || !row.enabled_actions.every(action => ['approve', 'request_change', 'reject'].includes(String(action)))
+    || !['available', 'not_qualified'].includes(String(row.capability)) || row.capability === 'not_qualified' && row.enabled_actions.length > 0
+    || !(row.comparison.state === 'unavailable' && typeof row.comparison.reason === 'string'
+      || row.comparison.state === 'available' && uuid(row.comparison.previous_revision_id) && hash(row.comparison.previous_digest)
+        && row.comparison.current_digest === row.document_digest && typeof row.comparison.unchanged === 'boolean'
+        && row.comparison.unchanged === (row.comparison.previous_digest === row.comparison.current_digest)
+        && typeof row.comparison.previous_text === 'string' && new TextEncoder().encode(row.comparison.previous_text).length <= 131072)
+    || DECISION_CARD_LABEL_KEYS.some(key => typeof (row.labels as Record<string, unknown>)[key] !== 'string' || !(row.labels as Record<string, string>)[key].trim())) return null;
+  return row as unknown as DecisionBootstrap;
+}
+export interface DecisionSubmission { session_id: string; operation_id: string; presentation_id: string; expected_revision_id: string;
+  action: 'approve' | 'request_change' | 'reject'; comment?: string }
+export function matchedDecisionReceipt(receipt: unknown, view: DecisionBootstrap, input: DecisionSubmission): boolean {
+  if (!object(receipt) || receipt.operation_id !== input.operation_id || !object(receipt.effect)) return false;
+  const b = object(receipt.binding) ? receipt.binding : receipt;
+  const effect = receipt.effect, record = object(effect.record) ? effect.record : null;
+  return b.run_id === view.binding.run_id && b.target_id === view.binding.target_id && b.expected_revision_id === view.binding.expected_revision_id
+    && effect.previous_revision_id === view.binding.expected_revision_id
+    && (input.action === 'approve' ? receipt.action === 'record_gate_approval' && b.gate === view.binding.gate
+      && b.presentation_id === view.binding.presentation_id && effect.approval === `Approval: ${view.binding.gate}`
+      && effect.presentation_digest === view.binding.presentation_digest && effect.material_version === view.binding.material_version
+      : receipt.kind === 'presentation_decision.record' && record?.gate === view.binding.gate
+        && record.presentation_id === view.binding.presentation_id && record.presentation_digest === view.binding.presentation_digest
+        && record.material_version === view.binding.material_version && record.action === input.action && record.comment === (input.comment ?? ''));
+}
