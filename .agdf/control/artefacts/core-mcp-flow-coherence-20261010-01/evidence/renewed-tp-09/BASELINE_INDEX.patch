diff --git a/packages/mcp-server/test/decision-resource.test.js b/packages/mcp-server/test/decision-resource.test.js
new file mode 100644
index 00000000..3219a143
--- /dev/null
+++ b/packages/mcp-server/test/decision-resource.test.js
@@ -0,0 +1,107 @@
+import assert from 'node:assert/strict';
+import { randomUUID, createHash } from 'node:crypto';
+import { readFileSync, mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { createOwnedRuntimeFixture } from './owned-runtime.js';
+import { withStdioClient } from './helpers.js';
+import { createSdDefinitionTestRun, syntheticSd } from '../../cli/scripts/fixtures/sd-definition.js';
+import { writeFileSync } from 'node:fs';
+import { resolveControlCommandTarget } from '../../core/lib/control-state/approval-command-contract.js';
+import { DECISION_UI_URI } from '../../core/lib/control-state/decision-action-contract.js';
+import { COCKPIT_MIME } from '../../core/lib/control-inspect/cockpit-contract.js';
+import { MCP_APP_UI_EXTENSION } from '../src/ui-capability.js';
+import { readDecisionUiBuild } from '../../../scripts/cockpit-ui-build.mjs';
+import { DECISION_APP_OBSERVATIONS } from '../../core/lib/runtime/plugin-provenance.js';
+const fixture = createOwnedRuntimeFixture(), root = fixture.governanceTarget, cli = join(fixture.dispatcherRoot, 'bin/create-agdf.js');
+try {
+  const f = createSdDefinitionTestRun(root, cli, 'actual-package-decision', process.env, { typedApprovals: true });
+  writeFileSync(f.file('SD.md'), syntheticSd()); assert.equal(f.recordSd().value.outcome, 'recorded');
+  const before = readFileSync(f.state, 'utf8'), ui = { extensions: { [MCP_APP_UI_EXTENSION]: { mimeTypes: [COCKPIT_MIME] } } };
+  for (const modern of [false, true]) {
+    const input = { schema_version: '1', presentation_language: 'de', working_directory: root, target_source: 'explicit_target', primary_target: root,
+      target_id: resolveControlCommandTarget(root).target_id, run_id: f.runId, expected_revision_id: f.revision(), operation_id: randomUUID(), assurance: 'cooperative_local',
+      command: { kind: 'presentation.prepare', payload: { gate: 'SD' } } };
+    await withStdioClient({ ...fixture, modern, capabilities: ui }, async client => {
+      const { tools } = await client.listTools();
+      assert.equal(tools.length, 9);
+      const facade = tools.find(tool => tool.name === 'agdf_decision_action');
+      assert.deepEqual(facade._meta.ui.visibility, ['app']); assert.equal(facade._meta.ui.resourceUri, DECISION_UI_URI);
+      assert.deepEqual(facade.annotations, { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false });
+      const { resources } = await client.listResources(); assert.deepEqual(resources.map(resource => resource.uri), [DECISION_UI_URI]);
+      const resource = await client.readResource({ uri: DECISION_UI_URI }), content = resource.contents[0];
+      assert.equal(content.mimeType, COCKPIT_MIME); assert.equal(content.text, readDecisionUiBuild().files['decision.html'].toString('utf8'));
+      assert.equal('sha256:' + createHash('sha256').update(content.text).digest('hex'), readDecisionUiBuild().manifest.digest);
+      const prepared = await client.callTool({ name: 'agdf_prepare', arguments: input });
+      assert.equal(prepared.structuredContent.outcome, 'accepted', JSON.stringify(prepared));
+      assert.equal(prepared.structuredContent.app_capability, 'not_qualified');
+      const view = prepared._meta.agdf_decision; assert.ok(view); assert.deepEqual(view.enabled_actions, []);
+      assert.equal(prepared.structuredContent.session_id, undefined);
+      assert.equal(prepared.content[0].text.includes(view.session_id), false, 'Decision nonce is withheld from model-visible content.');
+      for (const action of ['approve', 'request_change', 'reject']) {
+        const result = await client.callTool({ name: facade.name, arguments: { session_id: view.session_id, operation_id: randomUUID(),
+          presentation_id: view.binding.presentation_id, expected_revision_id: view.binding.expected_revision_id, action, comment: 'Synthetic non-authorizing intent' } });
+        assert.equal(result.structuredContent.outcome, 'rejected'); assert.equal(result.structuredContent.reason, 'app_only_mediation_not_qualified');
+      }
+      const document = await client.callTool({ name: 'agdf_cockpit_read', arguments: { operation: 'document', session_id: view.read_session_id,
+        snapshot_id: view.snapshot_id, run_id: f.runId, resource_id: view.resource_id } });
+      assert.equal(document.structuredContent.state, 'available', JSON.stringify(document));
+      assert.equal('sha256:' + document.structuredContent.data.document.content_digest, view.document_digest);
+      // The immutable App metadata must remain usable after the reader rotates
+      // its internal snapshot/resource selectors on each document projection.
+      for (let attempt = 0; attempt < 3; ++attempt) {
+        const reopened = await client.callTool({ name: 'agdf_cockpit_read', arguments: { operation: 'document', session_id: view.read_session_id,
+          snapshot_id: view.snapshot_id, run_id: f.runId, resource_id: view.resource_id } });
+        assert.equal(reopened.structuredContent.state, 'available', JSON.stringify(reopened));
+        assert.equal(reopened.structuredContent.data.document.content, document.structuredContent.data.document.content);
+      }
+      const closed = await client.callTool({ name: 'agdf_cockpit_read', arguments: { operation: 'close', session_id: view.read_session_id } });
+      assert.equal(closed.structuredContent.data.closed, true);
+      const expired = await client.callTool({ name: facade.name, arguments: { session_id: view.session_id, operation_id: randomUUID(),
+        presentation_id: view.binding.presentation_id, expected_revision_id: view.binding.expected_revision_id, action: 'reject' } });
+      assert.equal(expired.structuredContent.reason, 'session_expired');
+    });
+    await withStdioClient({ ...fixture, modern }, async client => {
+      assert.equal((await client.listTools()).tools.some(tool => tool.name === 'agdf_decision_action'), false);
+      assert.equal((await client.listResources()).resources.length, 0);
+      const result = await client.callTool({ name: 'agdf_decision_action', arguments: { session_id: randomUUID(), operation_id: randomUUID(),
+        presentation_id: randomUUID(), expected_revision_id: f.revision(), action: 'reject' } });
+      assert.equal(result.structuredContent.outcome, 'rejected'); assert.equal(result.structuredContent.reason, 'host_ui_unsupported');
+    });
+  }
+  await withStdioClient({ ...fixture, capabilities: ui, env: { AGDF_MCP_COMMAND_GROUPS: '' } }, async client => {
+    const names = (await client.listTools()).tools.map(tool => tool.name);
+    assert.deepEqual(names, ['agdf_dispatch', 'agdf_inspect', 'agdf_cockpit_read']);
+    assert.equal(names.includes('agdf_decision_action'), false);
+  });
+  assert.equal(readFileSync(f.state, 'utf8'), before, 'Preparation, capability advertisement, read, non-qualified choices and teardown cannot decide.');
+  // Positive loader contract on an explicitly synthetic host/evidence tuple.
+  // This does not qualify the real Codex app, its mediation or human decisions.
+  const markerPath = join(fixture.root, '.agdf-mcp-owned.json'), marker = JSON.parse(readFileSync(markerPath, 'utf8'));
+  mkdirSync(join(fixture.root, 'qualification'));
+  const evidence = 'Synthetic entrypoint contract data; no native qualification.';
+  writeFileSync(join(fixture.root, 'qualification', 'synthetic.log'), evidence);
+  marker.decision_app_qualification = { schema_version: 1, result: 'qualified', surface: 'codex',
+    host: { name: 'agdf-mcp-test', version: '1.0.0', os: process.platform, arch: process.arch },
+    candidate: { server_digest: marker.server_digest, dispatcher_digest: marker.dispatcher_digest, sdk_digest: marker.sdk_digest,
+      resource_digest: readDecisionUiBuild().manifest.digest.slice(7) }, observations: [...DECISION_APP_OBSERVATIONS],
+    evidence: [{ path: 'qualification/synthetic.log', digest: createHash('sha256').update(evidence).digest('hex') }], assurance: 'cooperative_local', authorizes: false };
+  writeFileSync(markerPath, JSON.stringify(marker));
+  for (const modern of [false, true]) await withStdioClient({ ...fixture, modern, capabilities: ui }, async client => {
+    const input = { schema_version: '1', presentation_language: 'de', working_directory: root, target_source: 'explicit_target', primary_target: root,
+      target_id: resolveControlCommandTarget(root).target_id, run_id: f.runId, expected_revision_id: f.revision(), operation_id: randomUUID(), assurance: 'cooperative_local',
+      command: { kind: 'presentation.prepare', payload: { gate: 'SD' } } };
+    const prepared = await client.callTool({ name: 'agdf_prepare', arguments: input });
+    assert.equal(prepared.structuredContent.app_capability, 'available', JSON.stringify(prepared));
+    assert.deepEqual(prepared._meta.agdf_decision.enabled_actions, ['approve', 'request_change', 'reject']);
+    // Evidence revocation after opening must reject before Core decision effects.
+    writeFileSync(join(fixture.root, 'qualification', 'synthetic.log'), 'Evidence changed after view opened');
+    const v = prepared._meta.agdf_decision;
+    const rejected = await client.callTool({ name: 'agdf_decision_action', arguments: { session_id: v.session_id, operation_id: randomUUID(),
+      presentation_id: v.binding.presentation_id, expected_revision_id: v.binding.expected_revision_id, action: 'approve' } });
+    assert.equal(rejected.structuredContent.reason, 'app_only_mediation_not_qualified');
+    assert.equal(readFileSync(f.state, 'utf8'), before);
+    writeFileSync(join(fixture.root, 'qualification', 'synthetic.log'), evidence);
+    await client.callTool({ name: 'agdf_cockpit_read', arguments: { operation: 'close', session_id: v.read_session_id } });
+  });
+  console.log('Exact owned generated package UI resource, private nonce, model/App discovery, unqualified enforcement, disabled groups, document bytes and teardown passed over both actual STDIO eras; native qualification remains absent.');
+} finally { fixture.dispose(); }
diff --git a/packages/mcp-server/test/revision-command.test.js b/packages/mcp-server/test/revision-command.test.js
new file mode 100644
index 00000000..585e613a
--- /dev/null
+++ b/packages/mcp-server/test/revision-command.test.js
@@ -0,0 +1,108 @@
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { createOwnedRuntimeFixture } from './owned-runtime.js';
+import { withStdioClient } from './helpers.js';
+import { createSdDefinitionTestRun } from '../../cli/scripts/fixtures/sd-definition.js';
+import { createLateSourceRevisionTestRun } from '../../cli/scripts/fixtures/late-source-revision.js';
+import { createEarlyUrRevisionTestRun } from '../../cli/scripts/fixtures/early-ur-revision.js';
+import { resolveControlCommandTarget } from '../../core/lib/control-state/approval-command-contract.js';
+import { artefactFileDigest, runSealState } from '../../core/lib/control-state/run-seal.js';
+import { earlyPrdConfirmation, readRunOperations } from '../../core/lib/control-state/run-operations.js';
+import { readSourceRevisions } from '../../core/lib/control-state/run-source-revisions.js';
+import { readValidatedRevisionArchive } from '../../core/lib/control-state/run-revision-history.js';
+import { readApprovalOperations } from '../../core/lib/control-state/approval-operations.js';
+
+for (const modern of [false, true]) {
+  const fixture = createOwnedRuntimeFixture(), root = fixture.governanceTarget, cli = join(fixture.dispatcherRoot, 'bin/create-agdf.js');
+  try {
+    const early = createSdDefinitionTestRun(root, cli, 'mcp-early-prd', process.env, { typedApprovals: true });
+    const late = createLateSourceRevisionTestRun(root, cli, 'mcp-late-source');
+    const earlyUr = createEarlyUrRevisionTestRun(root, cli, 'mcp-early-ur');
+    const bound = f => ({ schema_version: '1', presentation_language: 'en', working_directory: root, target_source: 'explicit_target',
+      primary_target: root, target_id: resolveControlCommandTarget(root).target_id, run_id: f.runId,
+      expected_revision_id: f.revision(), operation_id: randomUUID(), assurance: 'cooperative_local' });
+    await withStdioClient({ ...fixture, modern }, async client => {
+      const call = async input => { const result = await client.callTool({ name: 'agdf_revise', arguments: input });
+        assert.ok(result.structuredContent, JSON.stringify(result)); return result.structuredContent; };
+      const reopen = { ...bound(early), command: { kind: 'prd_revision.reopen', payload: {
+        prd: { path: early.prefix + 'PRD.md', digest: artefactFileDigest(root, early.prefix + 'PRD.md') }, confirmation: 'No deliberate exact confirmation' } } };
+      const before = readFileSync(early.state, 'utf8');
+      assert.equal((await call(reopen)).reason, 'revision_confirmation_required'); assert.equal(readFileSync(early.state, 'utf8'), before);
+      reopen.command.payload.confirmation = earlyPrdConfirmation(early.runId, reopen.expected_revision_id, reopen.operation_id, reopen.command.payload.prd.digest);
+      assert.equal((await call(reopen)).outcome, 'accepted');
+      assert.equal((await call(reopen)).outcome, 'already_applied');
+      assert.equal(readRunOperations(readFileSync(early.state, 'utf8')).receipts.length, 1);
+      assert.equal(runSealState(root, readFileSync(early.state, 'utf8')).status, 'valid');
+      const proposal = late.proposal('TP'), envelope = { ...bound(late), operation_id: proposal.input.operationId };
+      const payload = { source_gate: 'TP', proposal: { path: proposal.input.evidence, digest: artefactFileDigest(root, proposal.input.evidence) } };
+      const old = readFileSync(late.state, 'utf8');
+      const preview = await call({ ...envelope, command: { kind: 'source_revision.preview', payload } });
+      assert.equal(preview.outcome, 'accepted', JSON.stringify(preview)); assert.equal(readFileSync(late.state, 'utf8'), old);
+      const apply = { ...envelope, command: { kind: 'source_revision.apply', payload: { ...payload,
+        preview_digest: preview.family_result.preview_digest, confirmation: 'Technical permission only' } } };
+      assert.equal((await call(apply)).reason, 'confirmation_required'); assert.equal(readFileSync(late.state, 'utf8'), old);
+      apply.command.payload.confirmation = preview.family_result.confirmation_selector;
+      assert.equal((await call(apply)).outcome, 'accepted'); assert.equal((await call(apply)).outcome, 'already_applied');
+      assert.equal(readSourceRevisions(readFileSync(late.state, 'utf8')).receipts.length, 1);
+      assert.equal(runSealState(root, readFileSync(late.state, 'utf8')).status, 'valid');
+      assert.equal((await call({ ...apply, presentation_language: 'de' })).reason, 'revision_operation_conflict');
+      // Exercise the already-supported UR-at-SD boundary through the generated
+      // command group, rather than treating earlier CLI/source proof as MCP proof.
+      const urProposal = earlyUr.proposal(), urBefore = readFileSync(earlyUr.state, 'utf8');
+      const oldApprovals = readApprovalOperations(urBefore).receipts;
+      const oldPresentations = readdirSync(join(root, `.agdf/control/runs/${earlyUr.runId}/presentations`));
+      const urEnvelope = { ...bound(earlyUr), operation_id: urProposal.input.operationId };
+      const urPayload = { source_gate: 'UR', proposal: { path: urProposal.input.evidence,
+        digest: artefactFileDigest(root, urProposal.input.evidence) } };
+      const urPreview = await call({ ...urEnvelope, command: { kind: 'source_revision.preview', payload: urPayload } });
+      assert.equal(urPreview.outcome, 'accepted', JSON.stringify(urPreview));
+      assert.equal(readFileSync(earlyUr.state, 'utf8'), urBefore, 'Preview is read-only.');
+      const urApply = { ...urEnvelope, command: { kind: 'source_revision.apply', payload: { ...urPayload,
+        preview_digest: urPreview.family_result.preview_digest, confirmation: 'Tool permission is not material confirmation.' } } };
+      assert.equal((await call(urApply)).reason, 'confirmation_required');
+      assert.equal(readFileSync(earlyUr.state, 'utf8'), urBefore);
+      urApply.command.payload.confirmation = urPreview.family_result.confirmation_selector;
+      const urResult = await call(urApply);
+      assert.equal(urResult.outcome, 'accepted', JSON.stringify(urResult));
+      assert.equal(urResult.current.gate, 'UR');
+      const urAfter = readFileSync(earlyUr.state, 'utf8');
+      const urReceipts = readSourceRevisions(urAfter).receipts;
+      assert.equal(urReceipts.length, 1);
+      const archive = readValidatedRevisionArchive(root, urReceipts[0]);
+      assert.ok(archive, 'Exact archive remains validated.');
+      assert.deepEqual(readApprovalOperations(urAfter).receipts, oldApprovals, 'Historical decision receipts are preserved.');
+      for (const gate of ['UR', 'PRD', 'SD', 'TP']) assert.equal(earlyUr.control().approvals.get(gate).status, 'missing');
+      assert.equal(earlyUr.control().mode_slice_decision.decision, 'undecided');
+      assert.equal(earlyUr.control().artefacts.get('Brownfield Review').status, 'missing');
+      for (const name of oldPresentations) assert.ok(archive.manifest.files.some(row => row.path.endsWith(`/presentations/${name}`)));
+      for (const type of ['UR', 'PRD', 'SD']) {
+        const archived = archive.manifest.files.find(row => row.path === earlyUr.prefix + type + '.md');
+        assert.deepEqual(readFileSync(join(root, archived.snapshot)), readFileSync(earlyUr.file(type + '.md')));
+      }
+      assert.equal(runSealState(root, urAfter).status, 'valid');
+      const urReplay = await call(urApply);
+      assert.equal(urReplay.outcome, 'already_applied');
+      assert.equal(urReplay.current.gate, 'UR');
+      assert.equal((await call({ ...urApply, presentation_language: 'de' })).reason, 'revision_operation_conflict');
+      const oldApproval = oldApprovals.find(row => row.binding.gate === 'UR');
+      const staleApproval = await client.callTool({ name: 'agdf_approve', arguments: {
+        ...urEnvelope, operation_id: randomUUID(), expected_revision_id: oldApproval.binding.expected_revision_id,
+        command: { kind: 'approval.record', payload: { gate: 'UR', presentation_id: oldApproval.binding.presentation_id, response: 'Approval: UR' } },
+      } });
+      assert.equal(staleApproval.structuredContent.outcome, 'rejected');
+      assert.equal(readFileSync(earlyUr.state, 'utf8'), urAfter, 'Replay/conflict and old approval cannot produce another effect.');
+      if (process.env.AGDF_TEST_EVIDENCE_DIR) writeFileSync(join(process.env.AGDF_TEST_EVIDENCE_DIR, `early-ur-${modern ? 'modern' : 'legacy'}.json`), JSON.stringify({
+        evidence_class: 'actual_generated_stdio_synthetic_disposable_ur_revision', modern,
+        target_id: urEnvelope.target_id, run_id: earlyUr.runId, operation_id: urEnvelope.operation_id,
+        expected_revision_id: urEnvelope.expected_revision_id, preview: urPreview, applied: urResult, replay: urReplay,
+        source_revision_receipt: urReceipts[0], archive_digest: urReceipts[0].archive.digest,
+        archived_presentations: oldPresentations, stale_approval: staleApproval.structuredContent,
+        native_qualified: false, authorizes: false,
+      }, null, 2));
+      console.log('SCN-020/021: actual generated STDIO UR-at-SD preview/apply, explicit confirmation, exact archive, invalidated approvals/analysis, stale approval denial and single replay passed; synthetic decisions only.');
+      console.log('Actual default-entrypoint STDIO early PRD reopening and source preview/apply, explicit confirmation, preserved old state on denial and single historical replay passed; synthetic only.');
+    });
+  } finally { fixture.dispose(); }
+}
diff --git a/packages/mcp-server/test/run-command.test.js b/packages/mcp-server/test/run-command.test.js
