index 00000000..6c8c9d52
--- /dev/null
+++ b/packages/core/lib/control-state/decision-action-contract.js
@@ -0,0 +1,32 @@
+import { strictObject, schemaDiagnostics, RUN_COMMAND_LIMITS, RUN_COMMAND_GROUPS } from './run-command-contract.js';
+import { REVISION_ID_PATTERN } from './run-identity.js';
+import { canonicalJson, digest } from './approval-command-contract.js';
+
+import { DECISION_UI_URI } from '../mcp-resource-contract.js';
+export { DECISION_UI_URI };
+export const DECISION_ACTION_GROUPS = Object.freeze({ approve: 'agdf_approve', request_change: 'agdf_record', reject: 'agdf_record' });
+const uuid = { type: 'string', pattern: REVISION_ID_PATTERN.source };
+export function enabledDecisionActions(groups) {
+  if (!Array.isArray(groups) || new Set(groups).size !== groups.length || groups.some(group => !Object.hasOwn(RUN_COMMAND_GROUPS, group))) throw Error('command_group_unsupported');
+  return Object.keys(DECISION_ACTION_GROUPS).filter(action => groups.includes(DECISION_ACTION_GROUPS[action]));
+}
+export function decisionActionSchema(actions = Object.keys(DECISION_ACTION_GROUPS)) {
+  return strictObject({ session_id: uuid, operation_id: uuid, presentation_id: uuid, expected_revision_id: uuid,
+    action: { enum: actions }, comment: { type: 'string', maxLength: 8192 } }, ['session_id', 'operation_id', 'presentation_id', 'expected_revision_id', 'action']);
+}
+export function validateDecisionAction(input, actions = Object.keys(DECISION_ACTION_GROUPS)) {
+  const errors = schemaDiagnostics(input, decisionActionSchema(actions));
+  if (errors.length) return errors;
+  if (input.action === 'request_change' && !input.comment?.trim()) errors.push({ path: '$.comment', code: 'change_comment_required' });
+  if (/\0/u.test(input.comment ?? '')) errors.push({ path: '$.comment', code: 'comment_invalid' });
+  if (Buffer.byteLength(input.comment ?? '') > 8192 || Buffer.byteLength(canonicalJson(input)) > RUN_COMMAND_LIMITS.input_bytes) errors.push({ path: '$.comment', code: 'comment_budget_exceeded' });
+  return errors;
+}
+export function decisionActionDefinition(groups) {
+  const actions = enabledDecisionActions(groups);
+  if (!actions.length) return null;
+  return Object.freeze({ name: 'agdf_decision_action', description: 'App-only deliberate decision of one immutable presentation. Enabled actions: ' + actions.join(', ') + '. Cooperative UI route; technical tool permission is not a gate decision. Preserve original UUID after uncertainty.',
+    annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false },
+    inputSchema: decisionActionSchema(actions), _meta: { ui: { resourceUri: DECISION_UI_URI, visibility: ['app'] } } });
+}
+export const decisionActionRequestDigest = (binding, input) => digest(`agdf-app-decision/1\0${canonicalJson({ binding, input })}`);
diff --git a/packages/core/lib/control-state/decision-action-service.js b/packages/core/lib/control-state/decision-action-service.js
new file mode 100644
index 00000000..909baa09
--- /dev/null
+++ b/packages/core/lib/control-state/decision-action-service.js
@@ -0,0 +1,55 @@
+import { withLiveControlReads } from '../control-read/fs.js';
+import { evaluateGateCheck } from '../control-evaluation/gate-check.js';
+import { executeApprovalCommand } from './approval-command.js';
+import { recordRunPresentationDecision } from './run-steps.js';
+import { inspectRunOperation } from './run-operation-status.js';
+import { resolveControlCommandTarget, COOPERATIVE_ASSURANCE } from './approval-command-contract.js';
+import { validateDecisionAction, enabledDecisionActions, decisionActionRequestDigest } from './decision-action-contract.js';
+import { RUN_COMMAND_GROUPS, RUN_COMMAND_LIMITS } from './run-command-contract.js';
+import { observeCurrentRunCommand } from './run-command-service.js';
+
+// Private serving composition. Binding is held by the decision-session owner, never
+// accepted as model/App input. Qualification is package/host evidence, not a gesture credential.
+export function createDecisionActionService({ enabledGroups = Object.keys(RUN_COMMAND_GROUPS), appOnlyMediationQualified = false,
+  packageVersion = '0.14.5', checkpoint = () => {} } = {}) {
+  const actions = enabledDecisionActions(enabledGroups);
+  return (root, binding, input) => withLiveControlReads(() => {
+    const diagnostics = validateDecisionAction(input);
+    const result = (outcome, reason, family = {}) => {
+      let observed;
+      try { observed = inspectRunOperation(root, { runId: binding.run_id, operationId: input.operation_id, targetId: binding.target_id }); } catch {}
+      const receipt = family.receipt ?? observed?.receipt ?? null;
+      const response = { schema_version: '1', outcome, reason: reason ?? null, operation_id: input.operation_id ?? null,
+        receipt, historical_effect: Boolean(family.historical_effect || outcome === 'already_applied'),
+        current: observeCurrentRunCommand(root, { ...binding, presentation_language: binding.presentation_language }),
+        assurance: COOPERATIVE_ASSURANCE, input_route: 'app_only_cooperative', authorizes: false,
+        recovery: outcome === 'effect_unknown' ? 'Inspect operation-status using the original UUID. Preserve the exact original submission; do not create another decision.' : null };
+      return Buffer.byteLength(JSON.stringify(response)) <= RUN_COMMAND_LIMITS.result_bytes ? response
+        : { schema_version: '1', outcome: 'effect_unknown', reason: 'command_result_budget_exceeded', operation_id: input.operation_id, authorizes: false };
+    };
+    // Invalid input never reaches a filesystem owner or an observation based on that input.
+    if (diagnostics.length) return { schema_version: '1', outcome: 'rejected', reason: 'decision_schema_invalid', diagnostics, authorizes: false };
+    if (!actions.includes(input.action)) return result('rejected', 'command_group_disabled');
+    if (!appOnlyMediationQualified) return result('rejected', 'app_only_mediation_not_qualified');
+    if (input.presentation_id !== binding.presentation_id || input.expected_revision_id !== binding.expected_revision_id
+      || resolveControlCommandTarget(root).target_id !== binding.target_id) return result('rejected', 'decision_binding_invalid');
+    const requestDigest = decisionActionRequestDigest(binding, input);
+    let dispatched = false;
+    try {
+      checkpoint('before_dispatch'); dispatched = true;
+      const family = input.action === 'approve'
+        ? executeApprovalCommand(root, { schema_version: '1', action: 'record_gate_approval', target_id: binding.target_id, run_id: binding.run_id,
+          expected_revision_id: binding.expected_revision_id, operation_id: input.operation_id, assurance: 'cooperative_local', gate: binding.gate,
+          presentation_id: binding.presentation_id, response: `Approval: ${binding.gate}` }, { evaluateGateCheck, packageVersion, checkpoint,
+          commandContext: { kind: 'approval.record', operation_id: input.operation_id, target_id: binding.target_id, request_digest: requestDigest } })
+        : recordRunPresentationDecision(root, { runId: binding.run_id, gate: binding.gate, revisionId: binding.expected_revision_id,
+          operationId: input.operation_id, presentationId: binding.presentation_id, action: input.action, comment: input.comment ?? '', requestDigest },
+        { evaluateGateCheck, packageVersion, afterWrite: checkpoint });
+      checkpoint('before_result');
+      return result(['accepted', 'recorded'].includes(family.outcome) ? 'accepted' : family.outcome === 'already_applied' ? 'already_applied'
+        : ['retryable_failure', 'recovery_required'].includes(family.outcome) ? 'effect_unknown' : 'rejected', family.reason, family);
+    } catch (error) {
+      return result(dispatched ? 'effect_unknown' : 'rejected', error.message);
+    }
+  });
+}
diff --git a/packages/core/lib/control-state/evidence-bindings.js b/packages/core/lib/control-state/evidence-bindings.js
new file mode 100644
index 00000000..0001cf0f
--- /dev/null
+++ b/packages/core/lib/control-state/evidence-bindings.js
@@ -0,0 +1,97 @@
+import { createHash } from 'node:crypto';
+import { canonicalJson, digest, exactObject, DIGEST_PATTERN, COOPERATIVE_ASSURANCE } from './approval-command-contract.js';
+import { RUN_ID_PATTERN, REVISION_ID_PATTERN } from './run-identity.js';
+import { isSafeControlRelativePath } from './contained-file.js';
+
+export const EVIDENCE_PREREQUISITES = Object.freeze({
+  ur: [], route: ['UR'], 'Brownfield Review': ['UR'], 'UX Intent Definition': ['UR', 'Brownfield Review'],
+  'Brownfield Analysis': ['UR', 'PRD', 'SD', 'TP', 'Brownfield Review', 'UX Intent Definition'],
+  'CD+Tests': ['UR', 'PRD', 'SD', 'TP', 'Brownfield Analysis'],
+  'TP Review': ['UR', 'PRD', 'SD', 'TP', 'CD+Tests'], 'Clean Implementation Review': ['UR', 'PRD', 'SD', 'TP', 'CD+Tests'],
+  CR: ['UR', 'PRD', 'SD', 'TP', 'CD+Tests'], review: ['UR', 'PRD', 'SD', 'TP', 'CD+Tests'], evidence: ['UR', 'PRD', 'SD', 'TP'],
+  QA: ['UR', 'PRD', 'SD', 'TP', 'CD+Tests', 'TP Review', 'Clean Implementation Review', 'CR'], UAT: ['QA'],
+});
+export const evidenceSourceSetDigest = sources => digest(`agdf-operation-sources/1\0${canonicalJson(sources)}`);
+export const canonicalEvidenceDigest = text => 'sha256:' + createHash('sha256').update(String(text).replace(/\r\n?/gu, '\n').replace(/^\uFEFF/u, '')).digest('hex');
+const hash = value => typeof value === 'string' && DIGEST_PATTERN.test(value);
+const ownPath = (value, runId) => isSafeControlRelativePath(value) && value.startsWith(`.agdf/control/artefacts/${runId}/`);
+export function validEvidenceBinding(row) {
+  return exactObject(row, ['schema_version', 'run_id', 'operation_id', 'action', 'step', 'report', 'sources', 'source_set_digest', 'producer', 'assurance'])
+    && row.schema_version === '1' && RUN_ID_PATTERN.test(row.run_id ?? '') && REVISION_ID_PATTERN.test(row.operation_id ?? '')
+    && ['step.record', 'artefact.record'].includes(row.action) && Object.hasOwn(EVIDENCE_PREREQUISITES, row.step)
+    && exactObject(row.report, ['path', 'digest']) && ownPath(row.report.path, row.run_id) && hash(row.report.digest)
+    && Array.isArray(row.sources) && row.sources.length === EVIDENCE_PREREQUISITES[row.step].length
+    && row.sources.every((s, i) => exactObject(s, ['type', 'path', 'digest', 'status']) && s.type === EVIDENCE_PREREQUISITES[row.step][i]
+      && (s.path === '' && s.digest === null || ownPath(s.path, row.run_id) && (hash(s.digest) || s.digest === null))
+      && typeof s.status === 'string' && s.status.length <= 128)
+    && hash(row.source_set_digest) && row.source_set_digest === evidenceSourceSetDigest(row.sources)
+    && exactObject(row.producer, ['contract', 'package_version']) && row.producer.contract === 'run-command/1'
+    && typeof row.producer.package_version === 'string' && row.producer.package_version.length > 0 && row.producer.package_version.length <= 128
+    && canonicalJson(row.assurance) === canonicalJson(COOPERATIVE_ASSURANCE);
+}
+export function readEvidenceBindings(content) {
+  const lines = String(content).replace(/\r\n?/gu, '\n').split('\n');
+  const starts = lines.flatMap((line, i) => /^## Evidence Bindings\s*$/u.test(line) ? [i] : []);
+  const invalid = () => ({ present: true, valid: false, bindings: [] });
+  if (!starts.length) return { present: false, valid: true, bindings: [] };
+  if (starts.length !== 1) return invalid();
+  const start = starts[0]; let end = start + 1;
+  while (end < lines.length && !/^#{1,2} /u.test(lines[end])) end++;
+  const body = lines.slice(start + 1, end).map(line => line.trim()).filter(Boolean);
+  if (body[0] !== '- schema_version: 1' || body[1] !== '| operation_id | binding |' || !/^\|[-:|\s]+\|$/u.test(body[2] ?? '')) return invalid();
+  const bindings = [], ids = new Set();
+  for (const line of body.slice(3)) {
+    const cells = line.match(/^\| ([^|]+) \| ([A-Za-z0-9_-]+) \|$/u);
+    if (!cells || cells[2].length > 32768) return invalid();
+    try {
+      const bytes = Buffer.from(cells[2], 'base64url'), json = new TextDecoder('utf-8', { fatal: true }).decode(bytes), row = JSON.parse(json);
+      if (bytes.toString('base64url') !== cells[2] || canonicalJson(row) !== json || !validEvidenceBinding(row) || row.operation_id !== cells[1] || ids.has(row.operation_id)) return invalid();
+      bindings.push(row); ids.add(row.operation_id);
+    } catch { return invalid(); }
+  }
+  return bindings.length ? { present: true, valid: true, bindings, start, end } : invalid();
+}
+export function appendEvidenceBinding(content, binding) {
+  const before = readEvidenceBindings(content);
+  if (!before.valid || !validEvidenceBinding(binding) || before.bindings.some(row => row.operation_id === binding.operation_id)) throw Error('AGDF_EVIDENCE_BINDINGS_INVALID');
+  const block = ['## Evidence Bindings', '', '- schema_version: 1', '', '| operation_id | binding |', '|---|---|',
+    ...[...before.bindings, binding].map(row => `| ${row.operation_id} | ${Buffer.from(canonicalJson(row)).toString('base64url')} |`), ''];
+  const lines = String(content).split('\n');
+  return before.present ? [...lines.slice(0, before.start), ...block, ...lines.slice(before.end)].join('\n') : `${String(content).trimEnd()}\n\n${block.join('\n')}`;
+}
+export function assertEvidenceBindingsChange(current, candidate, appended) {
+  const before = readEvidenceBindings(current), after = readEvidenceBindings(candidate);
+  if (!before.valid || !after.valid || after.present !== (before.present || Boolean(appended))
+    || canonicalJson(after.bindings) !== canonicalJson(appended ? [...before.bindings, appended] : before.bindings)) throw Error('AGDF_EVIDENCE_BINDINGS_CHANGED');
+}
+
+// The read callback is selected by the common Run-state owner (live, immutable archive,
+// or a transaction overlay). Presence and free claims never establish applicability.
+export function evidenceApplicability(state, readArtefact) {
+  const parsed = readEvidenceBindings(state.content), groups = { current: [], superseded: [], applicability_unknown: [] }, byStep = new Map();
+  const latest = new Map(parsed.bindings.map(row => [row.step, row.operation_id]));
+  if (parsed.valid) for (const row of parsed.bindings) {
+    let reason = 'current_exact_association', group = 'current';
+    try {
+      const current = state.artefacts.get(row.step), bytes = readArtefact(row.report.path);
+      if (typeof bytes !== 'string' || canonicalEvidenceDigest(bytes) !== row.report.digest) { group = 'applicability_unknown'; reason = 'recorded_report_unavailable_or_changed'; }
+      else if (current && (current.path !== row.report.path || !['done', 'approved', 'not_applicable', 'pass', 'revise', 'block'].includes(current.status))) { group = 'superseded'; reason = 'report_registration_superseded'; }
+      else for (const source of row.sources) {
+        const now = state.artefacts.get(source.type), text = source.path ? readArtefact(source.path) : undefined;
+        // An explicit empty dependency is retained as empty, never presented as a report.
+        if (!source.path && !now?.path && source.status === (now?.status ?? 'missing')) continue;
+        if (source.digest === null || typeof text !== 'string') { group = 'applicability_unknown'; reason = 'source_association_unavailable'; break; }
+        if (now?.path !== source.path || now?.status !== source.status || canonicalEvidenceDigest(text) !== source.digest) { group = 'superseded'; reason = 'source_version_superseded'; break; }
+      }
+    } catch { group = 'applicability_unknown'; reason = 'source_observation_unavailable'; }
+    const available = group !== 'applicability_unknown';
+    if (latest.get(row.step) !== row.operation_id) { group = 'superseded'; reason = 'writer_owned_result_superseded'; }
+    const item = { ...row, applicability: group, reason, available };
+    groups[group].push(item); byStep.set(row.step, item);
+  }
+  for (const row of state.evidence_refs ?? []) {
+    const source = String(row.source ?? '').replace(/^`|`$/gu, '');
+    if (!parsed.bindings.some(binding => binding.report.path === source)) groups.applicability_unknown.push({ ...row, applicability: 'applicability_unknown', reason: 'no_writer_owned_association', available: null });
+  }
+  return { valid: parsed.valid, ...groups, by_step: byStep };
+}
diff --git a/packages/core/lib/control-state/presentation-decision.js b/packages/core/lib/control-state/presentation-decision.js
new file mode 100644
index 00000000..65aee8e1
--- /dev/null
+++ b/packages/core/lib/control-state/presentation-decision.js
@@ -0,0 +1,83 @@
+import { readFileSync, statSync } from '../control-read/fs.js';
+import { canonicalJson, digest, DIGEST_PATTERN } from './approval-command-contract.js';
+import { canonicalRunText } from './run-seal.js';
+import { containedRegularFile } from './contained-file.js';
+import { readRunOperations } from './run-operations.js';
+import { readApprovalOperations } from './approval-operations.js';
+import { READ_LIMITS } from '../control-read/snapshot.js';
+
+export const decisionRemediationOwner = gate => ({ UR: 'ur-definition', PRD: 'prd-definition', SD: 'sd-definition', TP: 'gate-check', QA: 'qa-gate', UAT: 'delivery-closeout' })[gate] ?? null;
+const prerequisiteTypes = {
+  UR: ['UR'], PRD: ['UR', 'PRD'],
+  SD: ['UR', 'PRD', 'SD'],
+  TP: ['UR', 'PRD', 'SD', 'TP'],
+  QA: ['UR', 'PRD', 'SD', 'TP', 'Brownfield Analysis', 'CD+Tests', 'TP Review', 'Clean Implementation Review', 'CR', 'QA'],
+  UAT: ['UR', 'PRD', 'SD', 'TP', 'Brownfield Analysis', 'CD+Tests', 'TP Review', 'Clean Implementation Review', 'CR', 'QA'],
+};
+
+// Version is actual material, not a new envelope, recording UUID, Run revision or comment.
+// Archived/proposed state supplies its own byte reader; it cannot adopt current bytes.
+export function decisionMaterial(root, state, gate, { readArtefact } = {}) {
+  const types = prerequisiteTypes[gate];
+  if (!types || !state.run_id) return { available: false, reason: 'decision_material_unavailable' };
+  const sources = [];
+  try {
+    for (const type of types) {
+      const row = state.artefacts.get(type) ?? state.artefacts.get({ CR: 'Code Review', 'Clean Implementation Review': 'Clean Review' }[type]);
+      if (!row?.path) { if (type === gate || gate === 'UAT' && type === 'QA') throw Error(); continue; }
+      let content;
+      if (readArtefact) content = readArtefact(row.path);
+      else { const file = containedRegularFile(root, row.path); if (file.status !== 'valid' || statSync(file.path).size > READ_LIMITS.file) throw Error(); content = readFileSync(file.path, 'utf8'); }
+      if (typeof content !== 'string' || !content.trim() || Buffer.byteLength(content) > READ_LIMITS.file) throw Error();
+      sources.push({ type, path: row.path, digest: digest(canonicalRunText(content)) });
+    }
+    const material = { run_id: state.run_id, gate, sources };
+    return { available: true, ...material, material_version: digest(`agdf-decision-material/1\0${canonicalJson(material)}`) };
+  } catch { return { available: false, reason: 'decision_material_unavailable' }; }
+}
+
+export function validDecisionMaterial(sources, runId) {
+  return Array.isArray(sources) && sources.length > 0 && sources.length <= 12
+    && new Set(sources.map(s => s?.type)).size === sources.length
+    && sources.every(s => s && Object.keys(s).sort().join(',') === 'digest,path,type' && typeof s.type === 'string'
+      && typeof s.path === 'string' && s.path.startsWith(`.agdf/control/artefacts/${runId}/`)
+      && !s.path.includes('..') && DIGEST_PATTERN.test(s.digest ?? ''));
+}
+
+export const decisionMaterialVersion = (runId, gate, sources) => digest(`agdf-decision-material/1\0${canonicalJson({ run_id: runId, gate, sources })}`);
+
+export function projectPresentationDecision(state, gate, material) {
+  if (!material.available) return { available: false, decided: false, reason: material.reason };
+  const internal = readRunOperations(state.content), approvals = readApprovalOperations(state.content);
+  if (!internal.valid || !approvals.valid) return { available: false, decided: false, reason: 'decision_receipts_invalid' };
+  const approval = state.approvals.get(gate), currentPresentation = approval?.evidence?.match(/presentation ([0-9a-f-]{36}) /u)?.[1];
+  const decisions = [
+    ...internal.receipts.filter(r => r.kind === 'presentation_decision.record' && r.effect.record.gate === gate && r.effect.record.material_version === material.material_version)
+      .map(receipt => ({ action: receipt.effect.record.action, receipt, owner: receipt.effect.record.owner })),
+    ...approvals.receipts.filter(r => r.schema_version === '2' && r.binding.gate === gate && r.effect.material_version === material.material_version
+      && approval?.status === 'approved' && r.binding.presentation_id === currentPresentation)
+      .map(receipt => ({ action: 'approve', receipt, owner: null })),
+  ];
+  if (decisions.length > 1) return { available: false, decided: true, reason: 'decision_version_ambiguous', material_version: material.material_version };
+  return { available: true, decided: decisions.length === 1, material_version: material.material_version, sources: material.sources,
+    ...(decisions[0] ?? {}), authorizes: false };
+}
+
+export function presentationDecisionState(root, state, gate, options = {}) {
+  return projectPresentationDecision(state, gate, decisionMaterial(root, state, gate, options));
+}
+
+// Only a positively matched current row/receipt is tested. Legacy approvals are
+// not retrospectively assigned a material/source association they never recorded.
+export function approvedMaterialFindings(state, decisions) {
+  const receipts = readApprovalOperations(state.content).receipts;
+  return [...state.approvals].flatMap(([gate, approval]) => {
+    if (approval.status !== 'approved') return [];
+    const id = approval.evidence?.match(/presentation ([0-9a-f-]{36}) /u)?.[1];
+    const receipt = receipts.find(r => r.schema_version === '2' && r.binding.gate === gate && r.binding.presentation_id === id);
+    if (!receipt) return [];
+    const material = decisions.get(gate);
+    return material?.available && material.material_version === receipt.effect.material_version ? []
+      : [{ gate, reason: 'approved_material_sources_changed', operation_id: receipt.operation_id }];
+  });
+}
