{
  "schema_version": "2",
  "policy_version": 2,
  "target_id": "sha256:a5c1daee7886f81d27b2b7718718fa7a3822b27a4bc1d057f99af01be7688a19",
  "run_id": "mcp-contract-completeness-20261025-01",
  "expected_revision_id": "a2173edf-0bd7-4e9f-a64f-36635326062a",
  "operation_id": "bf7982be-3d0c-4c94-8376-b575da83d1c9",
  "source_gate": "TP",
  "reason": "The direct owner answer in TP_GUARDED_NATIVE_DECISION-01.md accepts configuration C2 after the observed first-session isolation failure; current approved TP's session ceiling and original stop condition require explicit renewal.",
  "intended_change": "Authorize two additional fresh guarded Codex gpt-6.1-sol/low T7 sessions, at most three real invocations in this Run including the immutable failed original; preserve every MCP budget and the exact Copilot baseline, require OS write guard and before/pre-session/after manifests.",
  "sources": [
    {
      "type": "UR",
      "path": ".agdf/control/artefacts/mcp-contract-completeness-20261025-01/UR.md",
      "digest": "sha256:90da41de9d341e20349f682f49b7f23511d869351e71aac699aa8d530860c47a"
    },
    {
