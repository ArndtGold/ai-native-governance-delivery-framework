  "target_id": "sha256:afb31873efa91d892b9046631268d79f1c8cb43aa392c0ef5e4d2fd500293f10",
  "run_id": "mcp-ergonomics-baseline-20261016-01",
  "expected_revision_id": "671c6b67-6d46-42a7-a994-c5037c2bf3a8",
