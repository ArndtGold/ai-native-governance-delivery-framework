{
  "schema_version": "2",
  "policy_version": 2,
  "target_id": "sha256:c84b50389bbc7c3b38eff0d357c083ea0ebc99ccf89057098cadb848edcf7e78",
  "run_id": "run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74",
  "expected_revision_id": "b2e3e06b-810a-46ac-883e-7e9600f394a5",
  "operation_id": "7b0f7046-eb6f-4b50-9eb9-51774586dfe5",
  "source_gate": "PRD",
  "initiating_phase": "TP",
  "reason": "User narrows planned native host tests to Codex CLI; approved PRD/SD currently require actual visible/native Cockpit evidence.",
  "intended_change": "Replace native Desktop/Cockpit qualification with Codex CLI-only native tests, preserving automated UI/browser, Core, migration/recovery and full mandatory CI. Reassess downstream SD/TP evidence wording; retain unchanged UR intent and applicable analytical sources.",
  "sources": [
    {
      "type": "UR",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/UR.md",
      "digest": "sha256:647cd7a6f3a9f224a592a46742a2aa71be469ca9ef164ba8da1429e4123c9415"
    },
    {
      "type": "PRD",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/PRD.md",
      "digest": "sha256:04a6202db0dd5c86d8ee02d5a3ef56c71c49250c327c1b994a80c121931edb33"
    },
    {
      "type": "SD",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/SD.md",
      "digest": "sha256:95082ab16f193ff778cd2c9df869676a84d1e5b065a7c50e2a92a028becb45e1"
    },
    {
      "type": "TP",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/TP.md",
      "digest": "sha256:e3b2063b69464e01a826b085be87d48d19fe920295cdc180b0ca285aa43eb861"
    }
  ],
  "changed_statements": [
    {
      "type": "PRD",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/PRD.md",
      "digest": "sha256:04a6202db0dd5c86d8ee02d5a3ef56c71c49250c327c1b994a80c121931edb33",
      "statement": "- required_evidence: Shared Core projection and adapter parity tests, missing/partial/unsafe/empty cases and actual visible Codex Cockpit observations for applicable behavior.",
      "intended_change": "Limit native host qualification to Codex CLI only (Core-only and optional planning package); retain automated visible Cockpit/UI tests, Core/recovery/migration tests and mandatory CI; do not claim native Desktop qualification.",
      "reason": "Explicit user request: Auch nur Test mit Codex cli einplanen, das dürfte reichen."
    },
    {
      "type": "PRD",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/PRD.md",
      "digest": "sha256:04a6202db0dd5c86d8ee02d5a3ef56c71c49250c327c1b994a80c121931edb33",
      "statement": "| Acceptance and qualification boundary | before_prd | resolved | Require candidate-bound repository/CI and native Codex/visible applicable Cockpit evidence and separate human UAT. No new native planning-host claims beyond Codex or measured performance claims without actual proof. | Arndt Gold |",
      "intended_change": "Limit native host qualification to Codex CLI only (Core-only and optional planning package); retain automated visible Cockpit/UI tests, Core/recovery/migration tests and mandatory CI; do not claim native Desktop qualification.",
      "reason": "Explicit user request: Auch nur Test mit Codex cli einplanen, das dürfte reichen."
    },
    {
      "type": "SD",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/SD.md",
      "digest": "sha256:95082ab16f193ff778cd2c9df869676a84d1e5b065a7c50e2a92a028becb45e1",
      "statement": "Core inventory/adapter contract tests and existing UI/browser/accessibility tests cover mixed states, no-backlog Runs, counts/order, stale selectors, partial/unavailable/empty and recovery. Mandatory native evidence for the initial candidate: actual Codex Core and separate plugin discovery, deliberate planning invocation, delegation to one UR owner, selected-version start, retry/same Run, missing-plugin Core-only behavior and visible applicable Cockpit states. Bind candidate/installed digests, client version and OS; do not substitute package tests for host observations or human UAT.",
      "intended_change": "Limit native host qualification to Codex CLI only (Core-only and optional planning package); retain automated visible Cockpit/UI tests, Core/recovery/migration tests and mandatory CI; do not claim native Desktop qualification.",
      "reason": "Explicit user request: Auch nur Test mit Codex cli einplanen, das dürfte reichen."
    },
    {
      "type": "TP",
      "path": ".agdf/control/artefacts/run-2f333208-b8c4-46cf-ad87-b6cc7ffc4f74/TP.md",
      "digest": "sha256:e3b2063b69464e01a826b085be87d48d19fe920295cdc180b0ca285aa43eb861",
      "statement": "- N-UI (SCN-026): actual Codex Desktop Cockpit on the same candidate and isolated mixed-state dataset. Observe source/draft/Run meaning, partial/stale/transient feedback, retry/refresh and absence of start/approval effects from opening/selection. Reference G-05 for exhaustive component conditions; retain actual visible native observations.",
      "intended_change": "Limit native host qualification to Codex CLI only (Core-only and optional planning package); retain automated visible Cockpit/UI tests, Core/recovery/migration tests and mandatory CI; do not claim native Desktop qualification.",
      "reason": "Explicit user request: Auch nur Test mit Codex cli einplanen, das dürfte reichen."
    }
  ],
  "impact_assessment": {
    "reviewer": "Codex, cooperative exact-source impact review",
    "earliest_source": "PRD",
