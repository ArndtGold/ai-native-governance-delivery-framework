  "target_id": "sha256:a5c1daee7886f81d27b2b7718718fa7a3822b27a4bc1d057f99af01be7688a19",
  "run_id": "run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d",
  "expected_revision_id": "dfc697f6-8a9f-47ba-8269-030f5e76749b",
  "operation_id": "5053d9de-9ec3-4eb6-8d73-414e4f749100",
  "source_gate": "UR",
  "initiating_phase": "TP",
  "reason": "The maintainer specified that click testing is exclusively in the browser.",
  "intended_change": "Restrict click acceptance to the browser for this Run. Retain isolated disposable fixtures, duplicate-start protection and recovery. Distinguish browser observations from native host qualification, which is outside this click-test scope and remains with the linked Run.",
