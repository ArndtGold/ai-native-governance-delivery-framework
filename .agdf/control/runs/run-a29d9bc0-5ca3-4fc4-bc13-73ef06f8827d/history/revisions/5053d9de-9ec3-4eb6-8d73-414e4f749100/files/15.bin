      "digest": "sha256:bb954b17be0203425bc2c10b434b14a2328558c3be74d7a2777f66cfa5bb94d3"
    },
    {
      "type": "SD",
      "path": ".agdf/control/runs/run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d/documents/SD.md",
      "digest": "sha256:95635bc312eb5ae0f2b9c1dd16077e6928d5b9775ad78173097dbb4ea84001d9"
    },
    {
      "type": "TP",
      "path": ".agdf/control/runs/run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d/documents/TP.md",
      "digest": "sha256:6c04a65c0453a943fcff86330dea63de6bd0349886f6fac4d9175185962fd4c8"
    }
  ],
  "changed_statements": [
    {
      "type": "UR",
      "path": ".agdf/control/runs/run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d/documents/UR.md",
      "digest": "sha256:fb0b5006de2a271de4b54a9df8647088880bf532116ff0da860d8e57eb3cae48",
      "statement": "A manual click can then produce evidence about the corresponding real Codex turn and its handoff.",
      "intended_change": "Exercise the Companion with a user gesture in the browser. Record observable handoff behavior in an isolated fixture; a real Desktop turn is outside this click test.",
      "reason": "The maintainer specified that click testing is exclusively in the browser."
    },
    {
      "type": "PRD",
      "path": ".agdf/control/runs/run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d/documents/PRD.md",
      "digest": "sha256:bb954b17be0203425bc2c10b434b14a2328558c3be74d7a2777f66cfa5bb94d3",
      "statement": "Manually click “Run fortsetzen” once in the actual Codex Desktop Companion.",
      "intended_change": "Activate “Run fortsetzen” in a real browser displaying the built Companion with a local fixture host; record actual browser gestures, messages and fixture claims as applicable.",
      "reason": "The maintainer specified that click testing is exclusively in the browser."
    },
    {
      "type": "SD",
      "path": ".agdf/control/runs/run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d/documents/SD.md",
      "digest": "sha256:95635bc312eb5ae0f2b9c1dd16077e6928d5b9775ad78173097dbb4ea84001d9",
      "statement": "A manual click uses the installed Companion's normal message path.",
      "intended_change": "Use a browser-rendered Companion and clearly identify which receiving-host events are simulated. Keep the isolated fixture and shared admission protections.",
      "reason": "The maintainer specified that click testing is exclusively in the browser."
    },
    {
      "type": "TP",
      "path": ".agdf/control/runs/run-a29d9bc0-5ca3-4fc4-bc13-73ef06f8827d/documents/TP.md",
      "digest": "sha256:6c04a65c0453a943fcff86330dea63de6bd0349886f6fac4d9175185962fd4c8",
      "statement": "Click once on a ready fixture in the installed side panel with no timing checkpoint.",
      "intended_change": "Click the control inside the browser fixture. Exercise pending, reopen and contention in browser views where supported. Report any missing host-specific evidence separately.",
      "reason": "The maintainer specified that click testing is exclusively in the browser."
    }
  ],
  "impact_assessment": {
    "reviewer": "Codex",
    "earliest_source": "UR",
    "upstream": [],
