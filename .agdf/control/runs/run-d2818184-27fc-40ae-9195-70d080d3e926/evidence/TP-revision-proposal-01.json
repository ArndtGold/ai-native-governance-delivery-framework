  "changed_statements": [
    {
      "type": "TP",
      "path": ".agdf/control/runs/run-d2818184-27fc-40ae-9195-70d080d3e926/documents/TP.md",
      "digest": "sha256:fed031ff19c38edaba33e0c63cf8a8090b2792e406b439390842345681b14780",
      "statement": "Local runtime command `run-view` beside `project-state`, flags `--dir`, `--json`, `--language`,",
      "intended_change": "The command also accepts an optional repeatable `--run ID` selector that evaluates the named runs in full (readRunView runIds).",
      "reason": "T-003 finding: SCN-002 expects status card fields for F01 to F13, but T-002 summarizes terminal runs (F06, F07) and an unsupported layout lists no runs (F09); owner chose an optional --run selector"
    },
    {
      "type": "TP",
      "path": ".agdf/control/runs/run-d2818184-27fc-40ae-9195-70d080d3e926/documents/TP.md",
      "digest": "sha256:fed031ff19c38edaba33e0c63cf8a8090b2792e406b439390842345681b14780",
      "statement": "The JSON printed by the spawned `run-view` command equals the status card fields for F01 to F13",
      "intended_change": "SCN-002 spawns the command with `--run` for the fixture run, so completed runs and runs behind an unsupported layout are compared too.",
      "reason": "T-003 finding: SCN-002 expects status card fields for F01 to F13, but T-002 summarizes terminal runs (F06, F07) and an unsupported layout lists no runs (F09); owner chose an optional --run selector"
    },
    {
      "type": "TP",
      "path": ".agdf/control/runs/run-d2818184-27fc-40ae-9195-70d080d3e926/documents/TP.md",
      "digest": "sha256:fed031ff19c38edaba33e0c63cf8a8090b2792e406b439390842345681b14780",
      "statement": "Add the read-only local command `run-view --dir ROOT --json --language TAG`",
      "intended_change": "T-003 adds the optional `--run ID` selector.",
      "reason": "T-003 finding: SCN-002 expects status card fields for F01 to F13, but T-002 summarizes terminal runs (F06, F07) and an unsupported layout lists no runs (F09); owner chose an optional --run selector"
    }
  ],
