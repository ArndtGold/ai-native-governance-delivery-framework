# Keep LF in every checkout; byte-exact contracts, digests and control state depend on it.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.key binary
*.xcf binary
*.woff binary
*.woff2 binary
*.tgz binary

# Imported native references bind original bytes, including Windows log line endings.
evals/host-compatibility/native/** -text

.agdf/control/AGDF_RUN.md merge=union
