  "files": [
    "bin",
    "lib",
    "generated/.agdf",
    "generated/.agents",
    "generated/.opencode",
    "generated/opencode.json",
    "generated/plugins/agdf",
    "generated/plugins/copilot/agdf",
    "generated/submissions/openai/agdf",
    "opencode-plugin.js",
    "README.md",
    "NOTICE"
  ],
  "exports": {
    ".": "./opencode-plugin.js",
    "./cli": "./bin/create-agdf.js",
    "./mcp-dispatch-runtime": "./lib/mcp-dispatch-runtime.js",
    "./opencode-plugin": "./opencode-plugin.js"
  },
