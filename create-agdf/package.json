    "test:package-contents": "node ./scripts/package-contents-test.js",
    "test:package-build": "node ./scripts/package-build-test.js",
    "test:lifecycle": "node ./scripts/lifecycle-test.js",
    "test:copilot-repository-retention": "node ./scripts/copilot-repository-retention-test.js",
    "test:control-state": "node ./scripts/control-state-test.js",
    "test:parent-reconciliation": "node ./scripts/parent-reconciliation-test.js",
