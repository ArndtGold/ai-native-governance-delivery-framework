    "test:runtime-check-consent": "node ./scripts/runtime-check-consent-test.js",
    "test:cli-modularization": "node ./scripts/cli-modularization-test.js",
    "test:local-validator": "node ./scripts/local-validator-test.js",
    "test:local-marketplace": "node ./scripts/local-marketplace-test.js",
    "test:claude-cache-recovery": "node ./scripts/claude-cache-recovery-test.js",
