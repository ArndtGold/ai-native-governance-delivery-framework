{
  "name": "create-agdf",
  "version": "0.9.7",
  "description": "Bootstrap AGDF repository-local plugin files, Copilot/OpenCode instructions, skills, control files and machine-readable checks.",
  "type": "module",
  "files": [
    "bin",
    "lib",
    "generated",
    "opencode-plugin.js",
    "README.md",
    "NOTICE"
  ],
  "exports": {
    ".": "./opencode-plugin.js",
    "./cli": "./bin/create-agdf.js",
    "./opencode-plugin": "./opencode-plugin.js"
  },
  "bin": {
    "create-agdf": "./bin/create-agdf.js"
  },
  "scripts": {
    "sync-package-assets": "node ./scripts/sync-package-assets.js",
    "test:delivery-path-search": "node ./scripts/delivery-path-search-test.js",
    "test:delivery-path-search-unit": "node ./scripts/delivery-path-search-unit-test.js",
    "test:delivery-path-search-generator": "node ./scripts/delivery-path-search-generator-test.js",
    "test:cli-modularization": "node ./scripts/cli-modularization-test.js",
    "test:lifecycle": "node ./scripts/lifecycle-test.js",
    "test:control-state": "node ./scripts/control-state-test.js",
    "test:interaction-presentation": "node ./scripts/interaction-presentation-test.js",
    "test:verified-change": "node ./scripts/verified-change-test.js",
    "test:runtime-integrity-layout": "node ./scripts/runtime-integrity-layout-test.js",
    "test:runtime-integrity-negative": "node ./scripts/runtime-integrity-negative-test.js",
    "test:skill-evals": "node ./scripts/skill-evals-test.js",
    "eval:skills": "node ./scripts/run-skill-evals.js",
    "eval:skills:record": "node ./scripts/record-skill-evals.js",
    "test:release-bootstrap": "node ./scripts/release-bootstrap-smoke-test.js",
    "test:routing": "npm run sync-package-assets && node ./scripts/test-routing.js",
    "smoke-test": "npm run sync-package-assets && npm run test:cli-modularization && npm run test:lifecycle && npm run test:control-state && npm run test:interaction-presentation && npm run test:verified-change && npm run test:runtime-integrity-layout && npm run test:runtime-integrity-negative && npm run test:skill-evals && npm run eval:skills && npm run test:delivery-path-search && npm run test:delivery-path-search-unit && npm run test:delivery-path-search-generator && node ./scripts/smoke-test.js && node ./scripts/test-routing.js",
    "prepack": "npm run sync-package-assets"
  },
  "keywords": [
    "agdf",
    "copilot",
    "claude-code",
    "codex",
    "opencode",
    "control",
    "scaffold",
    "bootstrap"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArndtGold/ai-native-governance-delivery-framework.git",
    "directory": "create-agdf"
  },
  "homepage": "https://github.com/ArndtGold/ai-native-governance-delivery-framework/tree/main/create-agdf"
}
