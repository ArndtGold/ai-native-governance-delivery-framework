    "test:instruction-footprint": "node ./scripts/instruction-footprint-test.js",
    "test:request-activation": "npm run test:instruction-footprint && node ./scripts/request-activation-test.js && node ./scripts/request-activation-evals-test.js && npm run test:request-activation-callbacks && npm run test:request-activation-host-schema",
    "test:gate-check-missing-control": "node ./scripts/gate-check-missing-control-test.js",
