digraph context {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.3, nodesep=0.65, ranksep=0.7, fontname="Helvetica", label="01  /  WO AGDF SITZT", labelloc=t, labeljust=l, fontsize=22, fontcolor="#17324D"];
  node [shape=box, style="rounded,filled", color="#97A6B3", fillcolor="#F3F6F8", fontname="Helvetica", fontsize=17, margin="0.22,0.16", penwidth=1.3];
  edge [color="#52667A", arrowsize=0.8, fontname="Helvetica", fontsize=13, fontcolor="#354D61"];
  human [label="Mensch\nZiel, Scope, Freigaben"];
  host [label="Agent im Host\nCodex · Claude · Copilot · OpenCode", fillcolor="#EEE9FF", color="#8270AE"];
  subgraph cluster_agdf {
    label="AGDF  /  logische Systemgrenze"; labelloc=b; fontsize=15; color="#2D8B7B"; style=rounded; margin=22;
    skills [label="Verträge und Skills\nAnweisungen für den Agenten", fillcolor="#FFF2CF", color="#BF9840"];
    checks [label="Lokale AGDF-Prüfungen\nZiel · Run · Gate · Darstellung", fillcolor="#DDF4EE", color="#2D8B7B"];
    adapter [label="Host-Anbindung\nInstallation und Laufzeitaufrufe", fillcolor="#EEE9FF", color="#8270AE"];
    skills -> checks [style=invis];
    checks -> adapter [style=invis];
  }
  tools [label="Host-Werkzeuge\nDateien · Prozesse · Git · Tests", fillcolor="#EEE9FF", color="#8270AE"];
  code [label="Zielprojekt\nCode und Arbeitsergebnisse", fillcolor="#E5F0FC", color="#5284AD"];
  state [label="Projekt-Kontrollzustand\n.agdf/control/", fillcolor="#E5F0FC", color="#5284AD"];
  human -> host [label="beauftragt / entscheidet"];
  host -> skills [label="liest"];
  host -> checks [label="ruft auf"];
  adapter -> host [label="bindet an", constraint=false];
  host -> tools [label="führt Arbeit aus"];
  tools -> code [label="liest / ändert"];
  tools -> state [label="pflegt Run und Artefakte"];
  checks -> state [label="liest und validiert"];
  {rank=same; host; skills;}
  {rank=same; tools; checks;}
  {rank=same; code; state; adapter;}
}
