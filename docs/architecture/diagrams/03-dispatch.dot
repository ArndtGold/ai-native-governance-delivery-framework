digraph dispatch {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.48, fontname="Helvetica", label="03  /  DISPATCH, RUN-ZUORDNUNG UND FORTSETZUNG", labelloc=t, labeljust=l, fontsize=22, fontcolor="#17324D"];
  node [shape=box, style="rounded,filled", color="#2D8B7B", fillcolor="#DDF4EE", fontname="Helvetica", fontsize=14, margin="0.19,0.12", penwidth=1.3];
  edge [color="#52667A", arrowsize=0.75, fontname="Helvetica", fontsize=11, fontcolor="#354D61"];

  request [label="Aktueller Nutzerwunsch", fillcolor="#F3F6F8", color="#97A6B3"];
  activation [label="Agent: Anwendbarkeit beurteilen\nRequest-Activation-Vertrag", fillcolor="#FFF2CF", color="#BF9840"];
  normal [label="Normale Hilfe / Opt-out / Klärung\nkein anfragebedingter Dispatch", fillcolor="#F3F6F8", color="#97A6B3"];
  skill [label="Skill-Weg\ngeprüfte Runtime-Bindung", fillcolor="#EEE7FC", color="#8268AF"];
  mcp [label="MCP-Weg\ntools/list · tools/call", fillcolor="#EEE7FC", color="#8268AF"];
  inspect [label="agdf_inspect: eigener lesender Service\ngemeinsame Kontrollevaluatoren"];
  inspect_result [label="Inspect-Ergebnis\nkeine Delivery-Fortsetzung", fillcolor="#E5F0FC", color="#5284AD"];
  contract [label="Kanonischer agdf_dispatch-Vertrag\nEingabe · Ausgabe · Host-Aktion", fillcolor="#FFF2CF", color="#BF9840"];
  continuation [label="Core-Fortsetzungsorchestrierung\nRouting aufrufen · Ergebnis vor Ausgabe prüfen"];
  dispatcher [label="Lesender Dispatcher: Eingabe validieren\nGovernance-Ziel binden · Route liefern"];
  assignment [label="Run-Zuordnungsbelege liefern\nresolve_delivery_run\nnoch keine einzelne Gate-Auswertung"];
  scope [label="Agent: vollständige URs vergleichen\neindeutig: neuer / bestehender Run\nmehrdeutig: fachliche Frage", fillcolor="#EEE7FC", color="#8268AF"];
  evaluation [label="Gemeinsamer Gate-Evaluator\naktueller Zustand · nächste Operation"];
  correction [label="Orchestrierung: nur validierte gebundene Fortsetzung:\neine fehlende Beziehung + exakter versiegelter Beleg\nCore-Writer prüft unter Lock, ergänzt Zeile + Audit", fillcolor="#FFF2CF", color="#BF9840"];
  reevaluation [label="Orchestrierung nach bestätigter Korrektur:\nlesendes Routing mit frischer Gate-Auswertung\nFreigaben und zulässiger Umfang unverändert"];
  recovery [label="Terminal: Befund / Recovery\nungültige Eingabe, offenes Ziel, Integritäts-\noder Auswertungsfehler", fillcolor="#FCE8E4", color="#B5675A"];
  terminal [label="Terminal: control_result\nkanonischen Text unverändert zeigen\nund diesen Aufruf beenden", fillcolor="#E5F0FC", color="#5284AD"];
  work [label="Dispatcher: begrenzten Auftrag liefern\nrun_missing / ur_missing oder Skill\nBrownfield · Gate-Artefakt · Umsetzung · QA · OR"];
  implementation [label="implementation: bereits erlaubte CD+Tests\nKontrollen, Tests und Evidenz bleiben Pflicht\nRoutine ohne zusätzliche Statuskarte", fillcolor="#EEE7FC", color="#8268AF"];
  execute [label="Agent: gelieferte Schritte / Skill ausführen\nSchreibschritte über separate kanonische Writer\nkeine Freigabe daraus ableiten", fillcolor="#EEE7FC", color="#8268AF"];
  presentation [label="Dispatcher: presentation_required\nlesende Vorschau + run-present-Schritt"];
  present [label="Agent: run-present aufrufen\nWriter bindet Präsentation an Run / Gate / Revision\nzurückgegebenen Text unverändert zeigen", fillcolor="#E5F0FC", color="#5284AD"];
  wait [label="STOP: neue bewusste Antwort abwarten\nMensch entscheidet\nFreigabe ist ein separater Vorgang", fillcolor="#F3F6F8", color="#97A6B3"];
  redispatch [label="Agent: erneut denselben Dispatcher aufrufen\naktuelle Bindung / vom Writer gelieferte Revision\nnur wie im Fortsetzungsvertrag vorgesehen", fillcolor="#EEE7FC", color="#8268AF"];
  note [label="Jedes Dispatcher-Ergebnis: authorizes = false\nDispatcher bleibt lesend; Fortsetzungsorchestrierung koordiniert höchstens eine belegte Korrektur.\nInspect und expliziter Status bleiben lesend; Entscheidungen und Blocker bleiben sichtbar.", shape=plaintext, fillcolor="white", fontcolor="#354D61", fontsize=13];

  request -> activation;
  activation -> normal [label="kein Dispatch"];
  activation -> skill [label="Skill-Weg"];
  activation -> mcp [label="MCP-Weg"];
  skill -> contract;
  mcp -> contract [label="agdf_dispatch"];
  mcp -> inspect [label="agdf_inspect"];
  inspect -> inspect_result;
  contract -> continuation;
  continuation -> dispatcher;
  dispatcher -> recovery [label="Fehler / Ziel offen"];
  dispatcher -> assignment [label="Intake: Run offen\noder Revision veraltet"];
  dispatcher -> evaluation [label="Bindung für Auswertung vorhanden"];
  assignment -> scope;
  assignment -> recovery [label="Bestand ungültig", style=dashed, constraint=false];
  scope -> redispatch [label="eindeutig zugeordnet", tailport=s, headport=w];
  evaluation -> recovery [label="Fehler", style=dashed, constraint=false];
  evaluation -> correction [label="interne Route: Beziehung fehlt\n+ beauftragte gebundene Fortsetzung"];
  correction -> reevaluation [label="Commit bestätigt"];
  correction -> terminal [label="nicht geeignet / abgelehnt", style=dashed, constraint=false];
  correction -> recovery [label="Commit unbestätigt / Fehler", style=dashed, constraint=false];
  evaluation -> terminal [label="Kontrollanzeige / Halt"];
  evaluation -> work [label="zulässige Fortsetzung"];
  evaluation -> presentation [label="Gate entscheidungsbereit\n+ Intake / Fortsetzung"];
  reevaluation -> terminal [label="Status / Halt"];
  reevaluation -> work [label="zulässige Fortsetzung"];
  reevaluation -> presentation [label="Gate entscheidungsbereit"];
  work -> implementation [label="Phase implementation"];
  implementation -> execute;
  work -> execute [label="andere Fortsetzung"];
  execute -> redispatch [label="wenn Vertrag erneute Prüfung verlangt"];
  presentation -> present;
  present -> wait;
  redispatch -> continuation [style=dashed, constraint=false, label="neuer Aufruf"];
  terminal -> note [style=invis];
  redispatch -> note [style=invis];
  wait -> note [style=invis];

  {rank=same; normal; skill; mcp;}
  {rank=same; contract; inspect;}
  {rank=same; assignment; evaluation; recovery;}
  {rank=same; scope; correction;}
  {rank=same; terminal; work; presentation;}
  {rank=same; execute; present;}
  {rank=same; redispatch; wait;}
}
