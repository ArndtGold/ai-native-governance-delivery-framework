digraph dispatch {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.48, fontname="Helvetica", label="03  /  EIN BENANNTER SKILL-AUFRUF", labelloc=t, labeljust=l, fontsize=22, fontcolor="#17324D"];
  node [shape=box, style="rounded,filled", color="#2D8B7B", fillcolor="#DDF4EE", fontname="Helvetica", fontsize=16, margin="0.22,0.13", penwidth=1.3];
  edge [color="#52667A", arrowsize=0.8, fontname="Helvetica", fontsize=12, fontcolor="#354D61"];
  request [label="Aktueller Nutzerwunsch", fillcolor="#F3F6F8", color="#97A6B3"];
  activation [label="Agent bewertet Anwendbarkeit\nnach Request-Activation-Vertrag", fillcolor="#FFF2CF", color="#BF9840"];
  abstain [label="Normale Hilfe oder Klärung\nKein AGDF-Dispatch", fillcolor="#F3F6F8", color="#97A6B3"];
  binding [label="Vorhandene geprüfte Bindung\nProgramm · Validator · Version · Host"];
  input [label="Dispatcher prüft die Eingabe\nund löst das Ziel auf"];
  evaluation [label="Gemeinsame Gate-Auswertung\nfür das gebundene Ziel und den Run"];
  result [label="Art des Skills?", shape=diamond, style=filled, fontsize=14, margin=0.13];
  control [label="Deterministischer Kontroll-Skill\nDarstellung unverändert übertragen\nund diesen Aufruf beenden", fillcolor="#E5F0FC", color="#5284AD"];
  continuation [label="Fortzusetzender Skill\nBenannten Skill am Ziel ausführen\nKontrollsnapshot und Skill-Regeln beachten", fillcolor="#E5F0FC", color="#5284AD"];
  recovery [label="Anhalten und Recovery zeigen\nUngültige Eingabe, ungeklärtes Ziel\noder Evaluatorfehler", fillcolor="#FCE8E4", color="#B5675A"];
  note [label="Alle Dispatcher-Ergebnisse: authorizes = false\nDie Fortsetzung erteilt keine Gate-Freigabe.", shape=plaintext, fillcolor="white", fontcolor="#354D61", fontsize=14];
  request -> activation;
  activation -> abstain [label="nicht anwendbar / unklar"];
  activation -> binding [label="anwendbar"];
  binding -> input [label="gebundener Aufruf"];
  input -> evaluation [label="Ziel aufgelöst"];
  input -> recovery [label="Fehler / Ziel offen"];
  evaluation -> recovery [label="Auswertungsfehler"];
  evaluation -> result;
  result -> control [label="Kontrollergebnis"];
  result -> continuation [label="Fortsetzung"];
  control -> note [style=invis];
  continuation -> note [style=invis];
  {rank=same; activation; abstain;}
  {rank=same; evaluation; recovery;}
  {rank=same; control; continuation;}
}
