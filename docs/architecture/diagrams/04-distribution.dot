digraph distribution {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.65, ranksep=0.7, fontname="Helvetica", label="04  /  VOM QUELLSTAND ZUR SITZUNG", labelloc=t, labeljust=l, fontsize=22, fontcolor="#17324D"];
  node [shape=box, style="rounded,filled", color="#2D8B7B", fillcolor="#DDF4EE", fontname="Helvetica", fontsize=17, margin="0.22,0.16", penwidth=1.3];
  edge [color="#52667A", arrowsize=0.8, fontname="Helvetica", fontsize=13, fontcolor="#354D61"];
  source [label="1  Kanonische Quellen\nplugin/ und create-agdf/", fillcolor="#FFF2CF", color="#BF9840"];
  generated [label="2  Erzeugtes Payload\nProfil · Manifest · Runtime"];
  package [label="3  Verteilbares Paket\nLokal gebaut oder veröffentlicht"];
  installed [label="4  Host-Installation\nStaging · Registrierung · Cache", fillcolor="#EEE9FF", color="#8270AE"];
  loaded [label="5  Geladene Sitzung\nTatsächlich verwendeter Inhalt", fillcolor="#EEE9FF", color="#8270AE"];
  observed [label="6  Native Beobachtung\nIdentität und Verhalten belegen", fillcolor="#E5F0FC", color="#5284AD"];
  warning [label="Gleiche Versionsnummer allein genügt nicht.\nInstallation und aktive Sitzung getrennt prüfen.", shape=plaintext, fillcolor="white", fontcolor="#354D61", fontsize=15];
  source -> generated [label="erzeugen"];
  generated -> package [label="packen"];
  package -> installed [label="Host-Adapter"];
  installed -> loaded [label="laden / neu starten"];
  loaded -> observed [label="beobachten"];
  source -> package [style=invis, weight=50];
  package -> loaded [style=invis, weight=50];
  generated -> installed [style=invis, weight=50];
  installed -> observed [style=invis, weight=50];
  observed -> warning [style=invis];
  loaded -> warning [style=invis];
  {rank=same; source; generated;}
  {rank=same; package; installed;}
  {rank=same; loaded; observed;}
}
