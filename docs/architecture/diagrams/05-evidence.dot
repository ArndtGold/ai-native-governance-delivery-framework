digraph evidence {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.58, fontname="Helvetica", label="05  /  DREI TECHNISCHE NACHWEISSPUREN", labelloc=t, labeljust=l, fontsize=22, fontcolor="#17324D"];
  node [shape=box, style="rounded,filled", color="#5284AD", fillcolor="#E5F0FC", fontname="Helvetica", fontsize=14, margin="0.19,0.14", penwidth=1.3];
  edge [color="#52667A", arrowsize=0.75, fontname="Helvetica", fontsize=11, fontcolor="#354D61"];

  repository [label="Repository- und Fixture-Tests\nVerträge · Parser · Transaktion · Paket"];
  protocol [label="Kontrollierter MCP-Client\nProtokoll · tools/list · tools/call"];
  host [label="Direkter Host\nexakte Version · Variante · OS · Scope", fillcolor="#EEE9FF", color="#8270AE"];

  repo_claim [label="Implementierung verhält sich\nim geprüften Szenario korrekt"];
  protocol_claim [label="Produktionsserver verarbeitet\ndie geprüfte Protokollgeneration"];
  host_record [label="Host-Tupel\nDiscovery · Dispatch · Fehler · Cleanup"];
  complete [label="Pflichttupel vollständig?", shape=diamond, style=filled, fontsize=13, margin=0.12];
  qualified [label="Begrenzte Unterstützungszusage\nnur für dieses exakte Tupel", fillcolor="#DDF4EE", color="#2D8B7B"];
  unverified [label="unverified\nfehlende Felder und Grenzen nennen", fillcolor="#FCE8E4", color="#B5675A"];
  uat [label="Menschliche UAT\nVerständlichkeit und erwartbarer Ablauf", fillcolor="#FFF2CF", color="#BF9840"];
  boundary [label="Keine Spur ersetzt eine andere.\nEin grüner Test, eine Registrierung oder UAT erteilt keine technische Host-Qualifikation und keine Gate-Freigabe.", shape=plaintext, fillcolor="white", fontcolor="#354D61", fontsize=13];

  repository -> repo_claim;
  protocol -> protocol_claim;
  host -> host_record;
  host_record -> complete;
  complete -> qualified [label="ja"];
  complete -> unverified [label="nein"];
  repo_claim -> qualified [label="ergänzt", style=dashed];
  protocol_claim -> qualified [label="ergänzt", style=dashed];
  uat -> boundary [style=invis];
  qualified -> boundary [style=invis];
  unverified -> boundary [style=invis];

  {rank=same; repository; protocol; host;}
  {rank=same; repo_claim; protocol_claim; host_record;}
  {rank=same; qualified; unverified; uat;}
}
