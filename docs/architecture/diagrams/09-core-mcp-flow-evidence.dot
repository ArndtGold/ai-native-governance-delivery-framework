digraph core_mcp_flow_evidence {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.6, fontname="Helvetica", label="09  /  NACHWEISLAGE DES CORE-/MCP-ABLAUFS\nDokumentationssnapshot: 12. Oktober 2026 · Run-Revision 80", labelloc=t, labeljust=l, fontsize=20, fontcolor="#17324D"];
  node [shape=box, style="rounded,filled", color="#5284AD", fillcolor="#E5F0FC", fontname="Helvetica", fontsize=14, margin="0.19,0.14", penwidth=1.3];
  edge [color="#52667A", arrowsize=0.75, fontname="Helvetica", fontsize=11, fontcolor="#354D61"];

  subgraph cluster_observed {
    label="DOKUMENTIERTE NACHWEISE · JEWEILS MIT EIGENEM UMFANG";
    fontname="Helvetica"; fontsize=13; fontcolor="#354D61"; color="#D1DCE5"; style="rounded"; margin=18;
    source [label="Repository-Implementierung\nGemeinsame Core-Dienste und Writer\nFünf begrenzte Befehlsgruppen", fillcolor="#DDF4EE", color="#2D8B7B"];
    stdio [label="Transport-, Prozess- und Core-Prüfungen\nHistorisch: 96 STDIO-Fälle · sechs Gates · de/en\nExakte Baseline: sieben Core-Ablaufgruppen"];
    native [label="Kandidatgebundene Bedienfälle\nDeutsch: SD-/TP-Freigabe und Fortsetzung\niPad-Chat: Lesen, Diskussion, SD-Freigabe", fillcolor="#EEE9FF", color="#8270AE"];
    source_scope [label="Belegt Aufbau und geprüfte Semantik\nQuelle allein belegt kein Host-Verhalten"];
    stdio_scope [label="Jeweils an eigene Testfassung gebunden\n96 Fälle: explizites Schließen; Run unverändert\nSDK-/Prozess- und Browsertests sind kein nativer Bediennachweis"];
    native_scope [label="Nutzerberichte, Aufrufe und exakte Belege\nNative Freigabe mit automatischer Stilllegung\niPad berichtet; keine Gesamtqualifizierung", fillcolor="#EEE9FF", color="#8270AE"];
    source -> source_scope;
    stdio -> stdio_scope;
    native -> native_scope;
    {rank=same; source; stdio; native;}
    {rank=same; source_scope; stdio_scope; native_scope;}
  }

  binding [label="Gültigkeit jedes Nachweises prüfen\nKandidat / Host / Material / Revision / tatsächlich beobachteter Fall\nEinzelbelege ersetzen keine vollständige Abnahme", fillcolor="#FFF2CF", color="#BF9840"];
  source_scope -> binding [style=dashed];
  stdio_scope -> binding [style=dashed];
  native_scope -> binding [style=dashed];

  subgraph cluster_open {
    label="GESAMTABNAHME OFFEN · KEINE QA-/UAT-FREIGABE";
    labelloc=b; fontname="Helvetica"; fontsize=13; fontcolor="#354D61"; color="#BF9840"; style="rounded"; margin=18;
    final_native [label="Vollständige Host-Qualifizierung\nGate-/Sprachmatrix und weitere iPad-Flächen\nBerechtigungsverweigerung, unentschiedenes Schließen\nEigene Close-Queue-Lücke ebenfalls offen", fillcolor="#FFF2CF", color="#BF9840"];
    comparison [label="Modell-/Host-Vergleich offen\nDeterministischer Core-Vergleich erfüllt\nSuch-/Dialogmetriken und Modellnutzen ungemessen", fillcolor="#FFF2CF", color="#BF9840"];
    run [label="Formaler Run-Abschluss\nRevision 80: Reviews erfasst; QA revise\nQA-Freigabe, UAT und OR offen", fillcolor="#FFF2CF", color="#BF9840"];
    {rank=same; final_native; comparison; run;}
  }
  binding -> final_native;
  binding -> comparison;
  binding -> run;

  note [label="Die Grafik ordnet gespeicherte Nachweise ein und ist selbst kein Abnahmebeleg.\nQuelle: core-mcp-flow-coherence-20261010-01 · ältere Belege bleiben an ihre geprüfte Fassung gebunden.", shape=plaintext, fillcolor="white", fontcolor="#354D61", fontsize=13];
  final_native -> note [style=invis];
  comparison -> note [style=invis];
  run -> note [style=invis];
}
