{
  "schema_version": "1",
  "matrix_version": "v1.2",
  "executions_per_call": 5,
  "notes": "Placeholders ${name} resolve per fixture at run time; envelope adds the bound command envelope. Every execution starts from the restored fixture snapshot.",
  "calls": [
    { "id": "D-VALID-STATUS", "tool": "agdf_dispatch", "call_class": "valid", "fixture": "F2",
      "args": { "skill_id": "gate-check", "presentation_language": "de", "working_directory": "${root}", "target_source": "explicit_target", "primary_target": "${root}", "run_id": "${run_id}" } },
    { "id": "D-SCHEMA-UNKNOWN-PROPERTY", "tool": "agdf_dispatch", "call_class": "schema_invalid", "fixture": "F2",
      "args": { "skill_id": "gate-check", "presentation_language": "de", "working_directory": "${root}", "unknown_field": true } },
    { "id": "D-SEM-RELATIVE-DIRECTORY", "tool": "agdf_dispatch", "call_class": "semantic_failure", "fixture": "F2",
      "args": { "skill_id": "gate-check", "presentation_language": "de", "working_directory": "relative/dir" } },
    { "id": "D-SEM-UNRESOLVED-TARGET", "tool": "agdf_dispatch", "call_class": "semantic_failure", "fixture": "F2",
      "args": { "skill_id": "gate-check", "presentation_language": "de", "working_directory": "${scratch}" } },
    { "id": "I-VALID-DOCTOR", "tool": "agdf_inspect", "call_class": "valid", "fixture": "F2",
      "args": { "operation": "doctor", "presentation_language": "de", "working_directory": "${root}", "target_source": "explicit_target", "primary_target": "${root}", "run_id": "${run_id}" } },
    { "id": "I-VALID-STATUS-CARD", "tool": "agdf_inspect", "call_class": "valid", "fixture": "F2",
      "args": { "operation": "gate-check", "variant": "status-card", "presentation_language": "de", "working_directory": "${root}", "target_source": "explicit_target", "primary_target": "${root}", "run_id": "${run_id}" } },
    { "id": "I-VALID-DOCUMENT-PAGES", "tool": "agdf_inspect", "call_class": "valid", "fixture": "F4", "iterate": "cursor",
      "args": { "operation": "presentation-document", "presentation_language": "de", "working_directory": "${root}", "target_source": "explicit_target", "primary_target": "${root}", "run_id": "${run_id}", "expected_revision_id": "${revision}", "gate": "UR", "presentation_id": "${presentation_id}", "target_id": "${target_id}" } },
    { "id": "I-SCHEMA-UNKNOWN-OPERATION", "tool": "agdf_inspect", "call_class": "schema_invalid", "fixture": "F2",
      "args": { "operation": "unknown-operation", "presentation_language": "de", "working_directory": "${root}" } },
    { "id": "I-SEM-UNKNOWN-RUN", "tool": "agdf_inspect", "call_class": "semantic_failure", "fixture": "F2",
      "args": { "operation": "gate-check", "presentation_language": "de", "working_directory": "${root}", "target_source": "explicit_target", "primary_target": "${root}", "run_id": "missing-run-01" } },
    { "id": "J-VALID-AUTHORED-OBSERVATION", "tool": "agdf_project", "call_class": "valid", "fixture": "F2", "envelope": true,
      "omit": ["run_id", "expected_revision_id"],
      "args": { "command": { "kind": "project.initialize", "payload": {} } } },
    { "id": "J-SCHEMA-FORCE-FORBIDDEN", "tool": "agdf_project", "call_class": "schema_invalid", "fixture": "F2", "envelope": true,
      "omit": ["run_id", "expected_revision_id"],
      "args": { "command": { "kind": "project.initialize", "payload": { "force": true } } } },
    { "id": "J-SEM-TARGET-MISMATCH", "tool": "agdf_project", "call_class": "semantic_failure", "fixture": "F2", "envelope": true,
      "omit": ["run_id", "expected_revision_id"], "override": { "target_id": "${foreign_target_id}" },
      "args": { "command": { "kind": "project.initialize", "payload": {} } } },
    { "id": "N-VALID-CREATE", "tool": "agdf_run", "call_class": "valid", "fixture": "F2", "envelope": true,
      "omit": ["run_id", "expected_revision_id"],
      "args": { "command": { "kind": "run.create", "payload": { "title": "Synthetic protocol Run creation" } } } },
    { "id": "N-SCHEMA-EMPTY-TITLE", "tool": "agdf_run", "call_class": "schema_invalid", "fixture": "F2", "envelope": true,
      "omit": ["run_id", "expected_revision_id"],
      "args": { "command": { "kind": "run.create", "payload": { "title": "" } } } },
    { "id": "N-SEM-TARGET-MISMATCH", "tool": "agdf_run", "call_class": "semantic_failure", "fixture": "F2", "envelope": true,
      "omit": ["run_id", "expected_revision_id"], "override": { "target_id": "${foreign_target_id}" },
      "args": { "command": { "kind": "run.create", "payload": { "title": "Synthetic rejected creation" } } } },
    { "id": "P-VALID-PREPARE-PRD", "tool": "agdf_prepare", "call_class": "valid", "fixture": "F2", "envelope": true,
      "args": { "command": { "kind": "presentation.prepare", "payload": { "gate": "PRD" } } } },
    { "id": "P-SCHEMA-MISSING-OPERATION-ID", "tool": "agdf_prepare", "call_class": "schema_invalid", "fixture": "F2", "envelope": true, "omit": ["operation_id"],
      "args": { "command": { "kind": "presentation.prepare", "payload": { "gate": "PRD" } } } },
    { "id": "P-SEM-STALE-REVISION", "tool": "agdf_prepare", "call_class": "semantic_failure", "fixture": "F2", "envelope": true,
      "override": { "expected_revision_id": "${stale_revision}" },
      "args": { "command": { "kind": "presentation.prepare", "payload": { "gate": "PRD" } } } },
    { "id": "R-VALID-EVIDENCE", "tool": "agdf_record", "call_class": "valid", "fixture": "F2", "envelope": true, "setup": "evidence_note",
      "args": { "command": { "kind": "step.record", "payload": { "step": "evidence", "source": "${evidence}", "reason": "Synthetic smoke check passed", "covers": "AC-001" } } } },
    { "id": "R-SCHEMA-MISSING-COVERS", "tool": "agdf_record", "call_class": "schema_invalid", "fixture": "F2", "envelope": true, "setup": "evidence_note",
      "args": { "command": { "kind": "step.record", "payload": { "step": "evidence", "source": "${evidence}", "reason": "Synthetic smoke check passed" } } } },
    { "id": "R-SEM-TARGET-MISMATCH", "tool": "agdf_record", "call_class": "semantic_failure", "fixture": "F2", "envelope": true, "setup": "evidence_note",
      "override": { "target_id": "${foreign_target_id}" },
      "args": { "command": { "kind": "step.record", "payload": { "step": "evidence", "source": "${evidence}", "reason": "Synthetic smoke check passed", "covers": "AC-001" } } } },
    { "id": "A-VALID-APPROVE-UR", "tool": "agdf_approve", "call_class": "valid", "fixture": "F3", "envelope": true,
      "args": { "command": { "kind": "approval.record", "payload": { "gate": "UR", "presentation_id": "${presentation_id}", "response": "Approval: UR" } } } },
    { "id": "A-SCHEMA-MISSING-RESPONSE", "tool": "agdf_approve", "call_class": "schema_invalid", "fixture": "F3", "envelope": true,
      "args": { "command": { "kind": "approval.record", "payload": { "gate": "UR", "presentation_id": "${presentation_id}" } } } },
    { "id": "A-SEM-UNKNOWN-PRESENTATION", "tool": "agdf_approve", "call_class": "semantic_failure", "fixture": "F3", "envelope": true,
      "args": { "command": { "kind": "approval.record", "payload": { "gate": "UR", "presentation_id": "${stale_revision}", "response": "Approval: UR" } } } },
    { "id": "V-VALID-PREVIEW-UR", "tool": "agdf_revise", "call_class": "valid", "fixture": "F2", "envelope": true, "setup": "ur_revision_proposal",
      "args": { "command": { "kind": "source_revision.preview", "payload": { "source_gate": "UR", "proposal": "${proposal}" } } } },
    { "id": "V-SCHEMA-UNKNOWN-GATE", "tool": "agdf_revise", "call_class": "schema_invalid", "fixture": "F2", "envelope": true, "setup": "ur_revision_proposal",
      "args": { "command": { "kind": "source_revision.preview", "payload": { "source_gate": "QA", "proposal": "${proposal}" } } } },
    { "id": "V-SEM-PROPOSAL-DIGEST", "tool": "agdf_revise", "call_class": "semantic_failure", "fixture": "F2", "envelope": true, "setup": "ur_revision_proposal",
      "args": { "command": { "kind": "source_revision.preview", "payload": { "source_gate": "UR", "proposal": "${proposal_wrong_digest}" } } } },
    { "id": "C-VALID-CLOSEOUT", "tool": "agdf_closeout", "call_class": "valid", "fixture": "F5", "envelope": true,
      "args": { "command": { "kind": "closeout.record", "payload": { "or": "${or}", "confirmation": "${closeout_confirmation}" } } } },
    { "id": "C-SCHEMA-MISSING-CONFIRMATION", "tool": "agdf_closeout", "call_class": "schema_invalid", "fixture": "F5", "envelope": true,
      "args": { "command": { "kind": "closeout.record", "payload": { "or": "${or}" } } } },
    { "id": "C-SEM-NOT-AT-OR", "tool": "agdf_closeout", "call_class": "semantic_failure", "fixture": "F2", "envelope": true, "setup": "evidence_note",
      "args": { "command": { "kind": "closeout.record", "payload": { "or": "${evidence}", "confirmation": "${closeout_confirmation_evidence}" } } } },
    { "id": "K-NOUI-RENDER", "tool": "agdf_cockpit", "call_class": "semantic_failure", "fixture": "F2", "server": "cockpit_without_ui",
      "args": { "run_id": "${run_id}" } },
    { "id": "K-NOUI-SNAPSHOT", "tool": "agdf_cockpit_read", "call_class": "semantic_failure", "fixture": "F2", "server": "cockpit_without_ui",
      "args": { "operation": "snapshot", "session_id": "00000000-0000-4000-8000-000000000000", "run_id": "${run_id}" } },
    { "id": "K-NOUI-SEM-UNKNOWN-OPERATION", "tool": "agdf_cockpit_read", "call_class": "semantic_failure", "fixture": "F2", "server": "cockpit_without_ui",
      "args": { "operation": "unknown-operation", "session_id": "00000000-0000-4000-8000-000000000000" } },
    { "id": "K-VALID-RENDER", "tool": "agdf_cockpit", "call_class": "valid", "fixture": "F2", "server": "cockpit_with_ui", "close_session": true,
      "args": { "run_id": "${run_id}" } },
    { "id": "K-VALID-SNAPSHOT", "tool": "agdf_cockpit_read", "call_class": "valid", "fixture": "F2", "server": "cockpit_with_ui", "session": true,
      "args": { "operation": "snapshot", "session_id": "${session_id}", "run_id": "${run_id}" } },
    { "id": "K-SEM-UNKNOWN-OPERATION", "tool": "agdf_cockpit_read", "call_class": "semantic_failure", "fixture": "F2", "server": "cockpit_with_ui", "session": true,
      "args": { "operation": "unknown-operation", "session_id": "${session_id}" } }
  ]
}
