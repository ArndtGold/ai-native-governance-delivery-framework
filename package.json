{
  "name": "agdf-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "check:community-health": "node scripts/check-community-health.mjs",
    "install:claude": "npm --prefix create-agdf run install:claude",
    "install:codex": "npm --prefix create-agdf run install:codex",
    "install:copilot": "npm --prefix create-agdf run install:copilot",
    "install:opencode": "npm --prefix create-agdf run install:opencode",
    "test:community-health": "node scripts/community-health-test.mjs",
    "set-version": "node scripts/set-version.mjs",
    "test:host-compatibility": "node create-agdf/scripts/host-compatibility-test.js && node scripts/host-compatibility/test.mjs",
    "compatibility:record": "node scripts/host-compatibility/run.mjs record",
    "compatibility:check": "node scripts/host-compatibility/run.mjs check"
  },
  "devDependencies": {
    "yaml": "2.9.0",
    "acorn": "8.17.0"
  }
}
