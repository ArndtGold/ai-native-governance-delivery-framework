---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { site, principles, buildingBlocks, gateMapPaths, compatibility, workflowSteps, prevention, notFor, requirementPaths, approvalGates, visualProofs, aiActFit, operatingGuards } from '../data/site'
import { skills, skillFamilies } from '../data/skills'
import { getProjectStats } from '../data/projectStats'

const projectStats = await getProjectStats()
---

<BaseLayout>
<!-- ==================== NAV ==================== -->
<header class="fixed inset-x-0 top-0 z-50 border-b border-dark-800/60">
  <div class="nav-bar-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a href="#" class="flex items-center gap-2">
      <img src="/assets/logo.png" alt="AGDF" class="h-8 w-auto" />
    </a>
    <button id="nav-toggle" type="button" aria-label="Toggle navigation menu" aria-controls="nav-menu" aria-expanded="false" class="flex cursor-grab items-center rounded-md border border-dark-700 px-2 py-1 text-dark-200 transition-colors hover:border-agdf-500/60 hover:text-agdf-200 md:hidden">
      <span class="nav-toggle-open inline-flex w-5 justify-center text-xl leading-none text-agdf-400">☰</span>
      <span class="nav-toggle-close hidden w-5 justify-center text-xl leading-none text-agdf-400">✕</span>
    </button>
    <div id="nav-menu" class="nav-menu-panel absolute right-4 top-full hidden w-auto flex-col items-end gap-y-1.5 rounded-md rounded-t-none border border-dark-700/80 bg-dark-950/95 p-4 shadow-lg data-[open]:flex md:static md:top-auto md:flex md:w-auto md:flex-1 md:flex-row md:items-center md:justify-between md:gap-x-5 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none">
      <nav class="flex min-w-0 flex-col flex-wrap items-end gap-x-5 gap-y-1 text-sm text-dark-200 md:ml-4 md:flex-row md:items-center">
        <a href="#why" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Why</a>
        <a href="#operating-guards" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Guards</a>
        <a href="#workflow" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Flow</a>
        <a href="#gate-flow" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Gate Map</a>
        <a href="#control-system" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Control System</a>
        <a href="#skills" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Runtime</a>
      </nav>
      <nav class="flex flex-col flex-wrap items-end gap-x-3 gap-y-1 text-sm text-dark-200 md:flex-row md:items-center">
        <a href="#setup" data-navlink class="nav-spy inline-flex items-center rounded-full border border-agdf-500/30 bg-agdf-950/60 px-3 py-1.5 font-semibold text-agdf-200 shadow-[0_0_24px_-16px_var(--agdf-glow)] transition-colors hover:border-agdf-400/60 hover:text-agdf-100">
          Get Started
        </a>
        <a href="#author" data-navlink class="nav-spy inline-flex items-center gap-1.5 transition-colors hover:text-agdf-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
          Author
        </a>
        <a href={site.repo} class="inline-flex items-center gap-1.5 transition-colors hover:text-agdf-300">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          GitHub
        </a>
      </nav>
    </div>
  </div>
  <div id="scroll-progress" class="h-0.5 origin-left bg-agdf-500" style="transform: scaleX(0)"></div>
</header>

<!-- ==================== HERO ==================== -->
<section class="relative flex items-center justify-center overflow-hidden px-0 pb-8 pt-24 sm:pb-20 sm:pt-32 lg:pb-24 lg:pt-36">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(20,184,166,0.16),transparent_55%)]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.035)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>
  <div class="relative mx-auto max-w-[90rem] px-4 text-center sm:px-6">
    <div data-reveal data-reveal-delay="1" class="mb-5 flex justify-center sm:mb-6">
      <div class="flex flex-col items-center gap-2">
        <img
          src="/assets/logo.png"
          alt={site.fullName}
          width="240"
          height="101"
          class="h-auto w-48 sm:w-64 lg:w-72"
          loading="eager"
          decoding="async"
        />
        <div class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-dark-200 sm:text-sm">
          {site.fullName}
        </div>
      </div>
    </div>

    <h1
      data-reveal
      data-reveal-delay="2"
      class="mb-5 text-4xl font-extrabold leading-tight sm:mb-6 sm:text-6xl"
    >
      Govern AI Delivery<br />
      <span class="gradient-text">Before Code Moves</span>
    </h1>

    <p
      data-reveal
      data-reveal-delay="3"
      class="mx-auto mb-4 max-w-3xl text-lg text-dark-100 sm:mb-5 sm:text-xl"
    >
     For teams using artificial intelligence agents on real repositories and business-relevant changes.
    </p>

    <p
      data-reveal
      data-reveal-delay="4"
      class="mx-auto mb-7 max-w-2xl text-sm text-dark-200/80 sm:mb-10 sm:text-base"
    >
      AGDF keeps humans and agents aligned on scope, impact, approval, evidence and next steps before code moves.
    </p>
    <!-- Agent behavior demo -->
    <div data-reveal data-reveal-delay="5" class="mx-auto mt-10 grid max-w-6xl gap-4 text-left lg:grid-cols-[0.86fr_1.14fr]">
      <div class="rounded-[22px] border border-white/10 bg-white/[0.035] p-5 shadow-[0_24px_70px_-46px_rgba(15,23,42,0.95),0_1px_0_rgba(255,255,255,0.08)_inset] backdrop-blur-xl">
        <div class="mb-5 flex items-center justify-between gap-3">
          <div class="text-lg font-semibold text-dark-100 sm:text-xl">Coding Agent without AGDF</div>
          <span class="shrink-0 rounded-full border border-red-500/20 bg-red-500/12 px-3 py-1 text-xs font-semibold text-red-200 sm:text-sm">state unclear</span>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
          <div class="mb-4 text-xs font-medium text-dark-300">OpenAI Codex / Claude Code / GitHub Copilot / OpenCode</div>
          <div class="text-xs font-medium uppercase tracking-wide text-dark-300">User request</div>
          <div class="mt-2 text-base font-semibold leading-snug text-white"> > Add team-based approval workflows to the existing admin console.</div>
          <div class="mt-5 h-px bg-white/10"></div>
          <div class="mt-5 text-sm font-semibold text-red-200">The agent may ask, plan and expose diffs. But agent side approval is not delivery control.</div>
          <div class="mt-2 text-sm leading-relaxed text-dark-300">No durable scope captured in the repository.</div>
          <div class="mt-2 text-sm leading-relaxed text-dark-300">No approved checkpoint before implementation.</div>
          <div class="mt-2 text-sm leading-relaxed text-dark-300">No shared delivery state.</div>
          <div class="mt-4 rounded-xl border border-red-500/20 bg-red-500/10 px-3 py-2 text-sm leading-relaxed text-red-100">
            The diff is visible, but delivery state drifts.
            After many iterations, scope, approval, evidence, gaps and next steps become scattered or implicit.
          </div>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-[22px] border border-cyan-100/45 bg-[linear-gradient(145deg,rgba(34,211,238,0.28),rgba(20,184,166,0.16)_42%,rgba(15,23,42,0.34))] p-5 shadow-[0_38px_110px_-34px_rgba(34,211,238,0.78),0_0_56px_-24px_rgba(125,211,252,0.95),0_1px_0_rgba(255,255,255,0.24)_inset] backdrop-blur-xl">
        <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-cyan-100/80 to-transparent"></div>
        <div class="pointer-events-none absolute -right-16 -top-20 h-44 w-44 rounded-full bg-cyan-200/18 blur-3xl"></div>
        <div class="mb-5 flex items-center justify-between gap-3">
          <div class="text-lg font-semibold text-white sm:text-xl">Coding Agent governed by AGDF</div>
          <span class="shrink-0 rounded-full border border-agdf-300/25 bg-agdf-400/12 px-3 py-1 text-xs font-semibold text-agdf-100 shadow-[0_0_24px_-12px_var(--agdf-glow)] sm:text-sm">safely blocked</span>
        </div>
        <div class="relative rounded-2xl border border-cyan-100/25 bg-black/32 p-4 shadow-[0_1px_0_rgba(255,255,255,0.12)_inset]">
          <div class="mb-4 text-xs font-medium text-dark-300">OpenAI Codex / Claude Code / GitHub Copilot / OpenCode</div>
          <div class="text-xs font-medium uppercase tracking-wide text-dark-300">User request</div>
          <div class="mt-2 text-base font-semibold leading-snug text-white"> > Add team-based approval workflows to the existing admin console.</div>
          <div class="mt-5 grid gap-2.5 text-sm">
            <div class="flex items-center justify-between gap-3 rounded-xl bg-white/[0.06] px-3 py-2">
              <span class="flex min-w-0 items-center gap-2 text-dark-300">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                First checkpoint
              </span>
              <code class="shrink-0 text-cyan-100">User need captured</code>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-xl bg-white/[0.06] px-3 py-2">
              <span class="flex min-w-0 items-center gap-2 text-dark-300">
                <Icon name="shield-check" class="h-4 w-4 shrink-0 text-agdf-200" />
                Allowed
              </span>
              <span class="text-right text-dark-100">Clarify what should change and why it matters.</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-xl bg-red-500/[0.075] px-3 py-2">
              <span class="flex min-w-0 items-center gap-2 text-red-100/80">
                <Icon name="boundary" class="h-4 w-4 shrink-0 text-red-200" />
                Blocked
              </span>
              <span class="text-right text-red-50">Do not change approval logic before scope and impact are clear.</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-xl border border-cyan-100/15 bg-cyan-300/13 px-3 py-2 shadow-[0_0_24px_-18px_rgba(103,232,249,0.9)]">
              <span class="flex min-w-0 items-center gap-2 text-dark-300">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                Your control
              </span>
              <code class="shrink-0 text-cyan-100">Approval required</code>
            </div>
          </div>
          <div class="mt-4 rounded-xl border border-cyan-100/15 bg-cyan-300/[0.07] px-3 py-2 text-sm leading-relaxed text-dark-200">
            From code diff to shared delivery state.
            Humans and agents stay aligned across long-running delivery work.
          </div>
        </div>
      </div>
    </div>
    <div data-reveal data-reveal-delay="5" class="mx-auto mt-5 grid max-w-5xl gap-3 text-left sm:grid-cols-2 lg:grid-cols-4">
      {[
        ["Durable gates", "The current checkpoint, missing approval and next allowed action survive the chat.", "#durable-control-state"],
        ["Existing impact first", "See what could be affected before the work starts moving.", "#gate-flow"],
        ["Evidence before QA", "Quality decisions come from coverage, fit and proof, not confidence.", "#workflow"],
        ["Auditable closeout", "Every run ends with what changed, what stayed open and what can happen next.", "#durable-control-state"],
      ].map(([title, desc, href]) => (
        <a href={href} class="group relative block overflow-hidden rounded-2xl border border-cyan-100/25 bg-[linear-gradient(145deg,rgba(34,211,238,0.16),rgba(15,23,42,0.23))] p-4 shadow-[0_20px_62px_-34px_rgba(34,211,238,0.62),0_1px_0_rgba(255,255,255,0.14)_inset] transition-all duration-300 hover:-translate-y-0.5 hover:border-cyan-100/45 hover:shadow-[0_26px_72px_-32px_rgba(34,211,238,0.78),0_1px_0_rgba(255,255,255,0.18)_inset]">
          <div class="pointer-events-none absolute inset-x-4 top-0 h-px bg-gradient-to-r from-transparent via-cyan-100/55 to-transparent"></div>
          <div class="text-sm font-semibold text-cyan-100">{title}</div>
          <p class="mt-2 text-xs leading-relaxed text-dark-300">{desc}</p>
          <div class="mt-3 text-xs font-medium text-cyan-100/80 transition-colors group-hover:text-cyan-50">Learn more -></div>
        </a>
      ))}
    </div>
    <div data-reveal data-reveal-delay="5" class="mx-auto mt-4 flex max-w-5xl flex-wrap justify-center gap-3 text-left">
      {[
        ["archive-box", "Apache-2.0"],
        ["plugin", "Plugin-based"],
        ["file-evidence", "Evidence-driven"],
        ["code", "Built for real repositories"],
      ].map(([icon, label]) => (
        <div class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-cyan-100/15 bg-blue-950/40 px-4 py-2 text-sm font-semibold text-dark-100 shadow-[0_16px_48px_-32px_rgba(56,189,248,0.72),0_1px_0_rgba(255,255,255,0.10)_inset]">
          <Icon name={icon} class="h-5 w-5 shrink-0 text-cyan-200" />
          <span>{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ==================== WHY IT WORKS ==================== -->
<section id="why" class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6">
  <div data-reveal class="mb-12 text-center">
    <h2 class="mb-3 text-3xl font-bold sm:text-4xl">Why It Works</h2>
    <p class="mx-auto max-w-3xl text-dark-200">
      AI coding agents can create output fast. But usage metrics alone do not prove delivery value. AGDF connects agent work to approved scope, required evidence and delivery decisions, so teams can see whether AI activity creates progress or just more review effort.
    </p>
  </div>
  <!-- Building blocks -->
  <div class="mb-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {buildingBlocks.map((b, i) => (
      <div data-reveal data-reveal-delay={String((i % 4) + 1)} class="card-glow p-6 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl border border-agdf-500/30 bg-agdf-950 text-agdf-300 shadow-[0_0_28px_-12px_var(--agdf-glow)]">
          <Icon name={b.icon} class="h-8 w-8" />
        </div>
        <h3 class="mb-2 text-lg font-semibold">{b.name}</h3>
        <p class="text-sm text-dark-200">{b.desc}</p>
      </div>
    ))}
  </div>
  <!-- Principles -->
  <div class="grid gap-4 sm:grid-cols-2">
    {principles.map((p, i) => (
      <div data-reveal data-reveal-delay={String((i % 2) + 1)} class="inset-highlight flex gap-4 rounded-lg border border-dark-700/80 bg-dark-900/50 p-4 transition-colors hover:border-agdf-500/40">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-agdf-500/30 bg-agdf-950 font-mono text-sm font-bold text-agdf-400">{i + 1}</span>
        <div>
          <h4 class="font-semibold text-agdf-200">{p.title}</h4>
          <p class="mt-1 text-sm text-dark-200">{p.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ==================== RACE CONTROL ANALOGY ==================== -->
<section id="race-control" class="border-y border-dark-800/80 bg-dark-900/30 py-24">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6">
    <div data-reveal class="mb-12 text-center">
      <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">Delivery analogy</div>
      <h2 class="mb-3 text-3xl font-bold sm:text-4xl">Not the stronger engine. The control system around it.</h2>
      <p class="mx-auto max-w-3xl text-dark-200">
        Faster agents help. Reliable delivery comes from direction, checkpoints, context, quality rules and the authority to stop before the next move becomes unsafe.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch">
      <div data-reveal data-reveal-delay="1" class="relative overflow-hidden rounded-2xl border border-cyan-100/20 bg-[linear-gradient(145deg,rgba(34,211,238,0.12),rgba(15,23,42,0.52))] p-6 shadow-[0_30px_90px_-54px_rgba(34,211,238,0.72),0_1px_0_rgba(255,255,255,0.12)_inset]">
        <div class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-cyan-100/70 to-transparent"></div>
        <div class="mb-8 flex items-center justify-between gap-4">
          <div>
            <div class="font-mono text-xs font-bold uppercase tracking-wide text-cyan-200">AI coding agent</div>
            <div class="mt-2 text-2xl font-bold text-white">The engine creates force.</div>
          </div>
          <span class="rounded-full border border-cyan-100/20 bg-cyan-300/10 px-3 py-1 text-xs font-semibold text-cyan-100">fast output</span>
        </div>
        <div class="relative rounded-2xl border border-white/10 bg-black/25 p-5">
          <div class="absolute left-6 right-6 top-1/2 h-px -translate-y-1/2 bg-gradient-to-r from-cyan-300/10 via-cyan-200/50 to-cyan-300/10"></div>
          <div class="relative grid gap-4 sm:grid-cols-3">
            {["Prompt", "Code", "Diff"].map((label, i) => (
              <div class="rounded-xl border border-white/10 bg-dark-950/70 p-4 text-center shadow-[0_16px_48px_-36px_rgba(34,211,238,0.7)]">
                <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full border border-cyan-100/30 bg-cyan-300/10 font-mono text-sm font-bold text-cyan-100">{i + 1}</div>
                <div class="text-sm font-semibold text-dark-100">{label}</div>
              </div>
            ))}
          </div>
        </div>
        <p class="mt-6 text-sm leading-relaxed text-dark-200">
          Many agent tools can plan, call tools and produce diffs. The missing layer is delivery authority: whether the next move is approved, evidenced and safe to execute.
        </p>
      </div>

      <div data-reveal data-reveal-delay="2" class="grid gap-3 sm:grid-cols-2">
        {[
          ["map", "Track", "Artifacts", "goal, direction and a clear path"],
          ["workflow", "Pit stops", "Gates", "check, adjust and approve before moving on"],
          ["control-network", "Radio", "Context Graph", "shared context, feedback and priorities"],
          ["clipboard-document-check", "Rules", "Quality Contracts", "standards, boundaries and evidence"],
          ["shield-check", "Race control", "Control State", "monitor, decide and stop when necessary"],
        ].map(([icon, metaphor, agdfPart, desc], i) => (
          <div class={`inset-highlight rounded-lg border border-dark-700/80 bg-dark-900/60 p-5 transition-colors hover:border-agdf-500/40 ${i === 4 ? 'sm:col-span-2' : ''}`}>
            <div class="mb-4 flex items-center justify-between gap-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-agdf-500/30 bg-agdf-950/70 text-agdf-300 shadow-[0_0_28px_-16px_var(--agdf-glow)]">
                <Icon name={icon} class="h-6 w-6" />
              </span>
              <span class="rounded-full border border-dark-700/80 bg-dark-950/70 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wide text-dark-300">AGDF</span>
            </div>
            <div class="text-lg font-semibold text-dark-100">{metaphor}</div>
            <div class="mt-1 text-sm font-medium text-agdf-300">{agdfPart}</div>
            <p class="mt-3 text-sm leading-relaxed text-dark-200">{desc}</p>
          </div>
        ))}
      </div>
    </div>

    <figure data-reveal data-reveal-delay="3" class="mt-8 overflow-hidden rounded-2xl border border-cyan-100/20 bg-dark-950 shadow-[0_28px_90px_-52px_rgba(34,211,238,0.75)]">
      <img
        src="/assets/race-control-track-visual.jpg"
        alt="Race car on track beside a pit stop and race control tower, used as an analogy for governed AI delivery."
        width="1448"
        height="300"
        class="block h-auto w-full"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div data-reveal data-reveal-delay="3" class="mt-8 rounded-2xl border border-cyan-100/20 bg-cyan-300/[0.06] p-5 text-center shadow-[0_22px_70px_-46px_rgba(34,211,238,0.7)]">
      <p class="mx-auto max-w-4xl text-lg font-semibold leading-relaxed text-dark-100">
        AGDF does not try to make the engine stronger. It makes the delivery run controlled enough to reach the finish line.
      </p>
    </div>
  </div>
</section>

<!-- ==================== PRODUCT PROOF ==================== -->
<section id="proof" class="mx-auto max-w-[90rem] px-4 pb-24 pt-10 sm:px-6">
  <div data-reveal class="grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">{visualProofs.product.eyebrow}</div>
      <h2 class="mb-4 text-3xl font-bold sm:text-4xl">{visualProofs.product.title}</h2>
      <p class="max-w-xl text-dark-200">{visualProofs.product.desc}</p>
      <p class="mt-3 max-w-xl text-sm font-medium text-agdf-300/90">{visualProofs.product.built}</p>
    </div>
