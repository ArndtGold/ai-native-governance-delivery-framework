        <p class="mt-1 text-sm text-dark-200">Setup targets, control-state commands, validators and global installation live with the package.</p>
      </div>
      <a href="https://www.npmjs.com/package/@agdf/cli" target="_blank" rel="noreferrer" class="inline-flex shrink-0 items-center rounded-full border border-agdf-500/40 bg-agdf-950 px-4 py-2 text-sm font-semibold text-agdf-200 transition-colors hover:border-agdf-400 hover:text-agdf-100">
        @agdf/cli on npm →
      </a>
    </div>
    <div data-reveal data-reveal-delay="1" class="mb-5 grid gap-3 text-sm md:grid-cols-2">
      <div class="rounded-2xl border border-agdf-500/20 bg-agdf-950/35 p-4">
        <div class="font-mono text-xs font-bold uppercase tracking-wide text-agdf-300">Plugin install supported</div>
        <p class="mt-2 text-dark-200">Codex, Claude Code and OpenCode can load AGDF as an installable plugin or plugin hook.</p>
      </div>
      <div class="rounded-2xl border border-dark-700/80 bg-dark-950/35 p-4">
        <div class="font-mono text-xs font-bold uppercase tracking-wide text-dark-200">Repository setup supported</div>
        <p class="mt-2 text-dark-200">Codex, OpenCode and GitHub Copilot can use repository-local AGDF files for reviewable project setup.</p>
      </div>
    </div>
    <div data-reveal data-reveal-delay="1" class="mb-5 rounded-2xl border border-dark-700/80 bg-dark-950/35 p-4 text-sm">
      <div class="font-mono text-xs font-bold uppercase tracking-wide text-dark-200">Version baseline</div>
      <p class="mt-2 text-dark-200">AGDF targets the current plugin-capable or repository-instruction-capable releases of each coding agent. Exact minimum agent versions are not pinned yet; use the latest Codex, Claude Code, OpenCode and GitHub Copilot releases for supported setup.</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-2">
      <div id="setup-codex" data-reveal data-reveal-delay="2" class="surface p-5">
        <div class="mb-3">
          <div class="flex items-center gap-2.5 text-xl font-bold text-dark-100"><span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-agdf-500/25 bg-agdf-950/70 shadow-[0_0_22px_-16px_var(--agdf-glow)]"><Icon name="ai-agent" class="h-5 w-5 text-agdf-300" /></span>Codex</div>
          <div class="mt-1 inline-flex rounded-full border border-agdf-500/25 bg-agdf-950/60 px-2.5 py-0.5 font-mono text-xs font-semibold uppercase tracking-wide text-agdf-300">Plugin install</div>
        </div>
        <div class="terminal">
          <div class="terminal-body">
            <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">npx --yes @agdf/cli@latest codex</span></div>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-200">Start a new Codex session and use the AGDF skills from the plugin.</p>
      </div>
      <div id="setup-codex-project" data-reveal data-reveal-delay="2" class="surface p-5">
        <div class="mb-3">
          <div class="flex items-center gap-2.5 text-xl font-bold text-dark-100"><span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-agdf-500/25 bg-agdf-950/70 shadow-[0_0_22px_-16px_var(--agdf-glow)]"><Icon name="ai-agent" class="h-5 w-5 text-agdf-300" /></span>Codex</div>
          <div class="mt-1 inline-flex rounded-full border border-agdf-500/25 bg-agdf-950/60 px-2.5 py-0.5 font-mono text-xs font-semibold uppercase tracking-wide text-agdf-300">Repository setup</div>
        </div>
        <div class="terminal">
          <div class="terminal-body">
            <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">npx --yes @agdf/cli@latest codex-repo</span></div>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-200">Restart Codex, open <code>/plugins</code>, select this repository and install <code>agdf</code>.</p>
      </div>
      <div id="setup-opencode" data-reveal data-reveal-delay="3" class="surface p-5">
        <div class="mb-3">
          <div class="flex items-center gap-2.5 text-xl font-bold text-dark-100"><span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-agdf-500/25 bg-agdf-950/70 shadow-[0_0_22px_-16px_var(--agdf-glow)]"><Icon name="ai-agent" class="h-5 w-5 text-agdf-300" /></span>OpenCode</div>
          <div class="mt-1 inline-flex rounded-full border border-agdf-500/25 bg-agdf-950/60 px-2.5 py-0.5 font-mono text-xs font-semibold uppercase tracking-wide text-agdf-300">Plugin hook</div>
        </div>
        <div class="terminal">
          <div class="terminal-body">
            <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">npx --yes @agdf/cli@latest opencode</span></div>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-200">Restart OpenCode so it loads the AGDF npm plugin from your global config.</p>
      </div>
      <div id="setup-opencode-repo" data-reveal data-reveal-delay="3" class="surface p-5">
        <div class="mb-3">
          <div class="flex items-center gap-2.5 text-xl font-bold text-dark-100"><span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-agdf-500/25 bg-agdf-950/70 shadow-[0_0_22px_-16px_var(--agdf-glow)]"><Icon name="ai-agent" class="h-5 w-5 text-agdf-300" /></span>OpenCode</div>
          <div class="mt-1 inline-flex rounded-full border border-agdf-500/25 bg-agdf-950/60 px-2.5 py-0.5 font-mono text-xs font-semibold uppercase tracking-wide text-agdf-300">Repository setup</div>
        </div>
        <div class="terminal">
          <div class="terminal-body">
            <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">npx --yes @agdf/cli@latest opencode-repo</span></div>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-200">Restart OpenCode in this repository and start with <code>@agdf-gate-check</code>.</p>
      </div>
      <div id="setup-claude" data-reveal data-reveal-delay="3" class="surface p-5">
        <div class="mb-3">
          <div class="flex items-center gap-2.5 text-xl font-bold text-dark-100"><span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-agdf-500/25 bg-agdf-950/70 shadow-[0_0_22px_-16px_var(--agdf-glow)]"><Icon name="ai-agent" class="h-5 w-5 text-agdf-300" /></span>Claude Code</div>
          <div class="mt-1 inline-flex rounded-full border border-agdf-500/25 bg-agdf-950/60 px-2.5 py-0.5 font-mono text-xs font-semibold uppercase tracking-wide text-agdf-300">Plugin install</div>
        </div>
        <div class="terminal">
          <div class="terminal-body">
            <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">npx --yes @agdf/cli@latest claude</span></div>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-200">Start a new Claude Code session and use the AGDF plugin skills.</p>
      </div>
      <div id="setup-copilot" data-reveal data-reveal-delay="4" class="surface p-5 lg:col-span-2">
        <div class="mb-3">
          <div class="flex items-center gap-2.5 text-xl font-bold text-dark-100"><span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-agdf-500/25 bg-agdf-950/70 shadow-[0_0_22px_-16px_var(--agdf-glow)]"><Icon name="ai-agent" class="h-5 w-5 text-agdf-300" /></span>GitHub Copilot</div>
          <div class="mt-1 inline-flex rounded-full border border-agdf-500/25 bg-agdf-950/60 px-2.5 py-0.5 font-mono text-xs font-semibold uppercase tracking-wide text-agdf-300">Repository setup</div>
        </div>
        <div class="terminal">
          <div class="terminal-body">
            <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">npx --yes @agdf/cli@latest copilot</span></div>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-200">Run <code>/instructions</code> after merging any generated AGENTS fragment.</p>
      </div>
    </div>
    <div class="mt-10">
      <div data-reveal data-reveal-delay="6" class="mb-10">
        <div class="mb-4 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <div class="mb-2 flex items-center gap-2 text-sm text-dark-200">
              <span class="text-dark-200/50">Codex plugin:</span>
              <span class="font-semibold">Installed skills and hooks</span>
            </div>
            <p class="max-w-3xl text-sm leading-6 text-dark-200">
              AGDF appears in Codex as an installable plugin, with governed workflow skills, lifecycle hooks and plugin metadata visible where developers start the work.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-2">
            <span class="rounded-full border border-agdf-500/30 bg-agdf-950/50 px-3 py-1 text-xs font-semibold text-agdf-200">Plugin UI</span>
            <span class="rounded-full border border-agdf-500/30 bg-agdf-950/50 px-3 py-1 text-xs font-semibold text-agdf-200">9 skills</span>
            <span class="rounded-full border border-agdf-500/30 bg-agdf-950/50 px-3 py-1 text-xs font-semibold text-agdf-200">Hooks</span>
          </div>
        </div>
        <figure class="surface group relative overflow-hidden p-2" data-lightbox-trigger>
          <div class="max-h-[46rem] overflow-hidden rounded-lg bg-white">
            <img
              src="/assets/codex-agdf-plugin-ui.png"
              alt="Codex plugin detail page showing AI Governance and Delivery Framework installed with AGDF skills, hooks and plugin metadata."
              width="1450"
              height="2200"
              class="block h-auto w-full cursor-zoom-in"
              loading="lazy"
              decoding="async"
            />
          </div>
          <button type="button" data-lightbox-open aria-label="Bild vergrößern" class="absolute inset-0 flex items-center justify-center bg-dark-950/0 opacity-0 transition-all duration-300 focus-visible:opacity-100 focus-visible:bg-dark-950/40 group-hover:bg-dark-950/40 group-hover:opacity-100">
            <span class="flex h-12 w-12 items-center justify-center rounded-full border border-agdf-500/50 bg-dark-950/70 text-agdf-200 backdrop-blur-sm shadow-[0_0_30px_-8px_var(--agdf-glow)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
          </button>
        </figure>
        <p class="mt-3 text-sm leading-6 text-dark-200">
          Screenshot shown as a UI example, not as the release version source of truth. Use the install command and package metadata for the current release.
        </p>
      </div>
      <div data-reveal data-reveal-delay="7">
        <div class="mb-2 flex items-center gap-2 text-sm text-dark-200">
          <span class="text-dark-200/50">AGDF proof:</span>
          <span class="font-semibold">Gate behavior shown in Codex</span>
        </div>
        <div class="grid gap-4 lg:grid-cols-[minmax(0,0.78fr)_minmax(22rem,1fr)] lg:items-start">
          <div class="terminal">
            <div class="terminal-body space-y-2">
              <div><span class="text-agdf-400">❯</span> <span class="text-dark-100">Build me a CLI for counting files.</span></div>
              <div class="text-dark-200">  Looks simple, but behavior is still undefined</div>
              <div class="text-dark-200">  Recursive or current folder only?</div>
              <div class="text-dark-200">  Hidden files, symlinks and output format?</div>
              <div class="text-dark-200">  Local script or installable CLI?</div>
              <div class="text-dark-200">  Current gate: <code>UR</code></div>
              <div class="text-dark-200">  Status: <code class="text-yellow-400">blocked</code></div>
              <div class="text-dark-200">  Result: AGDF stops before behavior is invented</div>
            </div>
          </div>
          <div>
            <figure class="surface group relative overflow-hidden p-2" data-lightbox-trigger>
              <img
                src="/assets/codex-gate-check-proof.png"
                alt="Codex terminal showing AGDF reading control files, blocking implementation at the UR gate and asking for Approval: UR."
                width="927"
                height="620"
                class="block h-auto w-full cursor-zoom-in rounded-lg"
                loading="lazy"
                decoding="async"
              />
              <button type="button" data-lightbox-open aria-label="Bild vergrößern" class="absolute inset-0 flex items-center justify-center bg-dark-950/0 opacity-0 transition-all duration-300 focus-visible:opacity-100 focus-visible:bg-dark-950/40 group-hover:bg-dark-950/40 group-hover:opacity-100">
                <span class="flex h-12 w-12 items-center justify-center rounded-full border border-agdf-500/50 bg-dark-950/70 text-agdf-200 backdrop-blur-sm shadow-[0_0_30px_-8px_var(--agdf-glow)]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </span>
              </button>
            </figure>
            <p class="mt-3 text-sm leading-6 text-dark-200">
              Without a UR, the same prompt could become a different CLI tomorrow. AGDF stops the agent before hidden choices turn into accidental behavior. Codex is shown here as the captured proof surface.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== AUTHOR ==================== -->
<section id="author" class="mx-auto max-w-[90rem] px-4 py-24 sm:px-6">
  <div data-reveal class="mb-10 text-center">
    <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">Author</div>
    <img src={site.author.image} alt={site.author.name} class="mx-auto mb-4 h-16 w-16 rounded-2xl border border-agdf-500/30 bg-agdf-950 object-cover shadow-[0_0_30px_-10px_var(--agdf-glow)]" loading="lazy" decoding="async" />
    <h2 class="text-2xl font-bold sm:text-3xl">{site.author.name}</h2>
    <p class="mt-2 text-sm text-dark-200">{site.author.role}</p>
  </div>
  <div data-reveal data-reveal-delay="1" class="space-y-4 text-center">
    <p class="text-dark-200">AGDF was created by <strong class="font-semibold text-dark-100">{site.author.name}</strong>, a software engineer with more than 30 years of enterprise software experience and a background in mechanical engineering and computer science.</p>
    <p class="text-dark-200">The framework reflects observations from Java, Spring, Brownfield systems and AI-assisted development: fast AI output can be useful, but software delivery still needs artifacts, gates, evidence and human responsibility.</p>
  </div>
  <div data-reveal data-reveal-delay="2" class="inset-highlight mt-8 rounded-lg border border-dark-700/80 bg-dark-900/50 p-5 text-center">
    <p class="text-sm text-dark-200">AGDF is an independent, installable open framework. Teams can adopt only the control depth their work needs; it does not replace product responsibility, engineering judgment or experienced developers.</p>
  </div>

  <div data-reveal data-reveal-delay="5" class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
      {projectStats.map((stat) => {
        const isProjectStars = stat.label === 'Project stars'
        return (
        <a href={stat.href} class={`group inline-flex overflow-hidden rounded-lg border border-blue-400/20 bg-blue-950/60 text-xs font-bold uppercase tracking-[0.14em] text-blue-50 shadow-[0_0_24px_-16px_rgba(96,165,250,0.8)] transition-colors hover:border-blue-300/50 ${isProjectStars ? 'star-nudge' : ''}`} aria-label={isProjectStars ? `Star AGDF on GitHub. Current project stars: ${stat.value}` : `${stat.label}: ${stat.value}`}>
          <span class="inline-flex items-center gap-1.5 bg-blue-800/70 px-2.5 py-1.5 transition-colors group-hover:bg-blue-700/80">
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            {stat.label}
          </span>
          <span class="inline-flex items-center gap-1.5 bg-blue-900/80 px-3 py-1.5 font-mono tracking-wide transition-colors group-hover:bg-blue-800/80">
            {isProjectStars && (
              <svg class="star-spark h-3.5 w-3.5 text-yellow-200" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.1 9.8 5.4l4.7.4-3.6 3.1 1.1 4.6L8 11.1l-4 2.4 1.1-4.6-3.6-3.1 4.7-.4L8 1.1Z"/></svg>
            )}
            {stat.value}
            {isProjectStars && <span class="hidden font-sans text-[10px] font-semibold normal-case tracking-normal text-blue-100/80 sm:inline">Star if useful</span>}
          </span>
        </a>
        )
      })}
  </div>

</section>

