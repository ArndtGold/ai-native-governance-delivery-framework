      <p class="text-dark-200">Choose your agent surface. The npm package holds the complete CLI reference.</p>
    </div>
    <div data-reveal data-reveal-delay="1" class="surface mb-8 flex flex-col items-start justify-between gap-4 p-5 sm:flex-row sm:items-center">
