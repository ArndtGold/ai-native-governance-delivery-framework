---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { site, principles, buildingBlocks, gateFlow, compatibility, workflowSteps, prevention, notFor, requirementPaths, approvalGates, visualProofs } from '../data/site'
import { skills, skillFamilies } from '../data/skills'
---

<BaseLayout>
<!-- ==================== NAV ==================== -->
<header class="fixed inset-x-0 top-0 z-50 border-b border-dark-800/60">
  <div class="nav-bar-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a href="#" class="flex items-center gap-2">
      <img src="/assets/logo.png" alt="AGDF" class="h-8 w-auto" />
    </a>
    <button id="nav-toggle" type="button" aria-label="Toggle navigation menu" aria-controls="nav-menu" aria-expanded="false" class="flex cursor-grab items-center rounded-md border border-dark-700 px-2 py-1 text-dark-200 transition-colors hover:border-agdf-500/60 hover:text-agdf-200 md:hidden">
      <span class="nav-toggle-open inline-flex w-5 justify-center text-xl leading-none text-agdf-400">☰</span>
      <span class="nav-toggle-close hidden w-5 justify-center text-xl leading-none text-agdf-400">✕</span>
    </button>
    <div id="nav-menu" class="nav-menu-panel absolute right-4 top-full hidden w-auto flex-col items-end gap-y-1.5 rounded-md rounded-t-none border border-dark-700/80 bg-dark-950/95 p-4 shadow-lg data-[open]:flex md:static md:top-auto md:flex md:w-auto md:flex-1 md:flex-row md:items-center md:justify-between md:gap-x-5 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none">
      <nav class="flex min-w-0 flex-col flex-wrap items-end gap-x-5 gap-y-1 text-sm text-dark-200 md:ml-4 md:flex-row md:items-center">
        <a href="#why" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Why</a>
        <a href="#proof" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Proof</a>
        <a href="#intake" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Intake</a>
        <a href="#workflow" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Workflow</a>
        <a href="#skills" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Skills</a>
        <a href="#setup" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Setup</a>
        <a href="#architecture" data-navlink class="nav-spy transition-colors hover:text-agdf-300">Architecture</a>
      </nav>
      <nav class="flex flex-col flex-wrap items-end gap-x-3 gap-y-1 text-sm text-dark-200 md:flex-row md:items-center">
        <a href={site.repo} class="inline-flex items-center gap-1.5 transition-colors hover:text-agdf-300">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          GitHub
        </a>
      </nav>
    </div>
  </div>
  <div id="scroll-progress" class="h-0.5 origin-left bg-agdf-500" style="transform: scaleX(0)"></div>
</header>

<!-- ==================== HERO ==================== -->
<section class="relative flex items-center justify-center overflow-hidden px-0 pb-8 pt-24 sm:pb-20 sm:pt-32 lg:pb-24 lg:pt-36">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(20,184,166,0.16),transparent_55%)]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.035)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>
  <div class="relative mx-auto max-w-[90rem] px-4 text-center sm:px-6">
    <div data-reveal class="glass mb-5 inline-flex items-center gap-2 rounded-full border border-agdf-500/30 px-4 py-1.5 text-sm text-agdf-300 sm:mb-6">
      <span class="h-2 w-2 rounded-full bg-agdf-400 shadow-[0_0_10px_var(--agdf-glow)] animate-pulse"></span>
      Open governance framework · Apache-2.0
    </div>
    <div data-reveal data-reveal-delay="1" class="mb-5 sm:mb-6">
      <div class="text-2xl font-extrabold tracking-tight sm:text-3xl"><span class="gradient-text">AGDF</span></div>
      <div class="mt-1 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-dark-200 sm:text-sm">{site.fullName}</div>
    </div>
    <h1 data-reveal data-reveal-delay="2" class="mb-5 text-4xl font-extrabold leading-tight sm:mb-6 sm:text-6xl">
      From AI Output to<br /><span class="gradient-text">Governed Delivery</span>
    </h1>
    <p data-reveal data-reveal-delay="3" class="mx-auto mb-4 max-w-2xl text-lg text-dark-100 sm:mb-5 sm:text-xl">
      AGDF is a framework for AI-assisted software delivery with artifacts, gates, QA evidence and Brownfield-aware context.
    </p>
    <p data-reveal data-reveal-delay="4" class="mx-auto mb-7 max-w-xl text-sm text-dark-200/80 sm:mb-10 sm:text-base">
      It helps teams use AI agents without losing scope, traceability, reviewability and human responsibility.
    </p>
    <div data-reveal data-reveal-delay="5" class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="#workflow" class="btn-primary">See the workflow</a>
      <a href={site.repo} class="btn-ghost">View on GitHub</a>
    </div>
    <!-- Terminal demo -->
    <div data-reveal data-reveal-delay="5" class="terminal mx-auto mt-10 hidden max-w-lg text-left sm:block">
      <div class="terminal-header">
        <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
        <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
        <span class="ml-2 text-xs text-dark-200">Claude Code / GitHub Copilot</span>
      </div>
      <div class="terminal-body">
        <div class="text-agdf-400">❯ <span class="text-dark-100">/agdf-gate-check</span></div>
        <div class="mt-2 text-dark-200">
          <div><span class="text-agdf-300">Current gate:</span> <code>PRD</code></div>
          <div><span class="text-agdf-300">Status:</span> <code class="text-yellow-400">blocked</code></div>
          <div><span class="text-agdf-300">Allowed:</span> clarify status, OR-lite</div>
          <div><span class="text-agdf-300">Forbidden:</span> SD, TP, code</div>
          <div><span class="text-agdf-300">Missing approval:</span> <code>Approval: PRD</code></div>
          <div><span class="text-agdf-300">Next step:</span> provide the exact approval</div>
        </div>
      </div>
    </div>
    <div data-reveal data-reveal-delay="5" class="terminal mt-6 px-4 py-3 text-left font-mono text-xs text-dark-100 sm:hidden">
      <div><span class="text-agdf-400">❯</span> /agdf-gate-check</div>
      <div class="mt-2 text-dark-200"><span class="text-agdf-300">Missing:</span> <code>Approval: PRD</code></div>
    </div>
  </div>
</section>

<!-- ==================== WHY IT WORKS ==================== -->
<section id="why" class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6">
  <div data-reveal class="mb-12 text-center">
    <h2 class="mb-3 text-3xl font-bold sm:text-4xl">Why It Works</h2>
    <p class="text-dark-200">The framework turns delivery principles into repeatable checks.</p>
  </div>
  <!-- Building blocks -->
  <div class="mb-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {buildingBlocks.map((b, i) => (
      <div data-reveal data-reveal-delay={String((i % 4) + 1)} class="card-glow p-6 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl border border-agdf-500/30 bg-agdf-950 text-agdf-300 shadow-[0_0_28px_-12px_var(--agdf-glow)]">
          <Icon name={b.icon} class="h-8 w-8" />
        </div>
        <h3 class="mb-2 text-lg font-semibold">{b.name}</h3>
        <p class="text-sm text-dark-200">{b.desc}</p>
      </div>
    ))}
  </div>
  <!-- Principles -->
  <div class="grid gap-4 sm:grid-cols-2">
    {principles.map((p, i) => (
      <div data-reveal data-reveal-delay={String((i % 2) + 1)} class="inset-highlight flex gap-4 rounded-lg border border-dark-700/80 bg-dark-900/50 p-4 transition-colors hover:border-agdf-500/40">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-agdf-500/30 bg-agdf-950 font-mono text-sm font-bold text-agdf-400">{i + 1}</span>
        <div>
          <h4 class="font-semibold text-agdf-200">{p.title}</h4>
          <p class="mt-1 text-sm text-dark-200">{p.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ==================== PRODUCT PROOF ==================== -->
<section id="proof" class="mx-auto max-w-[90rem] px-4 pb-24 pt-10 sm:px-6">
  <div data-reveal class="grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">{visualProofs.product.eyebrow}</div>
      <h2 class="mb-4 text-3xl font-bold sm:text-4xl">{visualProofs.product.title}</h2>
      <p class="max-w-xl text-dark-200">{visualProofs.product.desc}</p>
      <p class="mt-3 max-w-xl text-sm font-medium text-agdf-300/90">{visualProofs.product.built}</p>
    </div>
    <figure class="surface group relative overflow-hidden p-2" data-lightbox-trigger>
      <img src={visualProofs.product.src} alt={visualProofs.product.alt} width={visualProofs.product.width} height={visualProofs.product.height} class="block h-auto w-full cursor-zoom-in rounded-lg" loading="eager" decoding="async" />
      <button type="button" data-lightbox-open aria-label="Bild vergrößern" class="absolute inset-0 flex items-center justify-center bg-dark-950/0 opacity-0 transition-all duration-300 focus-visible:opacity-100 focus-visible:bg-dark-950/40 group-hover:bg-dark-950/40 group-hover:opacity-100">
        <span class="flex h-14 w-14 items-center justify-center rounded-full border border-agdf-500/50 bg-dark-950/70 text-agdf-200 backdrop-blur-sm shadow-[0_0_30px_-8px_var(--agdf-glow)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
      </button>
    </figure>
  </div>
</section>

<!-- ==================== HIGHLIGHTS ==================== -->
<section id="highlights" class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6">
  <div data-reveal class="mb-12 text-center">
    <h2 class="mb-3 text-3xl font-bold sm:text-4xl">What AGDF Catches Early</h2>
    <p class="text-dark-200">Agent output can look confident while the delivery basis is weak. AGDF makes these risks visible before they become delivery problems.</p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {prevention.map((item, index) => (
      <div data-reveal data-reveal-delay={String((index % 3) + 1)} class="card-glow p-6">
        <div class="mb-3 flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-agdf-500/30 bg-agdf-950 font-mono text-lg font-bold text-agdf-300">{index + 1}</span>
          <h3 class="text-lg font-semibold">{item.title}</h3>
        </div>
        <p class="text-sm text-dark-200">{item.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- ==================== REQUIREMENT INTAKE ==================== -->
<section id="intake" class="border-y border-dark-800/80 bg-dark-900/30 py-24">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6">
    <div data-reveal class="mb-12 text-center">
      <h2 class="mb-3 text-3xl font-bold sm:text-4xl">A New Requirement Enters Here</h2>
      <p class="mx-auto max-w-2xl text-dark-200">
        AGDF first decides the operating mode. Small fixes stay lightweight. Product-impacting work enters the approval-driven delivery path.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      {requirementPaths.map((path, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)} class="surface p-6">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h3 class="text-xl font-bold text-agdf-200">{path.label}</h3>
            <span class="rounded-full border border-agdf-500/30 bg-agdf-950 px-3 py-1 font-mono text-xs text-agdf-300">mode</span>
          </div>
          <p class="mb-4 text-sm leading-relaxed text-dark-200">{path.trigger}</p>
          <div class="terminal-body !p-3 text-xs">
            <span class="text-agdf-400">flow:</span> <span class="text-dark-100">{path.path}</span>
          </div>
          <p class="mt-4 text-sm font-medium text-dark-100">{path.outcome}</p>
        </div>
      ))}
    </div>

    <div data-reveal class="surface mt-10 p-6">
      <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h3 class="text-xl font-bold">Exact approvals unlock the next step</h3>
          <p class="mt-1 text-sm text-dark-200">Implicit consent is intentionally not enough. The formula stays explicit so responsibility stays visible.</p>
        </div>
        <code class="rounded-lg border border-agdf-500/30 bg-agdf-950/50 px-3 py-2 text-sm text-agdf-300 shadow-[0_0_24px_-12px_var(--agdf-glow)]">Approval: &lt;GateName&gt;</code>
      </div>
      <div class="grid gap-3 md:grid-cols-4">
        {approvalGates.map((gate, i) => (
          <div data-reveal data-reveal-delay={String((i % 4) + 1)} class="inset-highlight rounded-lg border border-dark-700/80 bg-dark-900/70 p-4 transition-colors hover:border-agdf-500/40">
            <div class="mb-2 font-mono text-xs font-bold text-agdf-400">{gate.gate}</div>
            <code class="block text-sm text-dark-100">{gate.approval}</code>
            <p class="mt-3 text-xs leading-relaxed text-dark-200">{gate.meaning}</p>
          </div>
        ))}
      </div>
    </div>
    <div data-reveal class="mt-10 grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">{visualProofs.intake.eyebrow}</div>
        <h3 class="mb-3 text-2xl font-bold sm:text-3xl">{visualProofs.intake.title}</h3>
        <p class="text-dark-200">{visualProofs.intake.desc}</p>
      </div>
      <div class="surface p-4 sm:p-5">
        <div class="mb-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-dark-700/80 bg-dark-900 p-4">
            <div class="font-mono text-xs font-bold uppercase tracking-wide text-dark-200">Board</div>
            <div class="mt-3 grid grid-cols-4 gap-2 text-center text-[10px] text-dark-200">
              {["Backlog", "Doing", "Review", "Done"].map((column) => (
                <div class="rounded border border-dark-700 bg-dark-950 p-2">{column}</div>
              ))}
            </div>
            <p class="mt-3 text-xs text-dark-200">Shows what people work on.</p>
          </div>
          <div class="rounded-lg border border-agdf-500/30 bg-agdf-950/40 p-4 shadow-[0_0_32px_-16px_var(--agdf-glow)]">
            <div class="font-mono text-xs font-bold uppercase tracking-wide text-agdf-300">AGDF</div>
            <p class="mt-3 text-sm font-semibold text-dark-100">Explains why the next step is allowed.</p>
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              {["Product contract", "Approval", "Traceability", "Evidence"].map((item) => (
                <span class="rounded-full border border-agdf-500/30 px-2 py-1 text-agdf-200">{item}</span>
              ))}
            </div>
          </div>
        </div>
        <div class="grid gap-3 md:grid-cols-3 xl:grid-cols-5">
          {[
            ["PRD", "Product contract"],
            ["SD", "Solution design"],
            ["TP", "Task and test plan"],
            ["CD", "Implementation"],
            ["QA", "Decision evidence"],
          ].map(([gate, label]) => (
            <div class="min-w-0 rounded-lg border border-dark-700/80 bg-dark-900 p-3 text-center transition-all hover:border-agdf-500/40 hover:-translate-y-0.5">
              <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-lg border border-agdf-500/40 bg-agdf-950 font-mono text-sm font-bold text-agdf-300">{gate}</div>
              <div class="break-words text-sm font-semibold text-dark-100">{label}</div>
              <div class="mt-2 text-xs text-dark-200">What is valid?</div>
            </div>
          ))}
        </div>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          {["pass", "revise", "block"].map((state) => (
            <span class="rounded-lg border border-dark-700/80 bg-dark-900 px-3 py-2 font-mono text-xs text-dark-100">{state}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== WORKFLOW ==================== -->
<section id="workflow" class="border-y border-dark-800/80 bg-dark-900/30 py-24">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6">
    <div data-reveal class="mb-12 text-center">
      <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">From request to evidence</div>
      <h2 class="mb-3 text-3xl font-bold sm:text-4xl">The AGDF Core Delivery Flow</h2>
      <p class="text-dark-200">Seven controls that keep AI delivery runs gated, traceable and evidence-based.</p>
    </div>
    <div class="grid gap-4 lg:grid-cols-7">
      {workflowSteps.map((step, i) => (
        <div data-reveal data-reveal-delay={String((i % 7) + 1)} class="surface p-4 transition-all hover:border-agdf-500/40 hover:-translate-y-0.5">
          <div class="mb-3 flex items-center justify-between gap-2">
            <span class="font-mono text-xs font-bold text-agdf-400">Control {step.step}</span>
            <span class="rounded-full border border-dark-700/80 px-2 py-0.5 font-mono text-[10px] text-dark-200">{step.command}</span>
          </div>
          <h3 class="mb-2 text-sm font-semibold text-agdf-200">{step.title}</h3>
          <p class="text-xs leading-relaxed text-dark-200">{step.desc}</p>
        </div>
      ))}
    </div>
    <div data-reveal class="mt-10 grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-agdf-400">{visualProofs.qa.eyebrow}</div>
        <h3 class="mb-3 text-2xl font-bold sm:text-3xl">{visualProofs.qa.title}</h3>
        <p class="text-dark-200">{visualProofs.qa.desc}</p>
      </div>
      <div class="surface p-4 sm:p-5">
        <div class="grid gap-4 lg:grid-cols-3">
          <div class="rounded-lg border border-dark-700/80 bg-dark-900 p-4">
            <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-dark-200">Approved plan</div>
            {["Acceptance criteria", "Tests", "Scope"].map((item) => (
              <div class="mb-3 flex items-center gap-3 rounded-lg border border-dark-700/80 bg-dark-950 p-3 text-sm text-dark-100">
                <span class="h-2 w-2 rounded-full bg-agdf-400 shadow-[0_0_8px_var(--agdf-glow)]"></span>
                {item}
              </div>
            ))}
          </div>
          <div class="rounded-lg border border-dark-700/80 bg-dark-900 p-4">
            <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-dark-200">Implementation</div>
            <div class="rounded-lg border border-dark-700/80 bg-dark-950 p-4 font-mono text-xs text-dark-200">
              <div class="text-agdf-300">code changed</div>
              <div class="mt-2 h-2 rounded-full bg-dark-700"></div>
              <div class="mt-2 h-2 w-4/5 rounded-full bg-dark-800"></div>
              <div class="mt-2 h-2 w-2/3 rounded-full bg-dark-800"></div>
            </div>
            <div class="mt-4 rounded-lg border border-yellow-500/30 bg-yellow-950/20 p-3 text-sm text-yellow-200">Looks done</div>
          </div>
          <div class="rounded-lg border border-dark-700/80 bg-dark-900 p-4">
            <div class="mb-3 font-mono text-xs font-bold uppercase tracking-wide text-dark-200">Review result</div>
            {[
              ["pass", "Task 1 covered", "text-agdf-300"],
              ["pass", "AC 2 covered", "text-agdf-300"],
              ["block", "Test missing", "text-red-300"],
              ["revise", "UI evidence missing", "text-yellow-300"],
            ].map(([state, item, color]) => (
              <div class="mb-2 flex items-center justify-between gap-3 rounded-lg border border-dark-700/80 bg-dark-950 p-3 text-sm">
                <span class="text-dark-100">{item}</span>
                <span class={`font-mono text-xs ${color}`}>{state}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-4 rounded-lg border border-red-500/30 bg-red-950/20 p-4 text-center font-semibold text-red-200 shadow-[0_0_32px_-20px_rgba(239,68,68,0.6)]">Only partially done until evidence closes the gap.</div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== GATE FLOW ==================== -->
<section id="gate-flow" class="border-y border-dark-800/80 bg-dark-900/30 py-24">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6">
    <div data-reveal class="mb-12 text-center">
      <h2 class="mb-3 text-3xl font-bold sm:text-4xl">Gate Map</h2>
      <p class="text-dark-200">Each gate is a deliberate checkpoint. Fail closed: no implementation without the required approval.</p>
    </div>
    <div data-reveal data-reveal-delay="1" class="flex flex-wrap items-center justify-center gap-2">
      {gateFlow.map((g, i) => (
        <>
          <div class="gate-node gate-node-default min-w-[100px]">
            <div class="text-agdf-400">{g.gate}</div>
            <div class="mt-1 text-[10px] font-normal text-dark-200">{g.name}</div>
          </div>
          {i < gateFlow.length - 1 && <span class="text-agdf-600">→</span>}
        </>
      ))}
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {gateFlow.map((g, i) => (
        <div data-reveal data-reveal-delay={String((i % 5) + 1)} class="inset-highlight rounded-lg border border-dark-700/80 bg-dark-900/50 p-3 transition-colors hover:border-agdf-500/40">
          <div class="font-mono text-xs font-bold text-agdf-400">{g.gate}</div>
          <div class="mt-1 text-sm font-semibold">{g.name}</div>
          <div class="mt-1 text-xs text-dark-200">{g.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

