<!-- ==================== COMPATIBILITY ==================== -->
<section id="compat" class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <div class="mb-12 text-center">
      <h2 class="mb-3 text-3xl font-bold sm:text-4xl">Compatibility</h2>
      <p class="text-dark-200">AGDF targets common Agentic AI coding tools, with Claude Code as the primary surface.</p>
  </div>
  <div class="overflow-x-auto rounded-xl border border-dark-700">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-dark-700 bg-dark-900 text-xs uppercase text-dark-200">
        <tr>
          <th class="px-4 py-3">Agent Tool</th>
          <th class="px-4 py-3">Version</th>
          <th class="px-4 py-3">Compat.</th>
          <th class="px-4 py-3">Goal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-dark-800">
        {compatibility.map(c => (
          <tr class="hover:bg-dark-900/50">
            <td class="px-4 py-3 font-medium">{c.tool}</td>
            <td class="px-4 py-3 font-mono text-dark-200">{c.version}</td>
            <td class="px-4 py-3">
              <span class={`font-mono font-semibold ${c.compat === '100%' ? 'text-agdf-400' : 'text-yellow-400'}`}>{c.compat}</span>
            </td>
            <td class="px-4 py-3">
              <span class={`rounded-full px-2 py-0.5 text-xs ${c.goal === 'primary' ? 'bg-agdf-950 text-agdf-300' : 'bg-dark-800 text-dark-200'}`}>{c.goal}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

