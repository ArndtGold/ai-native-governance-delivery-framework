---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site, landingPage } from '../data/site'
import { evaluationEvidence } from '../data/evaluationEvidence'

const { hero, problem, controlLoop, outcomes, proof, installation, responsibility } = landingPage
const pageTitle = `${site.name} — ${site.tagline}`
---

<BaseLayout title={pageTitle}>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-dark-800/70">
    <div class="nav-bar-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8">
      <a href="#home" class="inline-flex items-center gap-3 rounded-md" aria-label="AGDF home">
        <img src="/assets/logo.png" alt="" width="84" height="36" class="h-8 w-auto" />
        <span class="hidden text-sm font-semibold text-dark-100 sm:inline">{site.name}</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm text-dark-200 md:flex" aria-label="Primary navigation">
        {landingPage.navigation.map((item) => (
          <a href={item.href} class="transition-colors hover:text-agdf-200">{item.label}</a>
        ))}
        <a href={site.repo} class="btn-nav">GitHub</a>
      </nav>

      <details class="mobile-nav relative md:hidden">
        <summary class="rounded-md border border-dark-700 px-3 py-2 text-sm font-semibold text-dark-100">Menu</summary>
        <nav class="absolute right-0 top-[calc(100%+0.75rem)] flex min-w-52 flex-col rounded-xl border border-dark-700 bg-dark-950 p-2 shadow-2xl" aria-label="Mobile navigation">
          {landingPage.navigation.map((item) => (
            <a href={item.href} class="rounded-lg px-3 py-2 text-sm text-dark-200 hover:bg-dark-900 hover:text-agdf-200">{item.label}</a>
          ))}
          <a href={site.repo} class="rounded-lg px-3 py-2 text-sm font-semibold text-agdf-200 hover:bg-dark-900">GitHub</a>
        </nav>
      </details>
    </div>
  </header>

  <main data-homepage>
    <section id="home" data-home-section class="hero-grid relative overflow-hidden px-4 pb-20 pt-32 sm:px-6 sm:pb-24 sm:pt-40 lg:px-8 lg:pb-28">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div>
          <p class="eyebrow">{hero.audience}</p>
          <h1 class="mt-5 max-w-4xl text-5xl font-extrabold leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl">{hero.title}</h1>
          <p class="mt-7 max-w-3xl text-xl font-semibold leading-relaxed text-agdf-100 sm:text-2xl">{hero.lead}</p>
          <p class="mt-5 max-w-3xl text-base leading-8 text-dark-200 sm:text-lg">{hero.formulaOne}</p>

          <div class="mt-8 flex flex-wrap gap-3" aria-label="Responsibility model">
            {hero.roles.map((role) => (
              <div class="role-chip"><strong>{role.label}:</strong>&nbsp;{role.value}</div>
            ))}
          </div>

          <div class="mt-9 flex flex-wrap gap-4">
            <a href={hero.primaryAction.href} class="btn-primary">{hero.primaryAction.label}</a>
            <a href={hero.secondaryAction.href} class="btn-ghost">{hero.secondaryAction.label}</a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-md lg:max-w-none" aria-label={site.fullName}>
          <div class="logo-orbit" aria-hidden="true"></div>
          <div class="surface relative p-8 text-center sm:p-10">
            <img src="/assets/logo.png" alt={site.fullName} width="720" height="304" class="mx-auto h-auto w-full max-w-sm" loading="eager" decoding="async" />
            <p class="mt-6 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-dark-200">{site.fullName}</p>
            <div class="mt-8 grid grid-cols-3 gap-2 text-left text-xs text-slate-400">
              <span class="signal">Scope</span><span class="signal">Evidence</span><span class="signal">Gate</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="problem" data-home-section class="section-shell border-y border-dark-800/70 bg-dark-900/30">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="eyebrow">{problem.eyebrow}</p>
          <h2 class="section-title">{problem.title}</h2>
          <p class="section-lead">{problem.description}</p>
          {problem.context.map((paragraph) => <p class="mt-4 leading-7 text-dark-200">{paragraph}</p>)}
        </div>

        <figure class="mt-12" data-governed-transition aria-labelledby="governed-transition-title" aria-describedby="governed-transition-description">
          <figcaption>
            <h3 id="governed-transition-title" class="text-2xl font-bold text-white sm:text-3xl">{problem.transition.title}</h3>
            <p id="governed-transition-description" class="mt-3 max-w-3xl leading-7 text-dark-200">{problem.transition.description}</p>
          </figcaption>

          <div class="mt-7 grid gap-4 xl:grid-cols-[0.82fr_auto_1.35fr_auto_1fr] xl:items-stretch">
            <article class="surface flex flex-col justify-center p-6 sm:p-7">
              <p class="eyebrow">{problem.transition.output.eyebrow}</p>
              <h4 class="mt-3 text-xl font-bold text-white">{problem.transition.output.title}</h4>
              <ul class="mt-6 flex flex-wrap gap-2" aria-label="Agent outputs">
                {problem.transition.output.items.map((item) => <li class="signal">{item}</li>)}
              </ul>
            </article>

            <div class="flex items-center justify-center font-mono text-xl font-bold text-agdf-500" aria-hidden="true">
              <span class="xl:hidden">↓</span><span class="hidden xl:inline">→</span>
            </div>

            <article class="surface controlled-card p-6 sm:p-7">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-5">
                <p class="eyebrow">{problem.transition.control.eyebrow}</p>
                <p class="max-w-xs font-semibold text-agdf-100 sm:text-right">{problem.transition.control.question}</p>
              </div>

              <ul class="mt-6 grid gap-3 text-dark-100">
                {problem.transition.control.checks.map((item) => (
                  <li class="check-row"><span aria-hidden="true">✓</span>{item}</li>
                ))}
              </ul>

              <dl class="mt-7 grid gap-3 border-t border-agdf-700/50 pt-5 sm:grid-cols-2">
                {problem.transition.control.visibility.map((item, index) => (
                  <div class="rounded-xl bg-dark-950/45 p-4">
                    <dt class="flex items-start gap-2 font-semibold text-white">
                      <span class="mt-0.5 font-mono text-agdf-300" aria-hidden="true">{index === 0 ? "◉" : "▤"}</span>
                      {item.title}
                    </dt>
                    <dd class="mt-2 leading-6 text-dark-200">{item.detail}</dd>
                  </div>
                ))}
              </dl>
            </article>

            <div class="flex items-center justify-center font-mono text-xl font-bold text-agdf-500" aria-hidden="true">
              <span class="xl:hidden">↓</span><span class="hidden xl:inline">→</span>
            </div>

            <div class="grid gap-4" aria-label="Governed transition outcomes">
              {problem.transition.outcomes.map((outcome) => (
                <article class:list={[
                  "flex flex-col justify-center rounded-2xl border p-6",
                  outcome.tone === "risk"
                    ? "border-red-500/30 bg-red-500/10"
                    : "border-agdf-500/40 bg-agdf-950/40",
                ]}>
                  <h4 class:list={[
                    "font-bold",
                    outcome.tone === "risk" ? "text-red-200" : "text-agdf-200",
                  ]}>{outcome.state}</h4>
                  <p class="mt-2 leading-6 text-dark-200">{outcome.result}</p>
                </article>
              ))}
            </div>
          </div>
        </figure>

        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          {[problem.without, problem.with].map((comparison, index) => (
            <article class:list={["surface p-6 sm:p-8", index === 1 && "controlled-card"]}>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="text-xl font-bold text-white">{comparison.title}</h3>
                <span class:list={["state-pill", index === 0 ? "state-risk" : "state-control"]}>{comparison.state}</span>
              </div>
              <ul class="mt-6 space-y-4 text-dark-200">
                {comparison.points.map((point) => <li class="check-row"><span aria-hidden="true">{index === 0 ? "×" : "✓"}</span>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="how-it-works" data-home-section class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="eyebrow">{controlLoop.eyebrow}</p>
          <h2 class="section-title">{controlLoop.title}</h2>
          <p class="section-lead">{controlLoop.description}</p>
        </div>

        <ol class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {controlLoop.steps.map((item) => (
            <li class="surface control-step p-6">
              <span class="font-mono text-xs font-bold text-agdf-300">{item.step}</span>
              <h3 class="mt-4 text-xl font-bold text-white">{item.title}</h3>
              <p class="mt-3 leading-7 text-dark-200">{item.description}</p>
            </li>
          ))}
        </ol>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {controlLoop.practice.map((item) => (
            <article class="border-l-2 border-agdf-700 pl-5">
              <h3 class="font-bold text-white">{item.title}</h3>
              <p class="mt-2 leading-7 text-dark-200">{item.description}</p>
            </article>
          ))}
        </div>
        <a href={controlLoop.detailLink.href} class="text-link mt-8 inline-flex">{controlLoop.detailLink.label} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="outcomes" data-home-section class="section-shell border-y border-dark-800/70 bg-dark-900/30">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="eyebrow">{outcomes.eyebrow}</p>
          <h2 class="section-title">{outcomes.title}</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {outcomes.items.map((item, index) => (
            <article class="surface p-7">
              <span class="outcome-number">0{index + 1}</span>
              <h3 class="mt-5 text-xl font-bold text-white">{item.title}</h3>
              <p class="mt-3 leading-7 text-dark-200">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="proof" data-home-section class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 xl:grid-cols-[0.92fr_1.08fr] xl:items-start">
          <div>
            <p class="eyebrow">{proof.eyebrow}</p>
            <h2 class="section-title">{proof.title}</h2>
            <p class="section-lead">{proof.description}</p>
            <p class="mt-5 leading-7 text-dark-200">{proof.selfHosting}</p>

            <div class="mt-8 space-y-5">
              {proof.evidenceMeaning.map((item) => (
                <article>
                  <h3 class="font-bold text-white">{item.title}</h3>
                  <p class="mt-2 leading-7 text-dark-200">{item.description}</p>
                </article>
              ))}
            </div>

            <dl class="mt-8 grid grid-cols-3 gap-3">
              <div class="metric"><dt>Version</dt><dd>{site.version}</dd></div>
              <div class="metric"><dt>Skills</dt><dd>{evaluationEvidence.canonicalSkills}</dd></div>
              <div class="metric"><dt>Eval cases</dt><dd>{evaluationEvidence.behavioralCases}</dd></div>
            </dl>

            <div class="mt-8 space-y-4">
              {proof.surfaces.map((surface) => (
                <article class="border-l-2 border-dark-700 pl-4">
                  <h3 class="font-semibold text-white">{surface.name} <span class="font-normal text-agdf-200">— {surface.state}</span></h3>
                  <p class="mt-1 text-sm leading-6 text-slate-400">{surface.detail}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="space-y-6">
            <article class="surface border-agdf-700/70 p-6 sm:p-8">
              <h3 class="text-xl font-bold text-white">{proof.publicPlugin.title}</h3>
              <p class="mt-4 leading-7 text-dark-200">{proof.publicPlugin.summary}</p>
              <p class="mt-3 leading-7 text-dark-200">{proof.publicPlugin.advisory}</p>
              <p class="mt-3 leading-7 text-dark-200">{proof.publicPlugin.enforcement}</p>
              <p class="mt-3 leading-7 text-dark-200">{proof.publicPlugin.authority}</p>
            </article>

            <figure class="surface overflow-hidden">
              <img src={proof.screenshot.src} alt={proof.screenshot.alt} width={proof.screenshot.width} height={proof.screenshot.height} class="aspect-[1.55] w-full object-cover object-top" loading="lazy" decoding="async" />
              <figcaption class="border-t border-dark-800 px-5 py-4 text-sm leading-6 text-slate-400">{proof.screenshot.caption}</figcaption>
            </figure>

            <div class="flex flex-wrap gap-x-6 gap-y-3">
              {proof.links.map((link) => <a href={link.href} class="text-link">{link.label} <span aria-hidden="true">→</span></a>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="setup" data-home-section class="section-shell border-y border-dark-800/70 bg-dark-900/30">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8">
        <div>
          <p class="eyebrow">{installation.eyebrow}</p>
          <h2 class="section-title">{installation.title}</h2>
          <p class="section-lead">{installation.description}</p>
        </div>
        <div class="surface p-6 sm:p-8">
          <p class="font-mono text-xs font-bold uppercase tracking-wide text-agdf-300">Terminal</p>
          <pre class="mt-4 overflow-x-auto rounded-xl border border-dark-800 bg-dark-950 p-5 text-sm text-agdf-100"><code>{installation.command}</code></pre>
          <ol class="mt-6 space-y-4 text-dark-200">
            {installation.beforeYouStart.map((item, index) => <li class="check-row"><span aria-hidden="true">0{index + 1}</span>{item}</li>)}
          </ol>
          <p class="mt-5 leading-7 text-dark-200">{installation.nextStep}</p>
          <a href={installation.alternatives.href} class="text-link mt-5 inline-flex">{installation.alternatives.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section id="responsibility" data-home-section class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
          <div>
            <p class="eyebrow">{responsibility.eyebrow}</p>
            <h2 class="section-title">{responsibility.title}</h2>
            <p class="section-lead">{responsibility.description}</p>
            <p class="mt-6 leading-7 text-dark-200">{responsibility.project}</p>
            <div class="mt-8 space-y-5">
              {responsibility.decisionOwners.map((item) => (
                <article>
                  <h3 class="font-bold text-white">{item.title}</h3>
                  <p class="mt-2 leading-7 text-dark-200">{item.description}</p>
                </article>
              ))}
            </div>
          </div>
          <div class="surface p-6 sm:p-8">
            <h3 class="text-lg font-bold text-white">What AGDF does not claim</h3>
            <ul class="mt-5 space-y-3 text-dark-200">
              {responsibility.limits.map((limit) => <li class="check-row"><span aria-hidden="true">—</span>{limit}</li>)}
            </ul>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
          {responsibility.links.map((link) => <a href={link.href} class="text-link">{link.label}</a>)}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-dark-800 bg-dark-950">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-8 text-sm text-slate-400 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <p>© {new Date().getFullYear()} {site.author.name}. {site.license}. AGDF is an independent project and not an OpenAI product.</p>
      <nav class="flex flex-wrap gap-5" aria-label="Legal and support">
        <a href="/privacy" class="hover:text-agdf-200">Privacy</a>
        <a href="/terms" class="hover:text-agdf-200">Terms</a>
        <a href="/support" class="hover:text-agdf-200">Support</a>
        <a href={`mailto:${site.contactEmail}`} class="hover:text-agdf-200">Contact</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
