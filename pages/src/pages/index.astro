            <div class="text-dark-200">  AGENTS.md <span class="text-agdf-300">✓</span></div>
            <div class="text-dark-200">  .github/skills/agdf-gate-check/SKILL.md <span class="text-agdf-300">✓</span></div>
          </div>
        </div>
      </div>
