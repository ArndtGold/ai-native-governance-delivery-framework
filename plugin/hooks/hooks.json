{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type":         "command",
                        "command":      "node \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/runtime/agdf-session-check.js\"",
                        "commandWindows": "node \"$([Environment]::GetEnvironmentVariable('PLUGIN_ROOT') + [Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT'))\\runtime\\agdf-session-check.js\"",
                        "statusMessage": "Checking AGDF runtime state..."
                    }
                ]
            }
        ]
    }
}
